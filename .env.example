# Copy this file to .env.local (for `next dev`) and fill in the values.
# On the VPS, the matching file lives at /opt/sakem/.env.production (mode 600).
# Never commit .env.local or .env.production.

# ----------------------------------------------------------------------------
# App
# ----------------------------------------------------------------------------

# "development" locally, "production" in the VPS container, "test" in CI tests.
NODE_ENV=development

# Canonical site URL — used by Auth.js for OAuth redirects.
# Dev: http://localhost:3000  |  Prod: https://sakolakembara.org
NEXTAUTH_URL=http://localhost:3000

# Set to "true" in production (behind Caddy / any reverse proxy).
# Auth.js needs this when NOT deployed to Vercel. Leave blank in dev.
AUTH_TRUST_HOST=

# ----------------------------------------------------------------------------
# Database (Postgres 16)
# ----------------------------------------------------------------------------

# Dev value points at the docker-compose.dev.yml Postgres on localhost.
# Prod value uses the Compose service hostname:
#   postgres://sakem:<password>@postgres:5432/sakola_kembara
DATABASE_URL=postgres://sakem:sakem_dev@localhost:5432/sakola_kembara

# Used by docker-compose.yml in production for the postgres + backup services.
# Locally these are baked into docker-compose.dev.yml; you can ignore them here.
POSTGRES_DB=sakola_kembara
POSTGRES_USER=sakem
POSTGRES_PASSWORD=sakem_dev

# ----------------------------------------------------------------------------
# Auth — unified (Google OAuth for students, email + password for admins)
# ----------------------------------------------------------------------------
# See docs/architecture/authentication.md for how the two providers cooperate.

# Generate with: openssl rand -base64 32
# Rotating this invalidates every existing session.
AUTH_SECRET=

# Google OAuth — required for student sign-in and optional for admins who
# choose to link a Google account. Create credentials at
# https://console.cloud.google.com → APIs & Services → Credentials → OAuth
# client ID (Web application). Authorized redirect URI:
#   http://localhost:3000/api/auth/callback/google        (dev)
#   https://sakolakembara.org/api/auth/callback/google    (prod)
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=

# ----------------------------------------------------------------------------
# Super-admin seed (used by `npm run seed:super-admin` on first deploy)
# ----------------------------------------------------------------------------
# Bootstraps a single super_admin row so someone can sign in before any
# other admin exists. Safe to re-run — it upserts by email and refreshes the
# password hash. Delete these values from prod .env after the first deploy
# succeeds if you don't intend to rotate through the CLI.

SEED_SUPER_ADMIN_EMAIL=
SEED_SUPER_ADMIN_PASSWORD=
SEED_SUPER_ADMIN_NAME=

# ----------------------------------------------------------------------------
# Observability
# ----------------------------------------------------------------------------

# Optional. Get from Sentry → Project Settings → Client Keys (DSN).
# Leave blank in dev unless you actively need to verify error reporting.
# SENTRY_DSN is used by the Node + Edge runtimes.
# NEXT_PUBLIC_SENTRY_DSN is used by the browser bundle (can be the same DSN
# as SENTRY_DSN, or a separate one if you want to attribute browser vs
# server errors to different projects).
SENTRY_DSN=
NEXT_PUBLIC_SENTRY_DSN=

# Only needed at build time on CI when you want to upload sourcemaps to
# Sentry — leave blank in dev.
SENTRY_ORG=
SENTRY_PROJECT=
SENTRY_AUTH_TOKEN=
