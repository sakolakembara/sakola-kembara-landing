# Copy this file to .env.local (for `next dev`) and fill in the values.
# On the VPS, the matching file lives at /opt/sakem/.env.production (mode 600).
# Never commit .env.local or .env.production.

# ----------------------------------------------------------------------------
# App
# ----------------------------------------------------------------------------

# "development" locally, "production" in the VPS container, "test" in CI tests.
NODE_ENV=development

# Canonical site URL — used by Auth.js for OAuth redirects.
# Dev: http://localhost:3000  |  Prod: https://sakolakembara.org
NEXTAUTH_URL=http://localhost:3000

# Set to "true" in production (behind Caddy / any reverse proxy).
# Auth.js needs this when NOT deployed to Vercel. Leave blank in dev.
AUTH_TRUST_HOST=

# ----------------------------------------------------------------------------
# Database (Postgres 16)
# ----------------------------------------------------------------------------

# Dev value points at the docker-compose.dev.yml Postgres on localhost.
# Prod value uses the Compose service hostname:
#   postgres://sakem:<password>@postgres:5432/sakola_kembara
DATABASE_URL=postgres://sakem:sakem_dev@localhost:5432/sakola_kembara

# Used by docker-compose.yml in production for the postgres + backup services.
# Locally these are baked into docker-compose.dev.yml; you can ignore them here.
POSTGRES_DB=sakola_kembara
POSTGRES_USER=sakem
POSTGRES_PASSWORD=sakem_dev

# ----------------------------------------------------------------------------
# Auth — Microsoft Entra ID (single-tenant, @sakolakembara.org only)
# ----------------------------------------------------------------------------
# See docs/roadmap/admin-dashboard.md for the Azure app-registration steps.

# Generate with: openssl rand -base64 32
# Rotating this invalidates every existing session.
AUTH_SECRET=

# From Azure Portal → Microsoft Entra ID → App registrations → (your app) → Overview
AUTH_MICROSOFT_ENTRA_ID_ID=
AUTH_MICROSOFT_ENTRA_ID_TENANT_ID=

# From App registration → Certificates & secrets → New client secret → "Value"
# (shown only once at creation). Expires; rotate before the expiry date.
AUTH_MICROSOFT_ENTRA_ID_SECRET=

# ----------------------------------------------------------------------------
# Observability
# ----------------------------------------------------------------------------

# Optional. Get from Sentry → Project Settings → Client Keys (DSN).
# Leave blank in dev unless you actively need to verify error reporting.
SENTRY_DSN=
