# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files — never commit real ones; .env.example is the only tracked variant
.env*
!.env.example

# vercel
.vercel

# drizzle-kit migration metadata (the SQL files in drizzle/ are committed;
# only the cache + journal artifacts that change per-developer are ignored)
/drizzle/meta/_journal.json.bak

# typescript
*.tsbuildinfo
next-env.d.ts

# claude code local settings
.claude/settings.local.json
