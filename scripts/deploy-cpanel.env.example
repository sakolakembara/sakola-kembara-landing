# Copy to scripts/deploy-cpanel.env and fill in your cPanel SSH details.
# deploy-cpanel.env is gitignored via the .env* pattern.

# SSH target (required)
CPANEL_SSH_HOST=your-domain.com
CPANEL_SSH_USER=cpanel_username
CPANEL_SSH_PORT=22

# SSH private key path (optional; defaults to ssh-agent / default keys)
# CPANEL_SSH_KEY=~/.ssh/id_ed25519

# Remote app directory (cPanel "Setup Node.js App" application root)
CPANEL_REMOTE_PATH=/home/cpanel_username/sakola-kembara

# Deployment mode: node (default) | static
CPANEL_DEPLOY_MODE=node

# For static mode: remote document root (usually public_html)
# CPANEL_PUBLIC_HTML=/home/cpanel_username/public_html

# Package manager on server: npm | pnpm | yarn
CPANEL_PKG_MANAGER=npm

# Standalone bundles exclude node_modules everywhere.
# After upload/extract, run: npm install --omit=dev
# SSH upload runs that automatically unless you pass --no-install.

# cPanel Node.js app startup file (relative to CPANEL_REMOTE_PATH)
CPANEL_STARTUP_FILE=server.js

# Restart method: passenger | cloudlinux | command | none
CPANEL_RESTART_METHOD=passenger

# Used when CPANEL_RESTART_METHOD=command
# CPANEL_RESTART_CMD=touch ~/sakola-kembara/tmp/restart.txt
