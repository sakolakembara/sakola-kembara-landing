# Copy to .dev.vars (untracked) for local runs. Fake local values only.
# Stand-in for the origin behind the route, the live WordPress site (scripts/stub-origin.mjs, default port 4390):
# /wp-admin, /wp-login.php, /wp-content, /wp-includes, /wp-json, /xmlrpc.php and /login are forwarded to it.
LEGACY_ORIGIN_URL=http://127.0.0.1:4390
# Base URL of the content API that serves /api/public/team, /reports, /resources, /blog and /blog/<slug>
# (scripts/fixture-api.mjs, default port 4391). Local runs and CI only: in production the reads go
# through the `API` service binding and this must NOT be set (a URL wins over the binding).
CONTENT_API_URL=http://127.0.0.1:4391
# Where the contact form posts locally instead of the `API` service binding (the same fixture server).
# Never set this in production: it would move the form off the binding onto public HTTP.
CONTACT_API_URL=http://127.0.0.1:4391
# The PUBLIC site key of the Turnstile widget on /kontak. This is Cloudflare's published always-pass TEST
# key: it works on any host (localhost included), needs no account, and yields a dummy token. Production
# sets its own key as a Worker var at deploy time (the matching secret key lives on the API Worker only).
TURNSTILE_SITE_KEY=1x00000000000000000000AA
# The admin's origin: `/admin` and everything under it is a 308 to it (src/lib/admin-redirect.ts). Production sets its
# own at deploy time (a public value); locally the admin SPA's dev server (`pnpm dev:spa` in cf/admin, port 5173).
ADMIN_URL=http://localhost:5173
# Optional: seconds a fetched list, blog page or article is cached before the API is asked again (default 60).
# CONTENT_CACHE_FRESH_SECONDS=60
# Optional: where files uploaded in the admin are served from (R2 behind its own domain in production), no
# trailing slash. Locally the admin Worker serves its local R2 emulation at /uploads/* (`wrangler dev` in
# cf/admin, port 8787), so this shows uploaded photos and files without a public domain. Empty or unset:
# /uploads/... stays a same-origin path and nothing changes. See docs/cloudflare/uploads.md.
# UPLOADS_BASE_URL=http://localhost:8787
# Optional: seconds a rendered page (/blog, an article, /tim, /laporan, /gabung-siswa/docs, /sitemap.xml) is kept in the
# isolate's memory and answered from there, with no render (default: off). At most 120. src/lib/page-cache.ts.
# PAGE_CACHE_SECONDS=30
# Optional: the Cloudflare Web Analytics beacon id (32 hexadecimal characters; what Cloudflare calls the site token). Leave it
# unset locally: no beacon script, no tag. Set, it reaches the pages the Worker renders; the prerendered pages take the same
# name from the shell environment of the BUILD, never from this file. src/lib/web-analytics.ts.
# WEB_ANALYTICS_BEACON_ID=
# Optional: whether the student portal is live (Phase B). Leave it unset locally (Phase A): the navbar has no "Masuk" link and no
# session call, and offers "Daftar Sekarang" (/daftar) instead. Exactly `true` switches the Masuk link and its script on for the pages
# the Worker renders; the prerendered pages take the same name from the shell environment of the BUILD (PORTAL_ENABLED=true pnpm build),
# never from this file. src/lib/portal-enabled.ts.
# PORTAL_ENABLED=true
