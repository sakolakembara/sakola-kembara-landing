---
import { eyebrowClasses } from '~/lib/ui';

/** The yellow-dot uppercase label above a section heading. The dot is always yellow. */
interface Props {
  tone?: 'light' | 'dark';
  class?: string;
}
const { tone = 'light', class: className } = Astro.props;
---

<div class={eyebrowClasses(tone, className)}>
  <span aria-hidden="true" class="h-2 w-2 rounded-full bg-secondary-yellow"></span>
  <slot />
</div>
