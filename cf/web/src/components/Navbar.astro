---
import { env } from 'cloudflare:workers';
import logoLightUrl from '@root/public/images/logo-sakola-kembara-light.png?url';
import logoUrl from '@root/public/images/logo-sakola-kembara.png?url';
import { BUILD_PORTAL_ENABLED, portalEnabled } from '~/lib/portal-enabled';
import { navLinks } from '~/lib/site';
import { buttonClasses, containerClasses } from '~/lib/ui';
import Icon from './Icon.astro';
import NavbarSession from './NavbarSession.astro';

/**
 * Fixed site header: logo, menu, and the sign-in button when the student portal is
 * live. Server-rendered HTML; one small script (below) handles what cannot be
 * static: the mobile menu toggle, the announcement strip and the footer year.
 *
 * The button depends on whether the portal is live (SAKEM-103, Phase A of the
 * cutover; the PORTAL_ENABLED switch, src/lib/portal-enabled.ts):
 *  - OFF (the default, Phase A): NOTHING. The slot is empty (decided by Dzul,
 *    2026-10-15): no "Masuk" link, no session call, not even the wrapper of
 *    the button, because there is no portal to sign in to and the page must not
 *    carry its address. The desktop menu goes to the RIGHT (asked by Dzul,
 *    2026-10-16): with the third column empty a centred menu looks unbalanced.
 *    The grid keeps its three columns and the menu's <ul> takes the third one,
 *    its links packed to the end (`md:col-start-3 md:justify-end`, added only in
 *    this state; the logo stays on the left). It is justify-end and not
 *    justify-self-end because the checks (tests, e2e, check:production) look for
 *    justify-self-end as the sign that the wrapper of the button is there. The
 *    mobile menu has no empty strip under its links.
 *    Registration is reached from the call-to-action buttons of the pages themselves.
 *    (The two blocks are laid out the way they are, a blank line around the first
 *    and `</ul>{` for the second, because Astro then writes the same whitespace
 *    around them as around the old button: a page with the portal off is the old
 *    page minus the block, byte for byte, apart from the class of the desktop
 *    menu's <ul>. That one is a class:list, so its attribute is written the
 *    same way as a plain class and the two states differ only in its value.)
 *  - ON (Phase B): the auth-aware "Masuk" / "Portal" / "Dashboard" button, and
 *    the layout of before: the menu in the centre column, the button on the
 *    right (the <ul> carries neither of the two classes above). Its
 *    session script is a component of its own, NavbarSession, rendered only
 *    then. The session comes from the student portal's own Worker, which serves
 *    `/portal/api/*` on this same host (M4, SAKEM-083).
 */
interface Props {
  /**
   * Float over a full-bleed hero (SAKEM-111): transparent with white links and the light logo until the page
   * scrolls or the mobile menu opens, then the usual white bar. The look is global.css (#site-nav[data-overlay]);
   * the script below sets data-solid. Without it the navbar's HTML is what it always was.
   */
  overlay?: boolean;
}
const { overlay = false } = Astro.props;
// The menu's one button (SAKEM-111): Donasi, last, in sunglow. The other destinations stay text links.
const menuLinks = navLinks.filter((link) => link.href !== '/donasi');
const donate = navLinks.find((link) => link.href === '/donasi')!;
const donateClass = buttonClasses({ variant: 'yellow-on-navy', size: 'sm', className: 'font-bold text-primary-blue-dark' });
const barClass = 'py-4 flex items-center justify-between md:grid md:grid-cols-[1fr_auto_1fr]';
const portalOn = portalEnabled({ prerendered: Astro.isPrerendered, build: BUILD_PORTAL_ENABLED, runtime: env.PORTAL_ENABLED });
---

<nav
  id="site-nav"
  data-overlay={overlay || undefined}
  class="fixed top-0 left-0 right-0 bg-white/95 backdrop-blur-md z-50 border-b border-gray-100"
>
  {/* The announcement strip is inserted here by the script, when there is one. */}
  <div id="announcement-slot"></div>
  {/* Floating over the full-bleed hero, the bar spans the full width, its edges in line with the hero's (SAKEM-111). */}
  <div class={overlay ? `w-full px-6 md:px-10 ${barClass}` : containerClasses('page', barClass)}>
    <a href="/" aria-label="Sakola Kembara" class="flex items-center justify-self-start">
      <img src={logoUrl} alt="Sakola Kembara" width="300" height="103" class="h-10 w-auto" data-logo-solid={overlay || undefined} />
      {overlay && <img src={logoLightUrl} alt="Sakola Kembara" width="300" height="103" class="h-10 w-auto" data-logo-overlay />}
    </a>

    <ul class:list={['hidden md:flex items-center gap-6 lg:gap-7', !portalOn && 'md:col-start-3 md:justify-end']}>
      {
        menuLinks.map((link) => (
          <li>
            <a
              href={link.href}
              class="text-gray-600 text-[15px] font-medium hover:text-primary-blue transition-colors"
            >
              {link.label}
            </a>
          </li>
        ))
      }
      <li><a href={donate.href} data-nav-cta class={donateClass}>{donate.label}</a></li>
    </ul>

    {
      portalOn && (
        <div class="hidden md:flex items-center justify-self-end">
          <a href="/portal/login" data-auth-link class={buttonClasses({ variant: 'neutral', size: 'sm' })}>Masuk</a>
        </div>
      )
    }

    <button
      id="nav-toggle"
      type="button"
      class="md:hidden p-2 text-gray-700"
      aria-label="Buka menu"
      aria-expanded="false"
      aria-controls="mobile-menu"
    >
      <Icon name="menu" data-icon-open />
      <Icon name="x" class="hidden" data-icon-close />
    </button>
  </div>

  <div id="mobile-menu" hidden class="md:hidden bg-white border-t border-gray-100 py-4 px-6">
    <ul class="flex flex-col gap-4">
      {
        menuLinks.map((link) => (
          <li>
            <a
              href={link.href}
              class="block text-gray-600 text-[15px] font-medium hover:text-primary-blue transition-colors"
            >
              {link.label}
            </a>
          </li>
        ))
      }
      <li><a href={donate.href} data-nav-cta class={`${donateClass} w-full`}>{donate.label}</a></li>
    </ul>{
      portalOn && (
        <div class="flex flex-col mt-6">
          <a href="/portal/login" data-auth-link class={buttonClasses({ variant: 'neutral', size: 'md' })}>Masuk</a>
        </div>
      )
    }
  </div>
</nav>

<script>
  // Client JS of the whole site, in one place (about 1.3 KB minified):
  //  1. mobile menu toggle,
  //  2. announcement strip (GET /api/announcements/current: the apex has no such endpoint since M4, so the strip stays
  //     empty until the web Worker gets a small one of its own, listed for SAKEM-084 in docs/cloudflare/portal-architecture.md),
  //  3. copyright year in the footer ("computed live", DESIGN.md section 9).
  // The auth-aware nav button (the session call to the student portal's Worker) is NOT here: it is NavbarSession.astro, a
  // script of its own that the page only has when the portal is switched on (SAKEM-103).
  // The announcement is kept in sessionStorage for a few minutes so a visit costs the Worker one request once, not on every page.

  const nav = document.getElementById('site-nav');
  const toggle = document.getElementById('nav-toggle');
  const menu = document.getElementById('mobile-menu');
  // The floating navbar of the homepage (SAKEM-111) turns solid once the page scrolls or the mobile menu is open.
  const setSolid = () => nav?.toggleAttribute('data-solid', scrollY > 16 || menu?.hasAttribute('hidden') === false);
  if (nav?.hasAttribute('data-overlay')) {
    setSolid();
    addEventListener('scroll', setSolid, { passive: true });
  }
  if (toggle && menu) {
    toggle.addEventListener('click', () => {
      const open = menu.hasAttribute('hidden');
      menu.toggleAttribute('hidden', !open);
      if (nav?.hasAttribute('data-overlay')) setSolid();
      toggle.setAttribute('aria-expanded', String(open));
      toggle.setAttribute('aria-label', open ? 'Tutup menu' : 'Buka menu');
      toggle.querySelector('[data-icon-open]')?.classList.toggle('hidden', open);
      toggle.querySelector('[data-icon-close]')?.classList.toggle('hidden', !open);
    });
  }

  const year = document.getElementById('copyright-year');
  if (year) year.textContent = String(new Date().getFullYear());

  /** JSON from `url`, reused from sessionStorage while younger than `ttl(value)` ms. */
  async function cachedJson<T>(key: string, url: string, ttl: (v: T | null) => number): Promise<T | null> {
    try {
      const raw = sessionStorage.getItem(key);
      if (raw) {
        const { at, v } = JSON.parse(raw) as { at: number; v: T | null };
        if (Date.now() - at < ttl(v)) return v;
      }
    } catch {
      // storage blocked or corrupt: fetch
    }
    let value: T | null = null;
    try {
      const res = await fetch(url, { credentials: 'same-origin' });
      value = res.ok ? ((await res.json()) as T) : null;
    } catch {
      return null; // offline or endpoint unreachable: keep the default
    }
    try {
      sessionStorage.setItem(key, JSON.stringify({ at: Date.now(), v: value }));
    } catch {
      // ignore
    }
    return value;
  }

  // --- announcement strip -------------------------------------------------
  type Announcement = {
    title: string;
    body: string;
    severity: 'info' | 'warning' | 'urgent';
    ctaLabel?: string | null;
    ctaUrl?: string | null;
  };
  // Class strings are written out in full so Tailwind generates them.
  const STRIP = {
    info: {
      box: 'border-b bg-blue-50 border-blue-200 text-blue-900',
      cta: 'shrink-0 px-3 py-1 text-xs font-semibold rounded-full transition-colors bg-blue-900 text-white hover:bg-blue-800',
      icon: '<circle cx="12" cy="12" r="10"/><path d="M12 16v-4"/><path d="M12 8h.01"/>',
    },
    warning: {
      box: 'border-b bg-amber-50 border-amber-200 text-amber-900',
      cta: 'shrink-0 px-3 py-1 text-xs font-semibold rounded-full transition-colors bg-amber-900 text-white hover:bg-amber-800',
      icon: '<path d="M11 6a13 13 0 0 0 8.4-2.8A1 1 0 0 1 21 4v12a1 1 0 0 1-1.6.8A13 13 0 0 0 11 14H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2z"/><path d="M6 14a12 12 0 0 0 2.4 7.2 2 2 0 0 0 3.2-2.4A8 8 0 0 1 10 14"/><path d="M8 6v8"/>',
    },
    urgent: {
      box: 'border-b bg-red-50 border-red-200 text-red-900',
      cta: 'shrink-0 px-3 py-1 text-xs font-semibold rounded-full transition-colors bg-red-900 text-white hover:bg-red-800',
      icon: '<path d="m21.73 18-8-14a2 2 0 0 0-3.48 0l-8 14A2 2 0 0 0 4 21h16a2 2 0 0 0 1.73-3"/><path d="M12 9v4"/><path d="M12 17h.01"/>',
    },
  } as const;

  const slot = document.getElementById('announcement-slot');
  if (slot) {
    void cachedJson<{ announcement: Announcement | null }>(
      'sk:announcement',
      '/api/announcements/current',
      () => 300_000,
    ).then((data) => {
      const a = data?.announcement;
      if (!a) return;
      const style = STRIP[a.severity] ?? STRIP.info;
      const wrap = document.createElement('div');
      wrap.setAttribute('role', 'status');
      wrap.className = style.box;
      const inner = document.createElement('div');
      inner.className = 'mx-auto w-full px-6 max-w-[1200px] py-2.5 flex items-center gap-3 text-sm';
      inner.innerHTML = `<svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" class="shrink-0">${style.icon}</svg>`;
      const text = document.createElement('div');
      text.className = 'flex-1 min-w-0 flex flex-wrap items-baseline gap-x-2 gap-y-0.5';
      const title = document.createElement('strong');
      title.className = 'font-semibold';
      title.textContent = a.title;
      const body = document.createElement('span');
      body.className = 'opacity-90 truncate';
      body.textContent = a.body;
      text.append(title, body);
      inner.append(text);
      if (a.ctaLabel && a.ctaUrl) {
        const cta = document.createElement('a');
        cta.href = a.ctaUrl;
        cta.className = style.cta;
        cta.textContent = a.ctaLabel;
        if (a.ctaUrl.startsWith('http')) {
          cta.target = '_blank';
          cta.rel = 'noopener noreferrer';
        }
        inner.append(cta);
      }
      wrap.append(inner);
      slot.replaceChildren(wrap);
      // Lifts the hero padding to clear the strip (values in global.css).
      document.documentElement.dataset.announced = '';
    });
  }
</script>{portalOn && <NavbarSession />}
