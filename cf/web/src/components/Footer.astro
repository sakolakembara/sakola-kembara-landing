---
import logoLightUrl from '@root/public/images/logo-sakola-kembara-light.png?url';
import { footerLinks } from '~/lib/site';
import Container from './Container.astro';
import Icon from './Icon.astro';
import SocialLinks from './SocialLinks.astro';

/** Site footer: brand, site links, contact and social links. */
// Build-time value; the navbar script rewrites it to the current year in the browser.
const buildYear = new Date().getFullYear();
---

<footer class="bg-gradient-to-b from-accent-navy to-primary-blue text-white">
  {/* Sunglow hairline: the brand accent, and it stops the footer reading as a slab of dark. */}
  <div aria-hidden="true" class="h-1 bg-secondary-yellow"></div>

  <Container class="pt-12 md:pt-16 pb-8 md:pb-10">
    <div
      class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-[minmax(0,1.6fr)_repeat(3,minmax(0,1fr))] gap-10 md:gap-12"
    >
      <div>
        <a href="/" aria-label="Sakola Kembara" class="inline-flex items-center mb-4">
          <img
            src={logoLightUrl}
            alt="Sakola Kembara"
            width="300"
            height="103"
            loading="lazy"
            class="h-10 w-auto"
          />
        </a>
        <p class="text-sm text-white/75 leading-relaxed max-w-sm mb-4">
          Yayasan Sakola Kembara berkomitmen untuk memberikan kesempatan pendidikan yang setara kepada
          seluruh anak Indonesia.
        </p>
        <div class="flex items-start gap-3 text-sm text-white/75">
          <Icon name="map-pin" size={16} class="w-4 h-4 mt-0.5 shrink-0" />
          Bandung, Jawa Barat, Indonesia
        </div>
      </div>

      <nav aria-labelledby="footer-links-heading">
        <h4
          id="footer-links-heading"
          class="text-sm font-bold uppercase tracking-wider text-secondary-yellow mb-5"
        >
          Jelajahi
        </h4>
        <ul class="space-y-3">
          {
            footerLinks.map((link) => (
              <li>
                <a href={link.href} class="text-sm text-white/75 hover:text-white transition-colors">
                  {link.label}
                </a>
              </li>
            ))
          }
        </ul>
      </nav>

      <div>
        <h4 class="text-sm font-bold uppercase tracking-wider text-secondary-yellow mb-5">Kontak</h4>
        <ul class="space-y-4">
          <li>
            <a
              href="mailto:contact@sakolakembara.org"
              class="flex items-start gap-3 text-sm text-white/75 hover:text-white transition-colors"
            >
              <Icon name="mail" size={16} class="w-4 h-4 mt-0.5 shrink-0" />
              contact@sakolakembara.org
            </a>
          </li>
        </ul>
      </div>

      <div>
        <h4 class="text-sm font-bold uppercase tracking-wider text-secondary-yellow mb-5">Social Media</h4>
        <SocialLinks theme="dark" />
      </div>
    </div>
  </Container>

  <div class="border-t border-white/15">
    <Container class="py-5">
      <p class="text-xs text-white/70 text-center">
        © <span id="copyright-year">{buildYear}</span> Yayasan Sakola Kembara Indonesia. All rights reserved.
      </p>
    </Container>
  </div>
</footer>
