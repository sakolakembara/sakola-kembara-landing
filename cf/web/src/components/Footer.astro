---
import { MAIN_INSTAGRAM, branches, footerLinks } from '~/lib/site';
import Icon from './Icon.astro';
import SocialLinks from './SocialLinks.astro';

/**
 * Site footer (SAKEM-111, design "Opsi C"): the name as a full-width wordmark,
 * the mission, site links in two columns, the branches (each to its Instagram), contact, then copyright and social
 * links. The wordmark is SVG text stretched to the width (textLength), so it
 * fills the row at every screen size in the site's own Lora.
 */
// Build-time value; the navbar script rewrites it to the current year in the browser.
const buildYear = new Date().getFullYear();
const rule = 'border-t border-white/15';
---

<footer class="bg-primary-blue-dark px-6 md:px-10 pt-20 pb-7 text-white md:pt-28">
  <div class="flex w-full flex-col gap-12 md:gap-14">
    <a href="/" aria-label="Sakola Kembara" class="block">
      <svg viewBox="0 0 687 82" aria-hidden="true" class="block h-auto w-full overflow-visible">
        <text
          x="0"
          y="78"
          textLength="687"
          lengthAdjust="spacingAndGlyphs"
          class="fill-white font-body font-medium"
          style="font-size:100px;letter-spacing:-4.5px">Sakola Kembara</text
        >
      </svg>
    </a>

    <div class="grid items-start gap-x-12 gap-y-10 sm:grid-cols-2 xl:grid-cols-[minmax(0,1.3fr)_repeat(3,minmax(0,1fr))]">
      <p class="max-w-[22em] text-[22px] font-medium leading-[1.4]">
        Yayasan Sakola Kembara berkomitmen untuk memberikan kesempatan pendidikan yang setara kepada seluruh anak Indonesia.
      </p>

      <nav aria-labelledby="footer-links-heading">
        <h4 id="footer-links-heading" class="mb-2.5 text-sm font-semibold text-white/60">Jelajahi</h4>
        <ul class="grid grid-cols-2 gap-x-6">
          {
            footerLinks.map((link) => (
              <li>
                <a href={link.href} class="block py-1.5 text-base text-white/85 transition-colors hover:text-white">
                  {link.label}
                </a>
              </li>
            ))
          }
        </ul>
      </nav>

      <nav aria-labelledby="footer-branches-heading">
        <h4 id="footer-branches-heading" class="mb-2.5 text-sm font-semibold text-white/60">Cabang</h4>
        <ul class="grid grid-cols-2 gap-x-6">
          {
            branches.map((branch) => (
              <li>
                <a
                  href={`https://instagram.com/${branch.instagram ?? MAIN_INSTAGRAM}`}
                  target="_blank"
                  rel="noopener noreferrer"
                  title={branch.region}
                  class="block py-1.5 text-base text-white/85 transition-colors hover:text-white"
                >
                  {branch.name}
                </a>
              </li>
            ))
          }
        </ul>
      </nav>

      <div>
        <h4 class="mb-2.5 text-sm font-semibold text-white/60">Kontak</h4>
        <a href="mailto:contact@sakolakembara.org" class:list={['flex items-center gap-3 py-3 text-base text-white hover:text-secondary-yellow transition-colors', rule]}>
          <Icon name="mail" size={18} class="size-[18px] shrink-0" />
          contact@sakolakembara.org
        </a>
        <p class:list={['flex items-center gap-3 border-b border-white/15 py-3 text-base text-white/85', rule]}>
          <Icon name="map-pin" size={18} class="size-[18px] shrink-0" />
          Bandung, Jawa Barat, Indonesia
        </p>
      </div>
    </div>

    <div class:list={['flex flex-wrap items-center justify-between gap-x-8 gap-y-4 pt-5', rule]}>
      <p class="text-sm text-white/70">
        © <span id="copyright-year">{buildYear}</span> Yayasan Sakola Kembara Indonesia. All rights reserved.
      </p>
      <div role="group" aria-label="Social Media">
        <SocialLinks theme="dark" />
      </div>
    </div>
  </div>
</footer>
