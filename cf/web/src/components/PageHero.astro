---
import Container from './Container.astro';
import Heading from './Heading.astro';

/**
 * The hero that opens a sub-page, in the homepage's style (SAKEM-112, Dzul 2026-10-28: "hero krem, judul kiri, lead
 * kanan kayak section homepage"): a cream band, the page's H1 on the left and the optional lead on the right from md,
 * both resting on the band's bottom edge. The top padding reads --hero-top so it clears the fixed navbar (and the
 * announcement strip when it shows).
 */
interface Props {
  title: string;
  lead?: string;
}
const { title, lead } = Astro.props;
---

<section
  class="bg-[#FBFBF5] pt-[calc(var(--hero-top,8rem)_+_2rem)] pb-14 text-primary-blue-dark md:pt-[calc(var(--hero-top,8rem)_+_4rem)] md:pb-20"
>
  <Container class="grid items-end gap-6 md:grid-cols-2 md:gap-x-16">
    <Heading level="page" class="text-balance anim-fade-up">{title}</Heading>
    {lead && <p class="max-w-[34em] text-[17px] leading-[1.65] text-gray-600 md:justify-self-end md:text-lg anim-fade-up">{lead}</p>}
  </Container>
</section>
