---
import Base from '~/layouts/Base.astro';
import Button from './Button.astro';
import Container from './Container.astro';
import Eyebrow from './Eyebrow.astro';
import Heading from './Heading.astro';

/**
 * The 404 page body inside the site shell. Copy is verbatim from the root
 * app/not-found.tsx. The page that renders it sets the 404 status; the head
 * is noindex (buildSeo kind "notfound").
 */
---

<Base seo={{ kind: 'notfound' }}>
  <main
    class="bg-gradient-to-b from-gray-50 to-white pt-[calc(var(--hero-top,8rem)_+_1.25rem)] pb-16 md:pt-[calc(var(--hero-top,8rem)_+_2.5rem)] md:pb-24"
  >
    <Container size="reading" class="text-center">
      <Eyebrow class="mb-4">404</Eyebrow>
      <Heading level="page" class="mb-4 text-gray-900">Halaman tidak ditemukan</Heading>
      <p class="mx-auto mb-8 max-w-[600px] text-base text-gray-600 md:text-lg">
        Halaman yang Anda cari tidak ada atau sudah dipindahkan.
      </p>
      <div class="flex flex-wrap justify-center gap-4">
        <Button href="/">Kembali ke Beranda</Button>
        <Button href="/kontak" variant="outline">Hubungi Kami</Button>
      </div>
    </Container>
  </main>
</Base>
