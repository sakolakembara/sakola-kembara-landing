---
import { tagClasses, type TagSize, type TagTone } from '~/lib/ui';

/** Pill-shaped category label. Tags are always rounded-full; buttons never are. */
interface Props {
  size?: TagSize;
  tone?: TagTone;
  class?: string;
}
const { size, tone, class: className } = Astro.props;
---

<span class={tagClasses(size, className, tone)}><slot /></span>
