---
import Img from '~/components/Img.astro';
import { REGISTRATION_PATH } from '~/lib/site';

/**
 * Homepage "Jadilah Bagian dari Perubahan" (SAKEM-111, the poster Dzul chose on 2026-10-27): a sunglow band with the
 * headline on the left and the four ways to take part as ruled rows on the right (from md), each row one link: the role, a
 * photo chip to its right that widens on hover, an arrow. The action ("Daftar Sekarang"...) is in the link for screen readers only. The photos
 * are decorative (alt=""): the link text says it all.
 * The donor row's arrow is filled at rest, the one emphasis of the section.
 */
const ctaOptions = [
  {
    id: 'siswa',
    photo: '/images/program/pembinaan.jpg',
    title: 'Menjadi Siswa',
    buttonText: 'Daftar Sekarang',
    // SAKEM-103: straight to the registration shortlink (it was /gabung-siswa, the information page).
    href: REGISTRATION_PATH,
  },
  {
    id: 'donatur',
    photo: '/images/home/hero-poster.jpg',
    title: 'Menjadi Donatur',
    buttonText: 'Donasi Sekarang',
    href: '/donasi',
  },
  {
    id: 'relawan',
    photo: '/images/hero-team.png',
    title: 'Menjadi Relawan',
    buttonText: 'Gabung Tim',
    href: '/kontak',
  },
  {
    id: 'partner',
    photo: '/images/program/pasca-pembinaan.jpg',
    title: 'Menjadi Partner',
    buttonText: 'Hubungi Kami',
    href: '/kontak',
  },
];
---

<section id="gabung" class="bg-secondary-yellow px-6 md:px-10 py-20 text-primary-blue-dark md:py-32">
  <div class="grid w-full items-start gap-12 md:grid-cols-2 md:gap-x-16">
    <h2 class="font-body text-[clamp(48px,6.6vw,120px)] font-medium leading-[0.95] tracking-[-0.045em] text-balance anim-reveal">
      Jadilah Bagian <br />dari Perubahan
    </h2>
    <ul class="border-b border-primary-blue-dark/25">
      {
        ctaOptions.map((option) => (
          <li class="border-t border-primary-blue-dark/25">
            <a href={option.href} class="group flex items-center justify-between gap-4 py-5 md:gap-6 md:py-7">
              <span class="flex min-w-0 items-center gap-4 transition-transform duration-300 group-hover:translate-x-1.5 motion-reduce:transition-none md:gap-5">
                <span class="font-body text-[clamp(26px,2.8vw,48px)] font-medium leading-none tracking-[-0.03em]">{option.title}</span>
                <Img
                  src={option.photo}
                  alt=""
                  sizes="96px"
                  class="h-10 w-16 shrink-0 rounded-[10px] object-cover transition-[width] duration-300 group-hover:w-24 md:h-14 md:w-24 md:group-hover:w-40 motion-reduce:transition-none"
                />
                <span class="sr-only">{option.buttonText}</span>
              </span>
              <span
                aria-hidden="true"
                class:list={[
                  'inline-flex size-11 items-center justify-center rounded-full border-[1.5px] border-primary-blue-dark transition-colors md:size-14',
                  option.id === 'donatur'
                    ? 'bg-primary-blue-dark text-secondary-yellow'
                    : 'group-hover:bg-primary-blue-dark group-hover:text-secondary-yellow',
                ]}
              >
                <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
                  <path d="M5 12h14" />
                  <path d="m13 6 6 6-6 6" />
                </svg>
              </span>
            </a>
          </li>
        ))
      }
    </ul>
  </div>
</section>
