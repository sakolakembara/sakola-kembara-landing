---
import { REGISTRATION_PATH } from '~/lib/site';

/**
 * Homepage "Jadilah Bagian dari Perubahan" (SAKEM-111, the poster Dzul chose on 2026-10-27): a sunglow band with the
 * headline set large and the four ways to take part as ruled rows, each one link with the role and its action, no
 * photos. The donor row's arrow is filled at rest, the one emphasis of the section.
 */
const ctaOptions = [
  {
    id: 'siswa',
    title: 'Menjadi Siswa',
    buttonText: 'Daftar Sekarang',
    // SAKEM-103: straight to the registration shortlink (it was /gabung-siswa, the information page).
    href: REGISTRATION_PATH,
  },
  {
    id: 'donatur',
    title: 'Menjadi Donatur',
    buttonText: 'Donasi Sekarang',
    href: '/donasi',
  },
  {
    id: 'relawan',
    title: 'Menjadi Relawan',
    buttonText: 'Gabung Tim',
    href: '/kontak',
  },
  {
    id: 'partner',
    title: 'Menjadi Partner',
    buttonText: 'Hubungi Kami',
    href: '/kontak',
  },
];
---

<section id="gabung" class="bg-secondary-yellow px-6 md:px-10 py-20 text-primary-blue-dark md:py-32">
  <div class="flex w-full flex-col gap-12 md:gap-20">
    <h2 class="max-w-[12em] font-body text-[clamp(48px,8.4vw,148px)] font-medium leading-[0.95] tracking-[-0.045em] text-balance anim-reveal">
      Jadilah Bagian <br />dari Perubahan
    </h2>
    <ul class="border-b border-primary-blue-dark/25">
      {
        ctaOptions.map((option) => (
          <li class="border-t border-primary-blue-dark/25">
            <a
              href={option.href}
              class="group flex flex-wrap items-center justify-between gap-x-8 gap-y-3 py-6 md:py-8"
            >
              <span class="font-body text-[clamp(30px,4.2vw,68px)] font-medium leading-none tracking-[-0.03em] transition-transform duration-300 group-hover:translate-x-2 motion-reduce:transition-none">
                {option.title}
              </span>
              <span class="inline-flex items-center gap-4 text-base font-semibold md:text-lg">
                {option.buttonText}
                <span
                  class:list={[
                    'inline-flex size-12 shrink-0 items-center justify-center rounded-full border-[1.5px] border-primary-blue-dark transition-colors md:size-14',
                    option.id === 'donatur'
                      ? 'bg-primary-blue-dark text-secondary-yellow'
                      : 'group-hover:bg-primary-blue-dark group-hover:text-secondary-yellow',
                  ]}
                >
                  <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                    <path d="M5 12h14" />
                    <path d="m13 6 6 6-6 6" />
                  </svg>
                </span>
              </span>
            </a>
          </li>
        ))
      }
    </ul>
  </div>
</section>
