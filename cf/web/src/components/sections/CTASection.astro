---
import Img from '~/components/Img.astro';
import { REGISTRATION_PATH } from '~/lib/site';

/**
 * Homepage "Jadilah Bagian dari Perubahan" (SAKEM-111, design "Opsi C"): four
 * ways to take part, a photo card each with the role and its action only. The
 * donor card's button is the one sunglow button of the section. The photos
 * are decorative (alt=""): the card's link text is the role and its action.
 */
const ctaOptions = [
  {
    id: 'siswa',
    title: 'Menjadi Siswa',
    buttonText: 'Daftar Sekarang',
    // SAKEM-103: straight to the registration shortlink (it was /gabung-siswa, the information page).
    href: REGISTRATION_PATH,
    photo: '/images/program/pembinaan.jpg',
  },
  {
    id: 'donatur',
    title: 'Menjadi Donatur',
    buttonText: 'Donasi Sekarang',
    href: '/donasi',
    photo: '/images/home/hero-poster.jpg',
  },
  {
    id: 'relawan',
    title: 'Menjadi Relawan',
    buttonText: 'Gabung Tim',
    href: '/kontak',
    photo: '/images/hero-team.png',
  },
  {
    id: 'partner',
    title: 'Menjadi Partner',
    buttonText: 'Hubungi Kami',
    href: '/kontak',
    photo: '/images/program/pasca-pembinaan.jpg',
  },
];
---

<section id="gabung" class="bg-[#F7F4EC] px-6 md:px-10 py-20 md:py-28">
  <div class="flex w-full flex-col gap-12">
    <h2 class="text-center font-display text-[clamp(36px,4.4vw,60px)] font-medium leading-[1.1] tracking-[-0.03em] text-primary-blue-dark anim-reveal">
      Jadilah Bagian <br />dari Perubahan
    </h2>
    <div class="grid gap-4 md:grid-cols-2">
      {
        ctaOptions.map((option, index) => (
          <a
            href={option.href}
            class="group relative isolate flex min-h-[320px] flex-col justify-between overflow-hidden rounded-[20px] bg-primary-blue-dark p-8 text-white md:min-h-[400px] anim-reveal"
            style={`--i:${index % 2}`}
          >
            <Img
              src={option.photo}
              alt=""
              sizes="(min-width: 768px) 50vw, 100vw"
              class="absolute inset-0 -z-20 h-full w-full object-cover transition-transform duration-500 group-hover:scale-[1.03]"
            />
            <span
              aria-hidden="true"
              class="absolute inset-0 -z-10 bg-[linear-gradient(180deg,rgba(13,31,82,0.55)_0%,rgba(13,31,82,0.1)_40%,rgba(13,31,82,0.7)_100%)]"
            />
            <span class="font-display text-[clamp(32px,3.2vw,44px)] font-medium leading-[1.05] tracking-[-0.02em]">{option.title}</span>
            <span
              class:list={[
                'inline-flex items-center gap-2.5 self-start rounded-lg border-[1.5px] px-[18px] py-3 text-[15px] transition-colors',
                option.id === 'donatur'
                  ? 'border-secondary-yellow bg-secondary-yellow font-bold text-primary-blue-dark group-hover:bg-secondary-yellow/90'
                  : 'border-white/80 bg-primary-blue-dark/35 font-semibold group-hover:bg-primary-blue-dark/60',
              ]}
            >
              {option.buttonText}
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <path d="M5 12h14" />
                <path d="m13 6 6 6-6 6" />
              </svg>
            </span>
          </a>
        ))
      }
    </div>
  </div>
</section>
