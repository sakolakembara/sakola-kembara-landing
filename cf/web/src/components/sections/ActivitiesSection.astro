---
import Img from '~/components/Img.astro';
import { programCards } from '~/lib/site';
import { buttonClasses } from '~/lib/ui';

/**
 * Homepage "Program Kami" (SAKEM-111; the target of the hero's "Lihat Program Kami"), a full-screen step showcase
 * (Dzul, 2026-10-27): the title left and the lead right, then the three steps as photo cards side by side (stacked on a
 * phone). The open card is wide and shows the step's subtitle and "Lihat Detail" to /program/<id> over its photo, with a
 * progress ring top right; every card has its number top left, and the closed ones are narrow and show their name only (the whole card is their header button). The
 * steps change on their own: the open card's ring fills in 7 s and its `animationend` opens the next one, so pausing the
 * ring (hover, keyboard focus, the section out of view) pauses the rotation, and with reduced motion there is no
 * animation and so no rotation. Without JS the first step stays open and the headers do nothing (its "Lihat Detail" and
 * the program pages still work). Copy is verbatim from the root ActivitiesSection + lib/data.ts.
 */
const covers: Record<string, string> = {
  prapembinaan: '/images/program/prapembinaan.jpg',
  pembinaan: '/images/program/pembinaan.jpg',
  'pasca-pembinaan': '/images/program/pasca-pembinaan.jpg',
};
---

<section id="activities" class="scroll-mt-24 flex min-h-[100svh] flex-col justify-center gap-8 px-6 py-16 md:gap-10 md:px-10 md:py-20" data-steps>
  <div class="grid items-end gap-6 md:grid-cols-2 anim-reveal">
    <h2 class="text-balance font-body text-[clamp(32px,3.6vw,56px)] font-medium leading-[1.15] tracking-[-0.025em] text-primary-blue-dark">
      Apa saja yang dilalui penerima manfaat Sakola Kembara?
    </h2>
    <p class="max-w-[30em] text-[17px] leading-[1.65] text-gray-600 md:justify-self-end md:text-right">
      Program pembinaan komprehensif dari penjangkauan siswa hingga pendampingan alumni untuk memastikan keberhasilan jangka
      panjang.
    </p>
  </div>

  <ol class="flex flex-col gap-3 md:h-[clamp(420px,58svh,640px)] md:flex-row">
    {
      programCards.map((step, index) => (
        <li
          class="step group relative isolate flex h-24 flex-col justify-end overflow-hidden rounded-xl bg-primary-blue-dark p-5 text-white transition-[flex-grow,height] duration-500 ease-out data-open:h-[440px] motion-reduce:transition-none md:h-auto md:flex-1 md:p-7 md:data-open:h-auto md:data-open:flex-[3]"
          data-open={index === 0 ? '' : undefined}
        >
          <Img
            src={covers[step.id]}
            alt={step.title}
            sizes="(min-width: 768px) 60vw, 100vw"
            class="absolute inset-0 -z-20 h-full w-full object-cover transition-transform duration-700 group-hover:scale-[1.03] motion-reduce:transition-none"
          />
          <span
            aria-hidden="true"
            class="absolute inset-0 -z-10 bg-[linear-gradient(180deg,rgba(13,31,82,0.25)_0%,rgba(13,31,82,0.88)_100%)] group-data-open:bg-[linear-gradient(180deg,rgba(13,31,82,0)_35%,rgba(13,31,82,0.85)_100%)]"
          />
          <span aria-hidden="true" class="absolute left-5 top-5 text-sm font-semibold tabular-nums text-secondary-yellow md:left-7 md:top-7">0{index + 1}</span>
          <h3 class="text-[clamp(22px,2vw,32px)] font-medium leading-tight tracking-[-0.02em]">
            <button
              type="button"
              id={`tahap-${step.id}-tab`}
              aria-controls={`tahap-${step.id}`}
              aria-expanded={index === 0 ? 'true' : 'false'}
              class="text-left after:absolute after:inset-0 aria-expanded:after:hidden"
            >
              {step.tag}
            </button>
          </h3>
          <div id={`tahap-${step.id}`} role="region" aria-labelledby={`tahap-${step.id}-tab`} hidden={index !== 0} class="mt-3 flex flex-col gap-5">
            <p class="text-lg text-white/85">{step.title}</p>
            <a
              href={`/program/${step.id}`}
              aria-label={`Lihat Detail ${step.tag}`}
              class={buttonClasses({ variant: 'yellow-on-navy', className: 'self-start font-bold text-primary-blue-dark' })}
            >
              Lihat Detail
            </a>
            <svg aria-hidden="true" viewBox="0 0 44 44" class="absolute right-5 top-5 size-11 -rotate-90 md:right-7 md:top-7">
              <circle cx="22" cy="22" r="19" fill="none" stroke="currentColor" stroke-width="3" class="text-white/25" />
              <circle cx="22" cy="22" r="19" fill="none" stroke-width="3" pathLength="100" class="step-bar stroke-secondary-yellow" />
            </svg>
          </div>
        </li>
      ))
    }
  </ol>
</section>

<style>
  /* The open card's ring fills in 7 s; its animationend opens the next step (the script). */
  .step-bar {
    stroke-dasharray: 100;
    stroke-dashoffset: 100;
  }
  .step[data-open] .step-bar {
    animation: step-fill 7s linear forwards;
  }
  [data-steps][data-paused] .step-bar {
    animation-play-state: paused;
  }
  @keyframes step-fill {
    to {
      stroke-dashoffset: 0;
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .step[data-open] .step-bar {
      animation: none;
      stroke-dashoffset: 0;
    }
  }
</style>

<script>
  // The program steps: one card open at a time; the open ring's animationend opens the next one.
  const section = document.querySelector<HTMLElement>('[data-steps]');
  if (section) {
    const tiles = [...section.querySelectorAll<HTMLElement>('.step')];
    const open = (next: number) =>
      tiles.forEach((tile, i) => {
        const on = i === next;
        const button = tile.querySelector('button')!;
        tile.toggleAttribute('data-open', on);
        button.setAttribute('aria-expanded', String(on));
        document.getElementById(button.getAttribute('aria-controls')!)!.hidden = !on;
      });
    tiles.forEach((tile, i) => {
      tile.querySelector('button')!.addEventListener('click', () => open(i));
      tile.querySelector('.step-bar')!.addEventListener('animationend', () => open((i + 1) % tiles.length));
    });
    let hovered = false;
    let visible = true;
    // Keyboard focus pauses; a mouse click leaves focus on a header, so focus only counts while visible as such.
    const pause = () => section.toggleAttribute('data-paused', hovered || !visible || !!section.querySelector(':focus-visible'));
    section.addEventListener('pointerenter', () => ((hovered = true), pause()));
    section.addEventListener('pointerleave', () => ((hovered = false), pause()));
    section.addEventListener('focusin', pause);
    section.addEventListener('focusout', () => setTimeout(pause));
    new IntersectionObserver(([entry]) => ((visible = entry.isIntersecting), pause())).observe(section);
  }
</script>
