---
import Img from '~/components/Img.astro';
import { listImages } from '~/lib/images';
import { programCards } from '~/lib/site';
import { buttonClasses } from '~/lib/ui';

/**
 * Homepage "Program Kami" (SAKEM-111; the target of the hero's "Lihat Program Kami"), a full-screen step showcase
 * (Dzul, 2026-10-27): the title and the lead on the left, the three steps as tabs on the right, and below them one
 * step at a time: its photos (the cover and the first two of its gallery) and its short explanation with "Lihat
 * Detail" to /program/<id>. The steps change on their own: the active tab's bar fills in 7 s and its `animationend`
 * moves to the next step, so pausing the bar (hover, focus, the section out of view) pauses the rotation, and with
 * reduced motion there is no animation and so no rotation. Without JS the first step shows and the tabs do nothing
 * (its "Lihat Detail" and the program pages still work). Copy is verbatim from the root ActivitiesSection + lib/data.ts.
 */
const covers: Record<string, string> = {
  prapembinaan: '/images/program/prapembinaan.jpg',
  pembinaan: '/images/program/pembinaan.jpg',
  'pasca-pembinaan': '/images/program/pasca-pembinaan.jpg',
};
const steps = programCards.map((program) => ({
  ...program,
  photos: [covers[program.id], ...listImages(`/images/program/galeri/${program.id}`).slice(0, 2).map((p) => p.src)],
}));
---

<section id="activities" class="scroll-mt-24 flex min-h-[100svh] flex-col gap-8 px-6 py-16 md:gap-10 md:px-10 md:py-20" data-steps>
  <div class="grid items-end gap-8 md:grid-cols-2">
    <div class="flex flex-col gap-4 anim-reveal">
      <h2 class="text-balance font-body text-[clamp(32px,3.6vw,56px)] font-medium leading-[1.15] tracking-[-0.025em] text-primary-blue-dark">
        Apa saja yang dilalui penerima manfaat Sakola Kembara?
      </h2>
      <p class="max-w-[34em] text-base leading-[1.65] text-gray-600">
        Program pembinaan komprehensif dari penjangkauan siswa hingga pendampingan alumni untuk memastikan keberhasilan jangka
        panjang.
      </p>
    </div>
    <div role="tablist" aria-label="Tahap program" class="grid grid-cols-3 gap-3 md:gap-5">
      {
        steps.map((step, index) => (
          <button
            type="button"
            role="tab"
            id={`tahap-${step.id}-tab`}
            aria-controls={`tahap-${step.id}`}
            aria-selected={index === 0 ? 'true' : 'false'}
            tabindex={index === 0 ? 0 : -1}
            class="step-tab group flex flex-col gap-3 text-left text-primary-blue-dark/55 transition-colors hover:text-primary-blue-dark aria-selected:text-primary-blue-dark"
          >
            <span class="relative h-[3px] w-full overflow-hidden rounded-full bg-primary-blue-dark/15">
              <span class="step-bar absolute inset-y-0 left-0 w-0 rounded-full bg-primary-blue-dark" />
            </span>
            <span class="text-xs font-semibold tabular-nums md:text-sm">0{index + 1}</span>
            <span class="text-sm font-semibold leading-tight md:text-lg">{step.tag}</span>
          </button>
        ))
      }
    </div>
  </div>

  {
    steps.map((step, index) => (
      <div
        role="tabpanel"
        id={`tahap-${step.id}`}
        aria-labelledby={`tahap-${step.id}-tab`}
        hidden={index !== 0}
        class="grid min-h-0 flex-1 gap-6 md:grid-cols-[minmax(0,1.6fr)_minmax(0,1fr)] md:gap-10"
      >
        <div class="grid min-h-[320px] grid-cols-3 grid-rows-2 gap-3 md:min-h-[420px]">
          {step.photos.map((photo, i) => (
            <Img
              src={photo}
              alt={i === 0 ? step.title : `Dokumentasi ${step.title} ${i}`}
              sizes={i === 0 ? '(min-width: 768px) 40vw, 66vw' : '(min-width: 768px) 20vw, 33vw'}
              class:list={['h-full w-full rounded-xl object-cover', i === 0 ? 'col-span-2 row-span-2' : '']}
            />
          ))}
        </div>
        <div class="flex flex-col justify-between gap-8">
          <div class="flex flex-col gap-5">
            <div class="flex flex-col gap-1">
              <h3 class="text-[clamp(26px,2.4vw,36px)] font-medium tracking-[-0.02em] text-primary-blue-dark">{step.tag}</h3>
              <span class="text-gray-600">{step.title}</span>
            </div>
            <ul class="flex flex-col divide-y divide-primary-blue-dark/15 border-y border-primary-blue-dark/15">
              {step.points.map((point) => (
                <li class="py-3.5 text-[15px] leading-relaxed text-gray-700 md:text-base">{point}</li>
              ))}
            </ul>
          </div>
          <a
            href={`/program/${step.id}`}
            aria-label={`Lihat Detail ${step.tag}`}
            class={buttonClasses({ variant: 'outline-navy', className: 'self-start' })}
          >
            Lihat Detail
          </a>
        </div>
      </div>
    ))
  }
</section>

<style>
  /* The active tab's bar fills in 7 s; its animationend moves to the next step (the script). */
  .step-tab[aria-selected='true'] .step-bar {
    animation: step-fill 7s linear forwards;
  }
  [data-steps][data-paused] .step-bar {
    animation-play-state: paused;
  }
  @keyframes step-fill {
    to {
      width: 100%;
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .step-tab[aria-selected='true'] .step-bar {
      animation: none;
      width: 100%;
    }
  }
</style>

<script>
  // Tabs for the program steps, and the rotation: the active bar's animationend selects the next step.
  const section = document.querySelector<HTMLElement>('[data-steps]');
  if (section) {
    const tabs = [...section.querySelectorAll<HTMLButtonElement>('[role="tab"]')];
    const select = (next: number, focus = false) => {
      tabs.forEach((tab, i) => {
        const on = i === next;
        tab.setAttribute('aria-selected', String(on));
        tab.tabIndex = on ? 0 : -1;
        document.getElementById(tab.getAttribute('aria-controls')!)!.hidden = !on;
      });
      if (focus) tabs[next].focus();
    };
    const current = () => tabs.findIndex((tab) => tab.getAttribute('aria-selected') === 'true');
    tabs.forEach((tab, i) => {
      tab.addEventListener('click', () => select(i));
      tab.addEventListener('keydown', (event) => {
        const step = { ArrowRight: 1, ArrowLeft: -1 }[event.key];
        if (step) select((i + step + tabs.length) % tabs.length, true);
      });
      tab.querySelector('.step-bar')!.addEventListener('animationend', () => select((current() + 1) % tabs.length));
    });
    let hovered = false;
    let visible = true;
    // Keyboard focus pauses; a mouse click on a tab leaves focus there, so it only counts while visible as such.
    const pause = () => section.toggleAttribute('data-paused', hovered || !visible || !!section.querySelector(':focus-visible'));
    section.addEventListener('pointerenter', () => ((hovered = true), pause()));
    section.addEventListener('pointerleave', () => ((hovered = false), pause()));
    section.addEventListener('focusin', pause);
    section.addEventListener('focusout', () => setTimeout(pause));
    new IntersectionObserver(([entry]) => ((visible = entry.isIntersecting), pause())).observe(section);
  }
</script>
