---
import Img from '~/components/Img.astro';
import { programCards } from '~/lib/site';
import { buttonClasses } from '~/lib/ui';

/**
 * Homepage "Program Kami" (SAKEM-111, design "Opsi C"; the target of the hero's
 * "Lihat Program Kami"): three photo tiles with the caption below. Copy is
 * verbatim from the root ActivitiesSection + lib/data.ts. Each tile links to
 * /program/<id>.
 */
const photos: Record<string, string> = {
  prapembinaan: '/images/program/prapembinaan.jpg',
  pembinaan: '/images/program/pembinaan.jpg',
  'pasca-pembinaan': '/images/program/pasca-pembinaan.jpg',
};
---

<section id="activities" class="scroll-mt-24 px-6 py-20 md:py-28">
  <div class="mx-auto flex max-w-[1280px] flex-col gap-12">
    <div class="grid items-end gap-6 md:grid-cols-2 anim-reveal">
      <h2 class="text-balance font-display text-[clamp(34px,3.8vw,52px)] font-medium leading-[1.4] tracking-[-0.03em] text-primary-blue-dark">
        Apa saja yang dilalui penerima manfaat Sakola Kembara?
      </h2>
      <p class="max-w-[30em] text-[17px] leading-[1.65] text-gray-600">
        Program pembinaan komprehensif dari penjangkauan siswa hingga pendampingan alumni untuk memastikan keberhasilan jangka
        panjang.
      </p>
    </div>

    <ol class="grid gap-6 md:grid-cols-3">
      {
        programCards.map((program, index) => (
          <li class="flex flex-col gap-4 anim-reveal" style={`--i:${index}`}>
            <Img
              src={photos[program.id]}
              alt={program.title}
              sizes="(min-width: 768px) 410px, 100vw"
              class="aspect-[4/5] w-full rounded-[20px] object-cover"
            />
            <div class="flex items-baseline justify-between gap-3">
              <h3 class="text-xl font-bold text-gray-800">{program.tag}</h3>
              <span class="text-sm text-gray-600">{program.title}</span>
            </div>
            <p class="text-[15px] leading-relaxed text-gray-600">{program.points.join(' · ')}</p>
            <a
              href={`/program/${program.id}`}
              aria-label={`Lihat Detail ${program.tag}`}
              class={buttonClasses({ variant: 'outline-navy', className: 'mt-auto self-start' })}
            >
              Lihat Detail
            </a>
          </li>
        ))
      }
    </ol>
  </div>
</section>
