---
import { buttonClasses } from '~/lib/ui';
import Img from '~/components/Img.astro';

/**
 * Homepage hero (SAKEM-111, design "Opsi C"): a full-screen video loop with the
 * headline bottom-left and the actions bottom-right. The navbar floats over it
 * (Base's `navOverlay`). Copy is verbatim from the root HeroSection.tsx.
 *
 * The poster is the LCP element: a real <img> (eager, fetchpriority="high",
 * WebP ladder), with the video laid over it. The video is silent, 16 s, and
 * comes in two sizes (720p for phones, 1080p above). It is not in the HTML as
 * a playing element: the script below adds `autoplay` only when the visitor has
 * not asked for reduced motion or data saving, so those visitors see the poster.
 * The pause button stops the loop for anyone (WCAG 2.2.2: moving content longer
 * than five seconds needs a way to pause it).
 */
---

<header class="relative isolate flex min-h-[max(100svh,40rem)] flex-col overflow-hidden bg-primary-blue-dark text-white">
  <Img
    src="/images/home/hero-poster.jpg"
    alt=""
    sizes="100vw"
    loading="eager"
    fetchpriority="high"
    class="absolute inset-0 -z-20 h-full w-full object-cover"
  />
  <video
    id="hero-video"
    muted
    loop
    playsinline
    preload="none"
    aria-hidden="true"
    class="absolute inset-0 -z-20 h-full w-full object-cover"
  >
    <source src="/images/home/hero-loop-720.mp4" type="video/mp4" media="(max-width: 767px)" />
    <source src="/images/home/hero-loop.mp4" type="video/mp4" />
  </video>
  {/* Navy at the top for the navbar, navy at the bottom for the headline; the middle stays clear. */}
  <div
    aria-hidden="true"
    class="absolute inset-0 -z-10 bg-[linear-gradient(180deg,rgba(13,31,82,0.55)_0%,rgba(13,31,82,0)_22%,rgba(13,31,82,0)_45%,rgba(13,31,82,0.88)_100%)]"
  >
  </div>

  <div class="mx-auto flex w-full max-w-[1280px] grow flex-col justify-end gap-8 px-6 pb-12 pt-32">
    <h1 class="font-display text-[clamp(32px,3.6vw,52px)] font-medium leading-[1.12] tracking-[-0.025em] text-white">
      <span class="block md:whitespace-nowrap">Membuka Pintu <em class="font-medium">Pendidikan Tinggi</em></span>{' '}
      <span class="block md:whitespace-nowrap">untuk Setiap Anak Indonesia</span>
    </h1>

    <div class="flex flex-wrap items-end justify-between gap-x-12 gap-y-6 border-t border-white/30 pt-7">
      <p class="max-w-[36em] text-base leading-relaxed text-white/90">
        Kami hadir untuk mendobrak hambatan ekonomi dan geografis yang menghalangi siswa dari daerah terpencil
        dan keluarga kurang mampu dalam meraih impian mereka ke perguruan tinggi.
      </p>
      <div class="flex flex-wrap items-center gap-3">
        <a href="#activities" class={buttonClasses({ variant: 'white-on-navy', size: 'lg', className: 'px-6 text-primary-blue-dark' })}>
          Lihat Program Kami
        </a>
        <a href="/donasi" class={buttonClasses({ variant: 'outline-on-navy', size: 'lg', className: 'px-6 border-white/75' })}>
          Dukung Misi Kami
        </a>
        <button
          id="hero-video-toggle"
          type="button"
          hidden
          aria-label="Jeda video"
          class="flex size-12 items-center justify-center rounded-full border-[1.5px] border-white/60 bg-primary-blue-dark/35 text-white transition-colors hover:bg-primary-blue-dark/60"
        >
          <svg data-icon-pause width="16" height="16" viewBox="0 0 16 16" aria-hidden="true">
            <rect x="3" y="2" width="3.5" height="12" rx="1" fill="currentColor"></rect>
            <rect x="9.5" y="2" width="3.5" height="12" rx="1" fill="currentColor"></rect>
          </svg>
          <svg data-icon-play class="hidden" width="16" height="16" viewBox="0 0 16 16" aria-hidden="true">
            <path d="M4 2.5v11a.6.6 0 0 0 .9.5l9-5.5a.6.6 0 0 0 0-1l-9-5.5a.6.6 0 0 0-.9.5z" fill="currentColor"></path>
          </svg>
        </button>
      </div>
    </div>
  </div>
</header>

<script>
  // Start the loop unless the visitor asked for less motion or less data; then show the pause button.
  const video = document.getElementById('hero-video') as HTMLVideoElement | null;
  const toggle = document.getElementById('hero-video-toggle');
  const saveData = (navigator as Navigator & { connection?: { saveData?: boolean } }).connection?.saveData === true;
  if (video && toggle && !saveData && !matchMedia('(prefers-reduced-motion: reduce)').matches) {
    const show = (playing: boolean) => {
      toggle.setAttribute('aria-label', playing ? 'Jeda video' : 'Putar video');
      toggle.querySelector('[data-icon-pause]')?.classList.toggle('hidden', !playing);
      toggle.querySelector('[data-icon-play]')?.classList.toggle('hidden', playing);
    };
    video.preload = 'auto';
    video.play().then(
      () => {
        toggle.hidden = false;
        show(true);
      },
      () => {}, // Autoplay refused (a low-power mode, say): the poster stays, and so does the hidden button.
    );
    toggle.addEventListener('click', () => {
      if (video.paused) void video.play().then(() => show(true));
      else {
        video.pause();
        show(false);
      }
    });
  }
</script>
