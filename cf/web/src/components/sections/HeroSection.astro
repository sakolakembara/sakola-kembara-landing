---
import { Image } from 'astro:assets';
import heroImage from '@root/public/images/hero-team.png';
import Button from '~/components/Button.astro';
import Container from '~/components/Container.astro';
import Eyebrow from '~/components/Eyebrow.astro';
import Heading from '~/components/Heading.astro';
import { heroStats } from '~/lib/site';

/**
 * Homepage hero. Copy is verbatim from the root components/sections/HeroSection.tsx.
 * The photo is the LCP element: eager, fetchpriority="high", resized at build
 * time (the original is a 1.4 MB PNG), width/height set. Entrance motion is
 * pure CSS (.anim-fade-up); the photo panel only scales in, it does not fade,
 * so it can paint as LCP right away.
 */
---

<section
  class="pt-[var(--hero-top,8rem)] md:pt-40 pb-16 md:pb-24 bg-gradient-to-b from-gray-50 to-white relative overflow-hidden"
>
  <div
    aria-hidden="true"
    class="absolute -top-1/2 -right-1/5 w-[800px] h-[800px] bg-[radial-gradient(circle,rgba(30,136,229,0.08)_0%,transparent_70%)] rounded-full"
  >
  </div>

  <Container>
    <div class="grid lg:grid-cols-2 gap-12 lg:gap-16 items-center">
      <div class="anim-fade-up">
        <Eyebrow class="mb-4">Pendidikan Untuk Semua</Eyebrow>

        <Heading level="display" class="text-gray-900 mb-5 md:mb-6">
          Membuka Pintu <span class="text-primary-blue">Pendidikan Tinggi</span> untuk Setiap Anak Indonesia
        </Heading>

        <p class="text-base md:text-lg text-gray-600 mb-7 md:mb-8 leading-relaxed">
          Kami hadir untuk mendobrak hambatan ekonomi dan geografis yang menghalangi siswa dari daerah terpencil
          dan keluarga kurang mampu dalam meraih impian mereka ke perguruan tinggi.
        </p>

        <div class="flex flex-col sm:flex-row sm:flex-wrap gap-3 sm:gap-4">
          {/* The lift on hover is the hero's own touch (DESIGN.md, Buttons). */}
          <Button
            href="#activities"
            class="transition-all hover:-translate-y-0.5 hover:shadow-lg hover:shadow-primary-blue/30"
          >
            Lihat Program Kami
          </Button>
          <Button href="/donasi" variant="subtle">Dukung Misi Kami</Button>
        </div>

        {/* A grid, not a flex row: as a flex row the three items could not shrink below their
            min-content width and pushed the document wider than a phone screen. */}
        <div class="grid grid-cols-3 gap-4 sm:gap-8 mt-10 md:mt-12 pt-8 border-t border-gray-200">
          {
            heroStats.map((stat, index) => (
              <div class="text-left anim-fade-up" style={`animation-delay:${0.2 + index * 0.1}s`}>
                <div class="text-[28px] sm:text-4xl font-extrabold text-primary-blue leading-none">
                  {stat.number.includes('+') || stat.number.includes('%') ? (
                    <>
                      {stat.number.replace(/[+%]/g, '')}
                      <span class="text-secondary-yellow">{stat.number.includes('+') ? '+' : '%'}</span>
                    </>
                  ) : (
                    stat.number
                  )}
                </div>
                <div class="text-xs sm:text-sm text-gray-500 mt-1.5 sm:mt-2 leading-snug">{stat.label}</div>
              </div>
            ))
          }
        </div>
      </div>

      <div class="relative" style="animation:scale-in 0.6s ease-out 0.3s both">
        <div
          class="w-full aspect-[4/3] md:aspect-auto md:h-[450px] rounded-2xl md:rounded-3xl shadow-xl md:shadow-2xl overflow-hidden relative"
        >
          <Image
            src={heroImage}
            alt="Siswa Sakola Kembara belajar bersama"
            width={1200}
            widths={[480, 800, 1200]}
            sizes="(min-width: 1024px) 560px, 100vw"
            format="webp"
            quality={78}
            loading="eager"
            fetchpriority="high"
            decoding="async"
            class="absolute inset-0 h-full w-full object-cover"
          />
        </div>
      </div>
    </div>
  </Container>
</section>
