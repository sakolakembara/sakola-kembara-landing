---
import { problemStats } from '~/lib/home-data';
import StatDetail from './problem/StatDetail.astro';

/**
 * Homepage "Mengapa Kami Ada?" (SAKEM-111; layout after BYQ Lavender Shore
 * "Statistics with Large Numbers"): a navy band, the title and the answer on
 * top, then one ruled row per figure of problemStats: the figure large on the
 * left (its unit, "/10", "%+", "x", smaller in sunglow), the sentence on the
 * right on the figure's baseline. The figure with a detail text carries
 * "Mengapa ini terjadi?", which opens that text in a <dialog> (StatDetail; the
 * opener script is below).
 */
---

<section class="bg-primary-blue-dark px-6 py-20 text-white md:px-10 md:py-28">
  <div class="flex w-full flex-col gap-12 md:gap-16">
    <div class="flex flex-col gap-3 anim-reveal">
      <h2 class="font-body text-[clamp(36px,4.4vw,66px)] font-medium leading-[1.15] tracking-[-0.025em]">Mengapa Kami Ada?</h2>
      <p class="text-[clamp(20px,1.9vw,26px)] font-medium leading-snug text-white/70">Kami hadir untuk mengubah realitas ini.</p>
    </div>

    <ul class="border-b border-white/15">
      {
        problemStats.map((stat, index) => {
          const [, lead, unit] = stat.number.match(/^(\d+)(.*)$/) ?? [, stat.number, ''];
          return (
            <li
              class="grid items-end gap-x-12 gap-y-5 border-t border-white/15 py-8 md:grid-cols-2 md:py-10 anim-reveal"
              style={`--i:${index}`}
            >
              <p class="font-body text-[clamp(72px,9vw,136px)] font-medium text-secondary-yellow leading-[0.85] tracking-[-0.04em]">
                {lead}<span class="text-[0.6em] tracking-[-0.02em] text-secondary-yellow">{unit}</span>
              </p>
              <div class="flex flex-col items-start gap-5 md:pb-2">
                <p class="max-w-[24em] text-[clamp(18px,1.6vw,22px)] leading-normal text-white/90">{stat.text}.</p>
                {stat.detail && <StatDetail id={`problem-detail-${index + 1}`} stat={stat} />}
              </div>
            </li>
          );
        })
      }
    </ul>
  </div>
</section>

<script>
  // The only client JS of this section (about 0.3 KB), document-wide on purpose: it also opens the story dialogs of
  // StoriesSection. Open a <dialog> from its [data-dialog-open] button, and
  // close it on a click on the backdrop (the dialog element itself). "Tutup" is a
  // <form method="dialog">; Escape and focus return come from the browser.
  document.addEventListener('click', (event) => {
    const target = event.target as HTMLElement;
    const opener = target.closest<HTMLElement>('[data-dialog-open]');
    if (opener?.dataset.dialogOpen) {
      (document.getElementById(opener.dataset.dialogOpen) as HTMLDialogElement | null)?.showModal();
    } else if (target instanceof HTMLDialogElement) {
      target.close();
    }
  });
</script>
