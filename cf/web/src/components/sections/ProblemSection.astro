---
import { problemStats } from '~/lib/home-data';
import StatDetail from './problem/StatDetail.astro';

/**
 * Homepage "Mengapa Kami Ada?" (SAKEM-111; layout after BYQ Lavender Shore
 * "Statistics with Large Numbers"): a navy band, the title and the answer on
 * top, then one ruled row per figure of problemStats, the sentence on the left
 * and the figure large on the right (first on a phone). The figure with a detail text carries
 * "Mengapa ini terjadi?", which opens that text in a <dialog> (StatDetail; the
 * opener script is below).
 */
---

<section class="bg-primary-blue-dark px-6 py-20 text-white md:px-10 md:py-28">
  <div class="mx-auto flex max-w-[1440px] flex-col gap-14 md:gap-20">
    <div class="grid items-end gap-6 md:grid-cols-2 anim-reveal">
      <h2 class="font-display text-[clamp(34px,3.8vw,52px)] font-medium leading-[1.08] tracking-[-0.03em]">Mengapa Kami Ada?</h2>
      <p class="font-display text-[clamp(22px,2.2vw,30px)] italic leading-snug text-secondary-yellow md:justify-self-end">
        Kami hadir untuk mengubah realitas ini.
      </p>
    </div>

    <ul class="border-b border-white/15">
      {
        problemStats.map((stat, index) => (
          <li class="grid gap-4 border-t border-white/15 py-8 md:grid-cols-2 md:gap-10 md:py-10 anim-reveal" style={`--i:${index}`}>
            <p class="font-display text-[clamp(64px,8vw,120px)] font-medium leading-[0.9] tracking-[-0.04em] md:order-2">{stat.number}</p>
            <div class="flex flex-col items-start gap-5 md:order-1">
              <p class="max-w-[28em] text-lg leading-relaxed text-white/85">{stat.text}.</p>
              {stat.detail && <StatDetail id={`problem-detail-${index + 1}`} stat={stat} />}
            </div>
          </li>
        ))
      }
    </ul>
  </div>
</section>

<script>
  // The only client JS of this section (about 0.3 KB): open a stat's <dialog> from its button, and
  // close it on a click on the backdrop (the dialog element itself). "Tutup" is a
  // <form method="dialog">; Escape and focus return come from the browser.
  document.addEventListener('click', (event) => {
    const target = event.target as HTMLElement;
    const opener = target.closest<HTMLElement>('[data-dialog-open]');
    if (opener?.dataset.dialogOpen) {
      (document.getElementById(opener.dataset.dialogOpen) as HTMLDialogElement | null)?.showModal();
    } else if (target instanceof HTMLDialogElement) {
      target.close();
    }
  });
</script>
