---
import { problemStats } from '~/lib/home-data';

/**
 * Homepage "Mengapa Kami Ada?" (SAKEM-111; concept A of the second wireframe, Dzul 2026-10-27, after BYQ Stringer
 * "Scroll-Triggered Word Reveal" and Altum "Centered Intro Story Headline"): one screen tall on cream, the three facts
 * of problemStats and "Kami hadir untuk mengubah realitas ini." as four centred paragraphs, each fact with a small
 * infographic inside its sentence (ten children with three lit, the 55/45 bar, the city and village bars; decorative,
 * the sentence says it). The title is for screen readers only and "Mengapa ini terjadi?" is gone (both removed from
 * view by Dzul). Scroll text fill: every word turns from grey to navy in reading order on ONE timeline, the text
 * block's own view timeline, each word on its own slice of it, so the fill runs through the four paragraphs as the
 * block scrolls up (CSS scroll-driven behind @supports; with reduced motion or without support the words are navy).
 */
// Where each fact's infographic sits: right after this phrase of its sentence.
const anchors = ['Hanya', 'keluarga 20% terkaya', 'kesempatan 2x'];
const escape = (t: string) => t.replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;').replace(/"/g, '&quot;');
const NAVY = 'bg-primary-blue-dark';
const GREY = 'bg-[#C9D0DE]';
const kid = (on: boolean) =>
  `<svg viewBox="0 0 20 34" aria-hidden="true" class="h-[0.62em] w-[0.36em] ${on ? 'text-primary-blue-dark' : 'text-[#C9D0DE]'}"><circle cx="10" cy="6" r="5" fill="currentColor"/><path d="M3 15a7 7 0 0 1 14 0v8h-3v11H6V23H3Z" fill="currentColor"/></svg>`;
const swatch = (tone: string) => `<span class="inline-block size-2.5 shrink-0 rounded-full ${tone}"></span>`;
const legend = (rows: [string, string][]) =>
  `<span class="flex flex-col gap-1.5">${rows.map(([tone, label]) => `<span class="flex items-center gap-2">${swatch(tone)}${escape(label)}</span>`).join('')}</span>`;
// Each chart: the marks drawn in the line of text (no fill behind them), and what its popover says. The popover is the
// chart's legend, plus the long "Mengapa ini terjadi?" text where the fact has one.
const charts = problemStats.map((stat) => {
  const c = stat.chart;
  if (c.kind === 'pictogram') {
    return {
      marks: `<span class="flex items-end gap-[0.06em]">${Array.from({ length: c.total }, (_, i) => kid(i < c.highlighted)).join('')}</span>`,
      body: legend([[NAVY, `${c.highlighted} dari ${c.total} anak memiliki akses ke pendidikan tinggi`], [GREY, `${c.total - c.highlighted} lainnya belum`]]),
    };
  }
  if (c.kind === 'share') {
    return {
      // A small pie, the share in navy from twelve o'clock (a bar read lopsided next to the other charts; Dzul, 2026-10-27).
      marks: `<svg viewBox="0 0 20 20" aria-hidden="true" class="h-[0.72em] w-[0.72em] -rotate-90"><circle cx="10" cy="10" r="9" fill="#C9D0DE"/><circle cx="10" cy="10" r="4.5" fill="none" stroke="#0D1F52" stroke-width="9" pathLength="100" stroke-dasharray="${c.share * 100} 100"/></svg>`,
      body: legend([[NAVY, c.highlightLabel], [GREY, c.restLabel]]),
    };
  }
  const max = Math.max(...c.bars.map((bar) => bar.value));
  return {
    marks: `<span class="flex h-[0.62em] items-end gap-[0.08em]">${c.bars.map((bar, i) => `<span class="w-[0.3em] rounded-[0.06em] ${i === 0 ? NAVY : GREY}" style="height:${(bar.value / max) * 100}%"></span>`).join('')}</span>`,
    body: legend(c.bars.map((bar, i) => [i === 0 ? NAVY : GREY, `${bar.name}: ${bar.value}x`])),
  };
});
// A chart as a button with its popover: shown on hover, on keyboard focus, and while clicked open (the script below
// toggles data-open). The button's name is the chart's own description from home-data.
const chartHtml = (index: number) => {
  const stat = problemStats[index];
  const { marks, body } = charts[index];
  const id = `problem-chart-${index + 1}`;
  const detail = stat.detail ? `<span class="block border-t border-primary-blue-dark/10 pt-3 leading-relaxed text-gray-600"><span class="mb-1 block font-semibold text-primary-blue-dark">Mengapa ini terjadi?</span>${escape(stat.detail)}</span>` : '';
  return (
    `<span class="problem-chart relative inline-block align-baseline" data-chart>` +
    `<button type="button" aria-expanded="false" aria-controls="${id}" aria-label="${escape(stat.chart.label)}" class="mx-[0.1em] inline-flex translate-y-[0.06em] cursor-pointer items-end rounded-[0.15em] px-[0.08em] py-[0.04em] align-baseline outline-offset-4 transition-colors hover:bg-primary-blue-dark/[0.06]">${marks}</button>` +
    `<span id="${id}" role="tooltip" class="problem-pop absolute top-[calc(100%+0.35em)] left-1/2 z-20 w-max max-w-[min(28rem,calc(100vw-2rem))] max-h-[min(60vh,26rem)] -translate-x-1/2 flex-col overflow-y-auto overscroll-contain gap-3 rounded-xl border border-primary-blue-dark/10 bg-white p-4 text-left text-sm font-normal leading-snug tracking-normal text-primary-blue-dark shadow-[0_18px_40px_-16px_rgba(13,31,82,0.35)]">` +
    `<span class="text-2xl font-medium tracking-[-0.02em]">${escape(stat.number)}</span>${body}${detail}</span>` +
    `</span>`
  );
};

// Every paragraph as words; a chip token after its anchor. Each word gets its slice of the fill ('--a' to '--b', in % of
// the timeline), handed out in reading order over FILL_FROM..FILL_TO across all four paragraphs.
const FILL_FROM = 22;
const FILL_TO = 50;
const paragraphs = [
  ...problemStats.map((stat, index) => {
    const at = stat.text.indexOf(anchors[index]) + anchors[index].length;
    const tail = stat.text.slice(at).trim();
    const words = [...stat.text.slice(0, at).split(' '), `chip${index}`, ...(tail ? tail.split(' ') : [])];
    words[words.length - 1] += '.';
    return words;
  }),
  'Kami hadir untuk mengubah realitas ini.'.split(' '),
];
const total = paragraphs.flat().length;
let n = 0;
const html = paragraphs.map((words) =>
  words
    .map((word) => {
      const a = (FILL_FROM + ((FILL_TO - FILL_FROM) * n) / total).toFixed(2);
      const b = (FILL_FROM + ((FILL_TO - FILL_FROM) * (n + 1.5)) / total).toFixed(2);
      n += 1;
      const style = `style="--a:${a}%;--b:${b}%"`;
      const chip = /^chip(\d)(\.?)$/.exec(word);
      // The chart sits against a full stop that ends the sentence right after the anchor.
      if (chip) return `${chartHtml(Number(chip[1]))}${chip[2]}`;
      return `<span class="problem-word" ${style}>${word}</span>`;
    })
    // Words are joined by spaces, except before a chip that carries the full stop (it sits against the word before).
    .reduce((out, part, i) => (i === 0 ? part : out + (/^<span class="problem-chart[\s\S]*\.$/.test(part) ? '' : ' ') + part), ''),
);
---

<section class="flex min-h-[100svh] flex-col justify-center bg-[#FBFBF5] px-6 py-20 text-primary-blue-dark md:px-10 md:py-24" data-problem>
  <h2 class="sr-only">Mengapa Kami Ada?</h2>
  <div class="problem-text mx-auto flex max-w-[24em] flex-col gap-[0.9em] text-center font-body text-[clamp(28px,3.6vw,58px)] font-medium leading-[1.25] tracking-[-0.025em] text-balance">
    {html.slice(0, 3).map((p) => <p data-fact set:html={p} />)}
    <p class="underline decoration-secondary-yellow decoration-[0.12em] underline-offset-[0.18em]" set:html={html[3]} />
  </div>
</section>

<style>
  @supports (animation-timeline: view()) {
    @media (prefers-reduced-motion: no-preference) {
      .problem-text {
        view-timeline-name: --problem;
      }
      .problem-text :global(.problem-word) {
        color: #c3cada;
        animation: problem-word linear both;
        animation-timeline: --problem;
        animation-range: cover var(--a) cover var(--b);
      }
    }
  }
  @keyframes problem-word {
    to {
      color: var(--primary-blue-dark);
    }
  }
  /* A chart's popover: on hover, on keyboard focus, and while clicked open. */
  .problem-text :global(.problem-pop) {
    display: none;
  }
  .problem-text :global(.problem-chart:hover .problem-pop),
  .problem-text :global(.problem-chart[data-open] .problem-pop),
  .problem-text :global(.problem-chart:has(button:focus-visible) .problem-pop) {
    display: flex;
  }
</style>

<script>
  // The charts' popovers on touch and click: a click toggles the chart it is on and closes the others; a click elsewhere
  // or Escape closes them all. Hover and keyboard focus need no script (CSS above).
  const charts = [...document.querySelectorAll<HTMLElement>('[data-chart]')];
  const setOpen = (chart: HTMLElement, open: boolean) => {
    chart.toggleAttribute('data-open', open);
    chart.querySelector('button')?.setAttribute('aria-expanded', String(open));
  };
  document.addEventListener('click', (event) => {
    const hit = (event.target as HTMLElement).closest<HTMLElement>('[data-chart]');
    for (const chart of charts) setOpen(chart, chart === hit && !(event.target as HTMLElement).closest('.problem-pop') ? !chart.hasAttribute('data-open') : chart === hit && chart.hasAttribute('data-open'));
  });
  document.addEventListener('keydown', (event) => {
    if (event.key === 'Escape') for (const chart of charts) setOpen(chart, false);
  });
</script>
