---
import { problemStats } from '~/lib/home-data';
import StatDetail from './problem/StatDetail.astro';

/**
 * Homepage "Mengapa Kami Ada?" (SAKEM-111; concept A of the second wireframe, Dzul 2026-10-27, after BYQ Stringer
 * "Scroll-Triggered Word Reveal" and Altum "Centered Intro Story Headline"): one screen tall on cream, the title with
 * "Mengapa ini terjadi?" on the right, then the three facts of problemStats and "Kami hadir untuk mengubah realitas
 * ini." as four centred paragraphs, each fact with a small infographic inside its sentence (ten children with three
 * lit, the 55/45 bar, the city and village bars; decorative, the sentence says it). Each paragraph fills from grey to
 * navy, line after line, as it scrolls up (a background clipped to the text, CSS scroll-driven behind @supports; with
 * reduced motion or without support it is navy from the start). "Mengapa ini terjadi?" opens the detail text in a
 * <dialog> (StatDetail; the opener script is below).
 */
// Where each fact's infographic sits: right after this phrase of its sentence.
const anchors = ['Hanya', 'keluarga 20% terkaya', 'kesempatan 2x'];
const kid = (on: boolean) =>
  `<svg viewBox="0 0 20 34" class="h-[0.6em] w-[0.35em] ${on ? 'text-secondary-yellow' : 'text-white/25'}"><circle cx="10" cy="6" r="5" fill="currentColor"/><path d="M3 15a7 7 0 0 1 14 0v8h-3v11H6V23H3Z" fill="currentColor"/></svg>`;
// The infographics: navy pills with sunglow marks. Markup without whitespace, so the sentence around them reads as written.
const chip = (inner: string) =>
  `<span aria-hidden="true" class="mx-[0.12em] inline-flex h-[0.95em] translate-y-[0.1em] items-center gap-[0.1em] rounded-full bg-primary-blue-dark px-[0.4em] align-baseline shadow-[0_0.1em_0.3em_-0.1em_rgba(13,31,82,0.5)]">${inner}</span>`;
const charts = [
  Array.from({ length: 10 }, (_, i) => kid(i < 3)).join(''),
  '<span class="flex h-[0.26em] w-[2.6em] overflow-hidden rounded-full bg-white/25"><span class="problem-grow-x w-[55%] origin-left rounded-full bg-secondary-yellow"></span></span>',
  '<span class="flex h-[0.56em] items-end gap-[0.12em]"><span class="problem-grow-y h-full w-[0.32em] origin-bottom rounded-[0.08em] bg-secondary-yellow"></span><span class="problem-grow-y h-1/2 w-[0.32em] origin-bottom rounded-[0.08em] bg-white/40"></span></span>',
];
const facts = problemStats.map((stat, index) => {
  const at = stat.text.indexOf(anchors[index]) + anchors[index].length;
  const head = stat.text.slice(0, at);
  const tail = stat.text.slice(at);
  // The chip sits after the anchor's space when the sentence goes on, or right against the full stop when it ends there.
  return tail.trim() ? `${head} ${chip(charts[index])}${tail}.` : `${head}${chip(charts[index])}.`;
});
const detailIndex = problemStats.findIndex((s) => s.detail);
---

<section class="flex min-h-[100svh] flex-col gap-14 bg-[#FBFBF5] px-6 py-20 text-primary-blue-dark md:px-10 md:py-24" data-problem>
  <div class="flex flex-wrap items-start justify-between gap-6">
    <h2 class="font-body text-[clamp(36px,4.4vw,66px)] font-medium leading-[1.15] tracking-[-0.025em]">Mengapa Kami Ada?</h2>
    {detailIndex >= 0 && <StatDetail id={`problem-detail-${detailIndex + 1}`} stat={problemStats[detailIndex]} variant="outline-navy" />}
  </div>

  <div class="mx-auto flex max-w-[24em] grow flex-col justify-center gap-[0.9em] text-center font-body text-[clamp(28px,3.6vw,58px)] font-medium leading-[1.25] tracking-[-0.025em] text-balance">
    {facts.map((html) => <p data-fact><span class="problem-fill" set:html={html} /></p>)}
    <p><span class="problem-fill underline decoration-secondary-yellow decoration-[0.12em] underline-offset-[0.18em]">Kami hadir untuk mengubah realitas ini.</span></p>
  </div>
</section>

<style>
  /* Scroll text fill: each paragraph is navy on its left half and grey on its right, the background clipped to the
     text; sliding it left fills the lines in reading order as the paragraph scrolls up. The charts grow with it. */
  @supports (animation-timeline: view()) {
    @media (prefers-reduced-motion: no-preference) {
      [data-problem] .problem-fill {
        background: linear-gradient(90deg, var(--primary-blue-dark) 50%, #c3cada 50%) 100% 0 / 200% 100% no-repeat;
        -webkit-background-clip: text;
        background-clip: text;
        color: transparent;
        animation: problem-fill linear both;
        animation-timeline: view();
        animation-range: entry 40% cover 55%;
      }
      [data-problem] :global(.problem-grow-x) {
        animation: problem-grow-x linear both;
        animation-timeline: view();
        animation-range: entry 60% cover 50%;
      }
      [data-problem] :global(.problem-grow-y) {
        animation: problem-grow-y linear both;
        animation-timeline: view();
        animation-range: entry 60% cover 50%;
      }
    }
  }
  @keyframes problem-fill {
    to {
      background-position: 0 0;
    }
  }
  @keyframes problem-grow-x {
    from {
      scale: 0 1;
    }
  }
  @keyframes problem-grow-y {
    from {
      scale: 1 0;
    }
  }
</style>

<script>
  // The only client JS of this section (about 0.3 KB), document-wide on purpose: it also opens the story dialogs of
  // StoriesSection. Open a <dialog> from its [data-dialog-open] button, and
  // close it on a click on the backdrop (the dialog element itself). "Tutup" is a
  // <form method="dialog">; Escape and focus return come from the browser.
  document.addEventListener('click', (event) => {
    const target = event.target as HTMLElement;
    const opener = target.closest<HTMLElement>('[data-dialog-open]');
    if (opener?.dataset.dialogOpen) {
      (document.getElementById(opener.dataset.dialogOpen) as HTMLDialogElement | null)?.showModal();
    } else if (target instanceof HTMLDialogElement) {
      target.close();
    }
  });
</script>
