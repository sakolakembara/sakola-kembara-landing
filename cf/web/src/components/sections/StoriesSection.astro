---
import Img from '~/components/Img.astro';
import { testimonials } from '~/lib/home-data';
import { polaroidFrame, polaroidTilt } from '~/lib/ui';

/**
 * Homepage "Cerita Sukses Alumni" (SAKEM-111; Dzul, 2026-10-27): one story at a time, large, as a polaroid (the frame of
 * "Cerita & Inspirasi") with the whole quote beside it, and the other alumni as small cards next to it (photo, name,
 * campus). A click on a small card makes it the large one; the stories also change on their own every 5 s: the bar
 * under the quote fills and its `animationend` shows the next story, so pausing the bar (hover, keyboard focus, the
 * section out of view) pauses the rotation, and with reduced motion there is none. Without JS the first story shows and
 * the cards do nothing. The subtitle, the college figure card and the quote dialogs went with this layout.
 */
const photos: Record<number, string> = {
  1: '/images/testimoni/daffa-najwan.jpg',
  2: '/images/testimoni/natia-nur-faza.jpg',
  3: '/images/testimoni/chintya-dwi-azizah.jpg',
  4: '/images/testimoni/syahid-fattahul-ihsan.jpg',
  5: '/images/testimoni/muhammad-anwar-taufik.jpg',
  6: '/images/testimoni/jesika-marsha-yoanika.jpg',
  7: '/images/testimoni/fathya-sahla-humaira.jpg',
};
---

<section id="cerita" class="scroll-mt-24 bg-[#EEF1F6] px-6 py-20 md:px-10 md:py-28" data-stories>
  <div class="flex w-full flex-col gap-10 md:gap-14">
    <h2 class="text-center font-body text-[clamp(36px,4.4vw,66px)] font-medium leading-[1.15] tracking-[-0.025em] text-primary-blue-dark anim-reveal">
      Cerita Sukses Alumni
    </h2>

    <div class="grid items-center gap-10 lg:grid-cols-[minmax(0,1.55fr)_minmax(0,1fr)] lg:gap-14">
      <div>
        {
          testimonials.map((story, index) => (
            <article id={`cerita-${story.id}`} class="story grid items-center gap-8 md:grid-cols-[minmax(0,0.85fr)_minmax(0,1.15fr)] md:gap-10" hidden={index !== 0}>
              <figure class:list={[polaroidFrame, 'bg-white shadow-[0_18px_36px_-16px_rgba(13,31,82,0.4)]']} style={polaroidTilt(index)}>
                <Img src={photos[story.id]} alt={story.name} sizes="(min-width: 1024px) 26vw, (min-width: 768px) 40vw, 90vw" class="aspect-[4/5] w-full rounded-[3px] object-cover" />
                <figcaption class="flex flex-col px-1 pt-3">
                  <strong class="font-semibold text-primary-blue-dark">{story.name}</strong>
                  <span class="text-sm text-gray-600">{story.major}</span>
                </figcaption>
              </figure>
              <div class="flex flex-col gap-6">
                <blockquote class="text-[clamp(18px,1.55vw,22px)] font-medium leading-relaxed text-primary-blue-dark">“{story.quote}”</blockquote>
                <p class="text-[15px] text-gray-600">
                  <strong class="font-semibold text-primary-blue-dark">{story.name}</strong>, {story.major}, {story.university}
                </p>
                <span aria-hidden="true" class="relative h-[3px] w-full overflow-hidden rounded-full bg-primary-blue-dark/10">
                  <span class="story-bar absolute inset-y-0 left-0 w-0 rounded-full bg-primary-blue-dark" />
                </span>
              </div>
            </article>
          ))
        }
      </div>

      <ul class="-mx-6 flex snap-x gap-3 overflow-x-auto scroll-px-6 px-6 pb-2 lg:mx-0 lg:grid lg:grid-cols-3 lg:overflow-visible lg:px-0 lg:pb-0" aria-label="Cerita alumni lainnya">
        {
          testimonials.map((story, index) => (
            <li class="w-[38%] shrink-0 snap-start sm:w-[24%] lg:w-auto" hidden={index === 0}>
              <button
                type="button"
                aria-controls={`cerita-${story.id}`}
                aria-label={`Tampilkan cerita ${story.name}`}
                data-story={index}
                class="group flex w-full flex-col gap-2 rounded-[4px] bg-white p-1.5 pb-3 text-left shadow-[0_10px_24px_-14px_rgba(13,31,82,0.45)] transition-transform duration-300 hover:-translate-y-1 motion-reduce:transition-none"
              >
                <Img src={photos[story.id]} alt="" sizes="(min-width: 1024px) 12vw, 38vw" class="aspect-square w-full rounded-[3px] object-cover" />
                <span class="flex flex-col px-1">
                  <span class="text-sm font-semibold leading-tight text-primary-blue-dark">{story.name}</span>
                  <span class="text-xs leading-snug text-gray-600">{story.university}</span>
                </span>
              </button>
            </li>
          ))
        }
      </ul>
    </div>
  </div>
</section>

<style>
  /* The shown story's bar fills in 5 s; its animationend shows the next story (the script). */
  .story:not([hidden]) .story-bar {
    animation: story-fill 5s linear forwards;
  }
  [data-stories][data-paused] .story-bar {
    animation-play-state: paused;
  }
  @keyframes story-fill {
    to {
      width: 100%;
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .story:not([hidden]) .story-bar {
      animation: none;
      width: 100%;
    }
  }
</style>

<script>
  // One story large at a time: a small card's click shows its story, the bar's animationend shows the next one.
  const section = document.querySelector<HTMLElement>('[data-stories]');
  if (section) {
    const stories = [...section.querySelectorAll<HTMLElement>('.story')];
    const cards = [...section.querySelectorAll<HTMLButtonElement>('[data-story]')];
    const show = (next: number) => {
      stories.forEach((story, i) => (story.hidden = i !== next));
      cards.forEach((card, i) => (card.parentElement!.hidden = i === next));
    };
    cards.forEach((card, i) => card.addEventListener('click', () => show(i)));
    stories.forEach((story, i) => story.querySelector('.story-bar')!.addEventListener('animationend', () => show((i + 1) % stories.length)));
    let hovered = false;
    let visible = true;
    // Keyboard focus pauses; a mouse click leaves focus on a card, so focus only counts while visible as such.
    const pause = () => section.toggleAttribute('data-paused', hovered || !visible || !!section.querySelector(':focus-visible'));
    section.addEventListener('pointerenter', () => ((hovered = true), pause()));
    section.addEventListener('pointerleave', () => ((hovered = false), pause()));
    section.addEventListener('focusin', pause);
    section.addEventListener('focusout', () => setTimeout(pause));
    new IntersectionObserver(([entry]) => ((visible = entry.isIntersecting), pause())).observe(section);
  }
</script>
