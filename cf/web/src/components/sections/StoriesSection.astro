---
import Img from '~/components/Img.astro';
import { testimonials } from '~/lib/home-data';

/**
 * Homepage "Cerita Sukses Alumni" (SAKEM-111, design "Opsi C"; the target of the
 * impact section's link): the first two testimonials, a portrait and a quote
 * each. Quotes are verbatim from home-data.ts.
 */
const photos: Record<number, string> = {
  1: '/images/testimoni/daffa-najwan.jpg',
  2: '/images/testimoni/natia-nur-faza.jpg',
};
const stories = testimonials.slice(0, 2);
---

<section id="cerita" class="scroll-mt-24 px-6 pb-20 md:pb-28">
  <div class="mx-auto flex max-w-[1280px] flex-col gap-10">
    <h2 class="font-display text-[clamp(34px,3.8vw,52px)] font-medium tracking-[-0.03em] text-primary-blue-dark anim-reveal">
      Cerita Sukses Alumni
    </h2>
    <div class="grid gap-6 lg:grid-cols-2">
      {
        stories.map((story, index) => (
          <figure
            class="grid gap-6 rounded-[20px] bg-white p-6 shadow-[0_1px_30px_rgba(13,31,82,0.06)] sm:grid-cols-[140px_1fr] anim-reveal"
            style={`--i:${index}`}
          >
            <Img
              src={photos[story.id]}
              alt={story.name}
              sizes="140px"
              class="h-[180px] w-[140px] rounded-[14px] object-cover"
            />
            <div class="flex flex-col gap-3.5">
              <blockquote class="font-display text-[19px] leading-normal text-gray-800">“{story.quote}”</blockquote>
              <figcaption class="mt-auto text-sm text-gray-600">
                <strong class="text-gray-800">{story.name}</strong> · {story.major}
              </figcaption>
            </div>
          </figure>
        ))
      }
    </div>
  </div>
</section>
