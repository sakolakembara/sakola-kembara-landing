---
import Img from '~/components/Img.astro';
import { testimonials } from '~/lib/home-data';
import { polaroidFrame, polaroidTilt } from '~/lib/ui';

/**
 * Homepage "Cerita Sukses Alumni" (SAKEM-111; Dzul, 2026-10-27): the whole section is one letter, a screen tall: the
 * title with all seven alumni as small photos on its right (a click shows that story; name and campus in the button's
 * name and title), then the whole quote large on the left and, level with it and in proportion to it on the right, the
 * alumnus's photo as a polaroid (the frame of "Cerita & Inspirasi") clipped on, name, major and campus on its strip.
 * Every story's parts sit in the same grid cells (the story wrapper is `display: contents`), so the letter keeps the
 * size of the longest story; only the active one is visible, the others are invisible and inert. The stories change
 * every 5 s: the ring on the large photo (like the program steps') fills and its `animationend` shows the next story,
 * so pausing it (hover, keyboard focus, the section out of view) pauses the rotation, and with reduced motion the ring
 * is simply full and nothing rotates. The small photos other than the active one are dimmed. Without JS the first story shows and the photos do nothing.
 */
const photos: Record<number, string> = {
  1: '/images/testimoni/daffa-najwan.jpg',
  2: '/images/testimoni/natia-nur-faza.jpg',
  3: '/images/testimoni/chintya-dwi-azizah.jpg',
  4: '/images/testimoni/syahid-fattahul-ihsan.jpg',
  5: '/images/testimoni/muhammad-anwar-taufik.jpg',
  6: '/images/testimoni/jesika-marsha-yoanika.jpg',
  7: '/images/testimoni/fathya-sahla-humaira.jpg',
};
---

<section id="cerita" class="scroll-mt-24 flex min-h-[100svh] bg-[#EEF1F6] px-4 py-6 md:px-10 md:py-10" data-stories>
  <div class="grid w-full grid-cols-1 content-between gap-8 rounded-[6px] bg-white p-6 shadow-[0_18px_40px_-16px_rgba(13,31,82,0.35)] md:p-12 lg:grid-cols-[minmax(0,1.35fr)_minmax(0,1fr)] lg:grid-rows-[auto_1fr] lg:gap-x-16 lg:gap-y-12">
    <div class="flex flex-wrap items-start justify-between gap-6 [grid-area:1/1] lg:[grid-area:1/1/2/3]">
      <h2 class="font-body text-[clamp(32px,3.9vw,56px)] font-medium leading-[1.15] tracking-[-0.025em] text-primary-blue-dark anim-reveal">
        Cerita Sukses Alumni
      </h2>
      <ul class="flex flex-wrap gap-2.5" aria-label="Cerita alumni lainnya">
        {
          testimonials.map((story, index) => (
            <li>
              <button
                type="button"
                aria-controls={`cerita-${story.id}`}
                aria-label={`Tampilkan cerita ${story.name}`}
                aria-current={index === 0 ? 'true' : undefined}
                title={`${story.name}, ${story.university}`}
                data-story={index}
                data-active={index === 0 ? '' : undefined}
                class="relative block rounded-[4px] bg-white p-1 opacity-60 shadow-[0_14px_30px_-14px_rgba(13,31,82,0.45)] transition duration-300 hover:-translate-y-1 hover:opacity-100 data-active:opacity-100 motion-reduce:transition-none"
              >
                <Img src={photos[story.id]} alt="" sizes="64px" class="size-12 rounded-[3px] object-cover md:size-16" />
              </button>
            </li>
          ))
        }
      </ul>
    </div>

    {
      testimonials.map((story, index) => (
        <div id={`cerita-${story.id}`} class="story contents" inert={index !== 0} data-active={index === 0 ? '' : undefined}>
          <div class="story-part flex flex-col lg:items-end lg:self-center [grid-area:2/1] lg:[grid-area:2/2]">
            <figure class:list={[polaroidFrame, 'relative w-[min(80%,22rem)] bg-white !pb-4 shadow-[0_14px_30px_-14px_rgba(13,31,82,0.45)] lg:w-full lg:max-w-[26rem]']} style={polaroidTilt(index + 1)}>
              <svg aria-hidden="true" viewBox="0 0 40 30" class="absolute -top-5 left-1/2 z-10 h-8 w-11 -translate-x-1/2 overflow-visible text-primary-blue-dark">
                <path d="M12 17 V6 a8 8 0 0 1 16 0 V17" fill="none" stroke="#9AA3B8" stroke-width="2.4" stroke-linecap="round" />
                <path d="M6 14 h28 l-3 14 h-22 z" fill="currentColor" />
              </svg>
              <span class="relative block">
                <Img src={photos[story.id]} alt={story.name} sizes="(min-width: 1024px) 26rem, 80vw" class="aspect-[4/5] w-full rounded-[3px] object-cover" />
                <span aria-hidden="true" class="absolute right-3 top-3 flex rounded-full bg-white/90 p-1 shadow-sm">
                  <svg viewBox="0 0 24 24" class="size-6 -rotate-90">
                    <circle cx="12" cy="12" r="10" fill="none" stroke="currentColor" stroke-width="2.5" class="text-primary-blue-dark/15" />
                    <circle cx="12" cy="12" r="10" fill="none" stroke-width="2.5" pathLength="100" class="story-bar stroke-primary-blue-dark" />
                  </svg>
                </span>
              </span>
              <figcaption class="flex flex-col px-1 pt-3">
                <strong class="text-lg font-semibold text-primary-blue-dark">{story.name}</strong>
                <span class="text-sm text-gray-600">{story.major}, {story.university}</span>
              </figcaption>
            </figure>
          </div>
          <blockquote class="story-part self-center text-[clamp(20px,2.1vw,32px)] font-medium leading-[1.45] tracking-[-0.01em] text-primary-blue-dark [grid-area:3/1] lg:[grid-area:2/1]">
            “{story.quote}”
          </blockquote>
        </div>
      ))
    }

  </div>
</section>

<style>
  /* The ring on the large photo (like the program steps') fills in 5 s; its animationend shows the next story (the script). */
  .story-bar {
    stroke-dasharray: 100;
    stroke-dashoffset: 100;
  }
  .story[data-active] .story-bar {
    animation: story-fill 5s linear forwards;
  }
  /* The stories' parts share their grid cells, so the letter keeps the size of the longest story; only the active one shows. */
  .story:not([data-active]) .story-part {
    visibility: hidden;
  }
  [data-stories][data-paused] .story-bar {
    animation-play-state: paused;
  }
  @keyframes story-fill {
    to {
      stroke-dashoffset: 0;
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .story[data-active] .story-bar {
      animation: none;
      stroke-dashoffset: 0;
    }
  }
</style>

<script>
  // One story at a time: a small photo's click shows its story; the ring on the large photo, once full, shows the next.
  const section = document.querySelector<HTMLElement>('[data-stories]');
  if (section) {
    const stories = [...section.querySelectorAll<HTMLElement>('.story')];
    const cards = [...section.querySelectorAll<HTMLButtonElement>('[data-story]')];
    const show = (next: number) => {
      stories.forEach((story, i) => {
        story.toggleAttribute('data-active', i === next);
        story.inert = i !== next;
      });
      cards.forEach((card, i) => {
        card.toggleAttribute('data-active', i === next);
        if (i === next) card.setAttribute('aria-current', 'true');
        else card.removeAttribute('aria-current');
      });
    };
    cards.forEach((card, i) => card.addEventListener('click', () => show(i)));
    stories.forEach((story, i) => story.querySelector('.story-bar')!.addEventListener('animationend', () => show((i + 1) % stories.length)));
    let hovered = false;
    let visible = true;
    // Keyboard focus pauses; a mouse click leaves focus on a card, so focus only counts while visible as such.
    const pause = () => section.toggleAttribute('data-paused', hovered || !visible || !!section.querySelector(':focus-visible'));
    section.addEventListener('pointerenter', () => ((hovered = true), pause()));
    section.addEventListener('pointerleave', () => ((hovered = false), pause()));
    section.addEventListener('focusin', pause);
    section.addEventListener('focusout', () => setTimeout(pause));
    new IntersectionObserver(([entry]) => ((visible = entry.isIntersecting), pause())).observe(section);
  }
</script>
