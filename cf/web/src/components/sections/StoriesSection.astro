---
import Img from '~/components/Img.astro';
import { testimonials } from '~/lib/home-data';
import { polaroidFrame, polaroidTilt } from '~/lib/ui';

/**
 * Homepage "Cerita Sukses Alumni" (SAKEM-111; Dzul, 2026-10-27): two equal halves, on the left the title with the other
 * alumni as small cards (photo, name, campus; the six others, three to a row), on the right one story large, a
 * letter: name and campus top left, the whole quote under them, and the alumnus's photo as a small polaroid (the frame
 * of "Cerita & Inspirasi") clipped onto its top right edge by a binder clip. All the letters share one grid cell, so
 * the letter keeps the size of the longest story while they change (the others are invisible and inert). A click on a small card makes it the
 * large one; the stories also change on their own every 5 s: the ring on the photo (like the program steps') fills and its `animationend` shows the next story, so pausing the bar (hover, keyboard focus, the
 * section out of view) pauses the rotation, and with reduced motion there is none. Without JS the first story shows and
 * the cards do nothing. The subtitle, the college figure card and the quote dialogs went with this layout.
 */
const photos: Record<number, string> = {
  1: '/images/testimoni/daffa-najwan.jpg',
  2: '/images/testimoni/natia-nur-faza.jpg',
  3: '/images/testimoni/chintya-dwi-azizah.jpg',
  4: '/images/testimoni/syahid-fattahul-ihsan.jpg',
  5: '/images/testimoni/muhammad-anwar-taufik.jpg',
  6: '/images/testimoni/jesika-marsha-yoanika.jpg',
  7: '/images/testimoni/fathya-sahla-humaira.jpg',
};
---

<section id="cerita" class="scroll-mt-24 bg-[#EEF1F6] px-6 py-20 md:px-10 md:py-28" data-stories>
  <div class="grid items-start gap-10 lg:grid-cols-2 lg:gap-14">
    <div class="flex flex-col gap-8">
      <h2 class="font-body text-[clamp(36px,4.4vw,66px)] font-medium leading-[1.15] tracking-[-0.025em] text-primary-blue-dark anim-reveal">
        Cerita Sukses Alumni
      </h2>
      <ul class="-mx-6 flex snap-x gap-3 overflow-x-auto scroll-px-6 px-6 pb-2 lg:mx-0 lg:grid lg:grid-cols-3 lg:overflow-visible lg:px-0 lg:pb-0" aria-label="Cerita alumni lainnya">
        {
          testimonials.map((story, index) => (
            <li class="w-[38%] shrink-0 snap-start sm:w-[24%] lg:w-auto" hidden={index === 0}>
              <button
                type="button"
                aria-controls={`cerita-${story.id}`}
                aria-label={`Tampilkan cerita ${story.name}`}
                data-story={index}
                class="group flex w-full flex-col gap-2 rounded-[4px] bg-white p-1.5 pb-3 text-left shadow-[0_14px_30px_-14px_rgba(13,31,82,0.45)] transition-transform duration-300 hover:-translate-y-1 motion-reduce:transition-none"
              >
                <Img src={photos[story.id]} alt="" sizes="(min-width: 1024px) 15vw, 38vw" class="aspect-square w-full rounded-[3px] object-cover" />
                <span class="flex flex-col px-1">
                  <span class="text-sm font-semibold leading-tight text-primary-blue-dark">{story.name}</span>
                  <span class="text-xs leading-snug text-gray-600">{story.university}</span>
                </span>
              </button>
            </li>
          ))
        }
      </ul>
    </div>

    <div class="grid pt-6">
        {
          testimonials.map((story, index) => (
            <article id={`cerita-${story.id}`} class="story relative [grid-area:1/1]" inert={index !== 0} data-active={index === 0 ? '' : undefined}>
              <div class="flex h-full flex-col gap-6 rounded-[6px] bg-white p-6 shadow-[0_18px_40px_-16px_rgba(13,31,82,0.35)] md:p-10">
                <p class="flex min-h-[7.5rem] flex-col pr-[calc(min(36%,9.5rem)+1rem)] md:min-h-[9rem]">
                  <strong class="text-lg font-semibold text-primary-blue-dark">{story.name}</strong>
                  <span class="text-sm text-gray-600">{story.major}</span>
                  <span class="text-sm text-gray-600">{story.university}</span>
                </p>
                <blockquote class="text-[clamp(18px,1.5vw,22px)] font-medium leading-relaxed text-primary-blue-dark">“{story.quote}”</blockquote>
              </div>
              <figure class:list={[polaroidFrame, 'absolute -top-6 right-6 z-10 w-[min(36%,9.5rem)] bg-white !pb-3 shadow-[0_14px_30px_-14px_rgba(13,31,82,0.45)] md:right-10']} style={polaroidTilt(index + 1)}>
                <svg aria-hidden="true" viewBox="0 0 40 30" class="absolute -top-4 left-1/2 z-10 h-7 w-10 -translate-x-1/2 text-primary-blue-dark">
                  <path d="M12 17 V6 a8 8 0 0 1 16 0 V17" fill="none" stroke="#9AA3B8" stroke-width="2.4" stroke-linecap="round" />
                  <path d="M6 14 h28 l-3 14 h-22 z" fill="currentColor" />
                </svg>
                <span class="relative block">
                  <Img src={photos[story.id]} alt={story.name} sizes="10rem" class="aspect-[4/5] w-full rounded-[3px] object-cover" />
                  <span aria-hidden="true" class="absolute right-1.5 top-1.5 flex rounded-full bg-white/90 p-0.5 shadow-sm">
                    <svg viewBox="0 0 24 24" class="size-5 -rotate-90">
                      <circle cx="12" cy="12" r="10" fill="none" stroke="currentColor" stroke-width="2.5" class="text-primary-blue-dark/15" />
                      <circle cx="12" cy="12" r="10" fill="none" stroke-width="2.5" pathLength="100" class="story-bar stroke-primary-blue-dark" />
                    </svg>
                  </span>
                </span>
              </figure>
            </article>
          ))
        }
    </div>
  </div>
</section>

<style>
  /* The shown story's ring (like the program steps') fills in 5 s; its animationend shows the next story (the script). */
  .story-bar {
    stroke-dasharray: 100;
    stroke-dashoffset: 100;
  }
  .story[data-active] .story-bar {
    animation: story-fill 5s linear forwards;
  }
  /* The stories share one grid cell, so the letter keeps the size of the longest one; only the active one shows. */
  .story:not([data-active]) {
    visibility: hidden;
  }
  [data-stories][data-paused] .story-bar {
    animation-play-state: paused;
  }
  @keyframes story-fill {
    to {
      stroke-dashoffset: 0;
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .story[data-active] .story-bar {
      animation: none;
      stroke-dashoffset: 0;
    }
  }
</style>

<script>
  // One story large at a time: a small card's click shows its story, the bar's animationend shows the next one.
  const section = document.querySelector<HTMLElement>('[data-stories]');
  if (section) {
    const stories = [...section.querySelectorAll<HTMLElement>('.story')];
    const cards = [...section.querySelectorAll<HTMLButtonElement>('[data-story]')];
    const show = (next: number) => {
      stories.forEach((story, i) => {
        story.toggleAttribute('data-active', i === next);
        story.inert = i !== next;
      });
      cards.forEach((card, i) => (card.parentElement!.hidden = i === next));
    };
    cards.forEach((card, i) => card.addEventListener('click', () => show(i)));
    stories.forEach((story, i) => story.querySelector('.story-bar')!.addEventListener('animationend', () => show((i + 1) % stories.length)));
    let hovered = false;
    let visible = true;
    // Keyboard focus pauses; a mouse click leaves focus on a card, so focus only counts while visible as such.
    const pause = () => section.toggleAttribute('data-paused', hovered || !visible || !!section.querySelector(':focus-visible'));
    section.addEventListener('pointerenter', () => ((hovered = true), pause()));
    section.addEventListener('pointerleave', () => ((hovered = false), pause()));
    section.addEventListener('focusin', pause);
    section.addEventListener('focusout', () => setTimeout(pause));
    new IntersectionObserver(([entry]) => ((visible = entry.isIntersecting), pause())).observe(section);
  }
</script>
