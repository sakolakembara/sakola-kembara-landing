---
import Img from '~/components/Img.astro';
import { testimonials } from '~/lib/home-data';

/**
 * Homepage "Cerita Sukses Alumni" (SAKEM-111; layout after BYQ Stringer
 * "Interactive Member Register"): a register of every alumnus of
 * home-data.ts on the left, the chosen one's portrait and quote on the right.
 * Every quote is in the HTML (crawlers, screen readers, no JS: the first one
 * shows); the script below swaps the panel when a row is hovered, focused or
 * clicked. From lg the panel sits on the register's last line. No auto-advance:
 * the page already has one moving element, the hero.
 */
const photos: Record<number, string> = {
  1: '/images/testimoni/daffa-najwan.jpg',
  2: '/images/testimoni/natia-nur-faza.jpg',
  3: '/images/testimoni/chintya-dwi-azizah.jpg',
  4: '/images/testimoni/syahid-fattahul-ihsan.jpg',
  5: '/images/testimoni/muhammad-anwar-taufik.jpg',
  6: '/images/testimoni/jesika-marsha-yoanika.jpg',
  7: '/images/testimoni/fathya-sahla-humaira.jpg',
};
const pad = (n: number) => String(n).padStart(2, '0');
---

<section id="cerita" class="scroll-mt-24 px-6 pb-20 md:px-10 md:pb-28" data-stories>
  <div class="mx-auto grid max-w-[1440px] gap-12 lg:grid-cols-[minmax(0,5fr)_minmax(0,7fr)] lg:items-end lg:gap-20">
    <div class="flex flex-col gap-8 anim-reveal">
      <div class="flex flex-col gap-3">
        <h2 class="font-display text-[clamp(34px,3.8vw,52px)] font-medium leading-[1.08] tracking-[-0.03em] text-primary-blue-dark">
          Cerita Sukses Alumni
        </h2>
        <p class="text-[17px] leading-[1.65] text-gray-600">Perjalanan inspiratif dari siswa-siswa kami</p>
      </div>
      <ul class="border-t border-primary-blue-dark">
        {
          testimonials.map((story, index) => (
            <li>
              <button
                type="button"
                data-story-tab={index}
                aria-pressed={index === 0 ? 'true' : 'false'}
                aria-controls={`story-${story.id}`}
                class="group grid w-full grid-cols-[2.5rem_minmax(0,1fr)] items-baseline gap-x-4 border-b border-gray-200 py-3.5 text-left transition-colors hover:bg-white sm:grid-cols-[2.5rem_minmax(0,1fr)_minmax(0,1fr)] aria-pressed:bg-white"
              >
                <span class="text-sm tabular-nums text-gray-500 group-aria-pressed:text-primary-blue-dark">{pad(index + 1)}</span>
                <span class="font-semibold text-gray-800 group-aria-pressed:text-primary-blue-dark">{story.name}</span>
                <span class="col-start-2 text-sm text-gray-600 sm:col-start-3">{story.major}</span>
              </button>
            </li>
          ))
        }
      </ul>
    </div>

    <div aria-live="polite" class="anim-reveal" style="--i:1">
      {
        testimonials.map((story, index) => (
          <figure id={`story-${story.id}`} data-story-panel={index} hidden={index !== 0} class="grid gap-8 sm:grid-cols-[minmax(0,2fr)_minmax(0,3fr)] sm:items-end">
            <Img
              src={photos[story.id]}
              alt={story.name}
              sizes="(min-width: 1024px) 300px, (min-width: 640px) 40vw, 100vw"
              class="aspect-[3/4] w-full rounded-[20px] object-cover"
            />
            <div class="flex flex-col gap-5">
              <blockquote
                class:list={[
                  'font-display font-medium leading-[1.3] tracking-[-0.01em] text-primary-blue-dark',
                  story.quote.length > 280 ? 'text-[clamp(19px,1.6vw,23px)]' : 'text-[clamp(24px,2.3vw,32px)]',
                ]}
              >
                “{story.quote}”
              </blockquote>
              <figcaption class="border-t border-gray-200 pt-4 text-sm text-gray-600">
                <strong class="text-gray-800">{story.name}</strong> · {story.major}
              </figcaption>
            </div>
          </figure>
        ))
      }
    </div>
  </div>
</section>

<script>
  // Show the story of the row that is hovered, focused or clicked (about 0.4 KB).
  const root = document.querySelector('[data-stories]');
  if (root) {
    const tabs = [...root.querySelectorAll<HTMLButtonElement>('[data-story-tab]')];
    const panels = [...root.querySelectorAll<HTMLElement>('[data-story-panel]')];
    const show = (i: number) => {
      tabs.forEach((t, n) => t.setAttribute('aria-pressed', String(n === i)));
      panels.forEach((p, n) => (p.hidden = n !== i));
    };
    for (const tab of tabs) {
      const i = Number(tab.dataset.storyTab);
      for (const type of ['click', 'focus', 'mouseenter']) tab.addEventListener(type, () => show(i));
    }
  }
</script>
