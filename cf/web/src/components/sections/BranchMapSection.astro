---
import { BRANCH_MAP } from '~/lib/branch-map';
import { branches } from '~/lib/site';

/**
 * Homepage branch map (SAKEM-111; option B of the map wireframe without its tabs and figures, Dzul 2026-10-27, drawn
 * after the dotted office map of Global DMC): one screen tall, the title, then Indonesia as a dotted map in a white
 * card with a pulsing point per branch of `branches` and arcs from Bandung to the branches further out, drawn in as
 * the map scrolls up (CSS scroll-driven behind @supports; whole with reduced motion or without support). The dots and
 * the points are generated by scripts/gen-branch-map.mjs. The West Java branches sit a few pixels apart, so only the
 * towns that stand apart carry a name pill; every branch is in the map's accessible name and in a list for screen
 * readers.
 */
const { width, height, dots, points } = BRANCH_MAP;
const pct = ([x, y]: [number, number]) => `left:${((x / width) * 100).toFixed(2)}%;top:${((y / height) * 100).toFixed(2)}%`;
const from = points.Bandung;
// Arcs from Bandung, lifted in proportion to their length.
const arc = (to: [number, number]) => {
  const lift = Math.max(3, Math.hypot(to[0] - from[0], to[1] - from[1]) * 0.25);
  return `M ${from[0]} ${from[1]} Q ${((from[0] + to[0]) / 2).toFixed(2)} ${(Math.min(from[1], to[1]) - lift).toFixed(2)} ${to[0]} ${to[1]}`;
};
const arcs = ['Cirebon', 'Purbalingga', 'Samarinda'].map((name) => arc(points[name]));
// Name pills: where they sit against their point (the Bandung cluster's pill to the left of it).
const pills: { name: string; side: 'left' | 'above' | 'below' }[] = [
  { name: 'Bandung', side: 'left' },
  { name: 'Cirebon', side: 'above' },
  { name: 'Purbalingga', side: 'below' },
  { name: 'Samarinda', side: 'above' },
];
const pillShift = {
  left: '-translate-x-[calc(100%+12px)] -translate-y-1/2',
  above: '-translate-x-1/2 -translate-y-[calc(100%+12px)]',
  below: '-translate-x-1/2 translate-y-[12px]',
};
const names = branches.map((b) => b.name).join(', ');
---

<section id="cabang" class="flex min-h-[100svh] flex-col justify-center gap-10 bg-[#EEF1F6] px-6 py-20 text-primary-blue-dark md:gap-14 md:px-10 md:py-24">
  <h2 class="font-body text-[clamp(36px,4.4vw,66px)] font-medium leading-[1.15] tracking-[-0.025em] anim-reveal">
    Hadir dari Bandung <br />sampai Samarinda
  </h2>

  <div class="rounded-xl bg-white p-4 shadow-[0_18px_40px_-16px_rgba(13,31,82,0.35)] md:p-8" data-branch-map>
    <div class="relative w-full" style={`aspect-ratio:${width}/${height}`}>
      <img src={dots} alt="" width={width} height={height} loading="lazy" decoding="async" class="absolute inset-0 h-full w-full select-none" />
      <svg viewBox={`0 0 ${width} ${height}`} role="img" aria-label={`Peta cabang Sakola Kembara: ${names}`} class="absolute inset-0 h-full w-full overflow-visible">
        {arcs.map((d) => <path d={d} pathLength="1" fill="none" stroke="#0D1F52" stroke-width="0.35" stroke-linecap="round" stroke-dasharray="0.012 0.018" class="branch-arc" />)}
        {
          branches.map((branch, i) => {
            const [x, y] = points[branch.name];
            return (
              <g>
                <circle cx={x} cy={y} r="1.2" fill="#FAD02B" class="branch-pulse" style={`animation-delay:${(i * 0.35).toFixed(2)}s`} />
                <circle cx={x} cy={y} r="1" fill="#0D1F52" stroke="#fff" stroke-width="0.35" />
              </g>
            );
          })
        }
      </svg>
      {
        pills.map(({ name, side }) => (
          <span
            aria-hidden="true"
            class:list={['pointer-events-none absolute whitespace-nowrap rounded-full border border-primary-blue-dark/10 bg-white px-3 py-1 text-xs font-semibold shadow-sm md:text-sm', pillShift[side]]}
            style={pct(points[name])}
          >
            {name === 'Bandung' ? 'Bandung & sekitarnya' : name}
          </span>
        ))
      }
    </div>
    <ul class="sr-only">
      {branches.map((b) => <li>{b.name}, {b.region}</li>)}
    </ul>
  </div>
</section>

<style>
  /* Each point pulses (a sunglow ring growing and fading), one after another; not with reduced motion. */
  .branch-pulse {
    transform-box: fill-box;
    transform-origin: center;
    opacity: 0;
  }
  @media (prefers-reduced-motion: no-preference) {
    .branch-pulse {
      animation: branch-pulse 2.4s ease-out infinite;
    }
  }
  @keyframes branch-pulse {
    0% {
      opacity: 0.8;
      transform: scale(1);
    }
    100% {
      opacity: 0;
      transform: scale(4);
    }
  }
  /* The arcs draw in from Bandung as the map scrolls up. */
  @supports (animation-timeline: view()) {
    @media (prefers-reduced-motion: no-preference) {
      [data-branch-map] {
        view-timeline-name: --branch-map;
      }
      .branch-arc {
        animation: branch-arc linear both;
        animation-timeline: --branch-map;
        animation-range: entry 20% cover 45%;
      }
    }
  }
  @keyframes branch-arc {
    from {
      clip-path: inset(0 100% 0 0);
    }
  }
</style>
