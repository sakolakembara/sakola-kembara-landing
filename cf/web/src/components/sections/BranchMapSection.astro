---
import { BRANCH_MAP } from '~/lib/branch-map';
import { branches } from '~/lib/site';

/**
 * Homepage branch map (SAKEM-111; reshaped by Dzul on 2026-10-27 after his own mock, drawn after the dotted office map
 * of Global DMC): one screen tall on navy mist, no card: Indonesia as a large dotted map placed so the branches
 * (west Java to east Kalimantan) sit in the middle of the section, running off the edges, and the title "Kami hadir
 * dari Bandung sampai Samarinda" at the left, vertically centred, in the empty space under Sumatra (on top below lg). A pulsing point per branch of
 * `branches`, a small chip naming each (the five around Bandung in a column to their left, joined by thin lines), and
 * solid arcs from Bandung to the branches further out, drawn in as the map scrolls up (CSS scroll-driven behind
 * @supports; whole with reduced motion or without support). The names are also in a list for screen readers. The dots
 * and the points are generated by scripts/gen-branch-map.mjs.
 */
const { width, height, dots, points } = BRANCH_MAP;
const pct = ([x, y]: [number, number]) => `left:${((x / width) * 100).toFixed(2)}%;top:${((y / height) * 100).toFixed(2)}%`;
const from = points.Bandung;
// Arcs from Bandung, lifted in proportion to their length.
const arc = (to: [number, number]) => {
  const lift = Math.max(3, Math.hypot(to[0] - from[0], to[1] - from[1]) * 0.25);
  return `M ${from[0]} ${from[1]} Q ${((from[0] + to[0]) / 2).toFixed(2)} ${(Math.min(from[1], to[1]) - lift).toFixed(2)} ${to[0]} ${to[1]}`;
};
const arcs = ['Cirebon', 'Purbalingga', 'Samarinda'].map((name) => arc(points[name]));
// A chip per branch. The five branches around Bandung sit a few pixels apart, so their chips stand in a column to the
// left of them (in canvas units, top to bottom in the order of the points), each joined to its point by a thin line;
// the others sit right above or beside their point.
const CLUSTER = ['Bojong', 'Cibodas', 'Cisarua', 'Bandung', 'Cililin'];
const COLUMN_X = points.Bandung[0] - 9.3;
const COLUMN_STEP = 4.8;
const columnTop = points.Cisarua[1] - COLUMN_STEP * 2;
const chips = [
  ...CLUSTER.map((name, i) => ({ name, at: [COLUMN_X, columnTop + COLUMN_STEP * i] as [number, number], side: 'left' as const })),
  { name: 'Cirebon', at: points.Cirebon, side: 'above' as const },
  { name: 'Purbalingga', at: points.Purbalingga, side: 'below' as const },
  { name: 'Samarinda', at: points.Samarinda, side: 'above' as const },
];
const chipShift = {
  left: '-translate-x-full -translate-y-1/2',
  above: '-translate-x-1/2 -translate-y-[calc(100%+10px)]',
  below: '-translate-x-1/2 translate-y-[10px]',
};
const names = branches.map((b) => b.name).join(', ');
---

<section id="cabang" class="relative flex min-h-[100svh] flex-col gap-10 overflow-hidden bg-[#EEF1F6] px-6 py-20 text-primary-blue-dark md:px-10 md:py-24 lg:py-28">
  <h2 class="relative z-10 font-body lg:my-auto text-[clamp(32px,3.9vw,56px)] font-medium leading-[1.15] tracking-[-0.025em] anim-reveal">
    Kami hadir <br />dari Bandung <br />sampai Samarinda
  </h2>

  <div class="w-[135%] max-w-none self-start lg:absolute lg:left-[24%] lg:top-[50%] lg:w-[130%] lg:-translate-y-[75%]">
    <div class="relative w-full" style={`aspect-ratio:${width}/${height}`}>
      <img src={dots} alt="" width={width} height={height} loading="lazy" decoding="async" class="absolute inset-0 h-full w-full select-none" />
      <svg viewBox={`0 0 ${width} ${height}`} role="img" aria-label={`Peta cabang Sakola Kembara: ${names}`} class="absolute inset-0 h-full w-full overflow-visible">
        {arcs.map((d) => <path d={d} pathLength="1" fill="none" stroke="#0D1F52" stroke-width="0.33" stroke-linecap="round" class="branch-arc" />)}
        {CLUSTER.map((name, i) => <line x1={COLUMN_X + 0.4} y1={columnTop + COLUMN_STEP * i} x2={points[name][0]} y2={points[name][1]} stroke="#0D1F52" stroke-opacity="0.35" stroke-width="0.13" />)}
        {
          branches.map((branch, i) => {
            const [x, y] = points[branch.name];
            return (
              <g data-branch={branch.name} class="branch-point">
                <circle cx={x} cy={y} r="1" fill="#FAD02B" class="branch-pulse" style={`animation-delay:${(i * 0.35).toFixed(2)}s`} />
                <circle cx={x} cy={y} r="0.8" fill="#0D1F52" stroke="#fff" stroke-width="0.3" class="branch-dot" />
              </g>
            );
          })
        }
      </svg>
      {
        chips.map(({ name, at, side }) => (
          <span
            aria-hidden="true"
            class:list={['pointer-events-none absolute whitespace-nowrap rounded-full border border-primary-blue-dark/10 bg-white px-2 py-0.5 text-[11px] font-semibold shadow-sm md:text-xs', chipShift[side]]}
            style={pct(at)}
          >
            {name}
          </span>
        ))
      }
    </div>

    <ul class="sr-only" aria-label="Cabang Sakola Kembara">
      {branches.map((b) => <li>{b.name}, {b.region}</li>)}
    </ul>
  </div>
</section>

<style>
  /* Each point pulses (a sunglow ring growing and fading), one after another; not with reduced motion. */
  .branch-pulse {
    transform-box: fill-box;
    transform-origin: center;
    opacity: 0;
  }
  @media (prefers-reduced-motion: no-preference) {
    .branch-pulse {
      animation: branch-pulse 2.4s ease-out infinite;
    }
  }
  @keyframes branch-pulse {
    0% {
      opacity: 0.8;
      transform: scale(1);
    }
    100% {
      opacity: 0;
      transform: scale(4);
    }
  }
  /* The arcs draw in from Bandung as the map scrolls up. */
  @supports (animation-timeline: view()) {
    @media (prefers-reduced-motion: no-preference) {
      [data-branch-map] {
        view-timeline-name: --branch-map;
      }
      .branch-arc {
        animation: branch-arc linear both;
        animation-timeline: --branch-map;
        animation-range: entry 20% cover 45%;
      }
    }
  }
  @keyframes branch-arc {
    from {
      clip-path: inset(0 100% 0 0);
    }
  }
</style>
