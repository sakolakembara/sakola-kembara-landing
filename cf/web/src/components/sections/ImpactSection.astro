---
import { impactMetrics } from '~/lib/home-data';
import { buttonClasses } from '~/lib/ui';

/**
 * Homepage impact (SAKEM-111; layout after BYQ Babka "Animated Bar Chart Stats"):
 * the title on the left, the four metrics of impactMetrics as cards that rise
 * from left to right, the total last and tallest. Figures and labels are
 * verbatim from home-data.ts. From md the heights encode the order; below md
 * the cards sit in a 2x2 grid of equal height. Title and cards share a row
 * from xl only: below 1280 px the cards' labels would break into many lines.
 */
const cards = [
  { metric: impactMetrics[3], tone: 'bg-[#E9EDF4] text-primary-blue-dark', height: 'md:h-[300px]' },
  { metric: impactMetrics[2], tone: 'bg-[#EFE7D6] text-primary-blue-dark', height: 'md:h-[360px]' },
  { metric: impactMetrics[1], tone: 'bg-secondary-yellow text-primary-blue-dark', height: 'md:h-[420px]' },
  { metric: impactMetrics[0], tone: 'bg-primary-blue-dark text-white', height: 'md:h-[480px]' },
];
---

<section id="impact" class="px-6 py-20 md:px-10 md:py-28">
  <div class="grid w-full items-end gap-12 xl:grid-cols-[minmax(0,0.75fr)_minmax(0,1.6fr)] xl:gap-16">
    <div class="flex flex-col gap-6 anim-reveal">
      <h2 class="font-display text-[clamp(34px,3.8vw,52px)] font-medium leading-[1.08] tracking-[-0.03em] text-primary-blue-dark">
        Pencapaian Sakola Kembara
      </h2>
      <p class="max-w-[26em] text-[17px] leading-[1.65] text-gray-600">
        Setiap angka di sini mewakili mimpi yang terwujud dan kehidupan yang berubah melalui pendidikan.
      </p>
      <a href="#cerita" class={buttonClasses({ variant: 'outline-navy', className: 'self-start' })}>Cerita Sukses Alumni</a>
    </div>

    <ul class="grid grid-cols-2 items-end gap-3 md:grid-cols-4">
      {
        cards.map(({ metric, tone, height }, index) => (
          <li
            class:list={['flex min-h-[200px] flex-col justify-between gap-6 rounded-[20px] p-5 md:p-6 anim-reveal', tone, height]}
            style={`--i:${index}`}
          >
            <span class="font-display text-[clamp(40px,4.2vw,64px)] font-medium leading-none tracking-[-0.03em]">{metric.number}</span>
            <span class="text-[15px] leading-snug opacity-85">{metric.label}</span>
          </li>
        ))
      }
    </ul>
  </div>
</section>
