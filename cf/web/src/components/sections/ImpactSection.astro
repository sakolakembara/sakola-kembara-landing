---
import Img from '~/components/Img.astro';
import { impactMetrics } from '~/lib/home-data';
import { buttonClasses } from '~/lib/ui';

/**
 * Homepage impact "Dari Desa ke Kampus Impian" (SAKEM-111; option C of the Pencapaian wireframe Dzul chose on
 * 2026-10-27, after BYQ Nextwell "Stats Section with Animated Counters"): one screen tall, a documentation photo
 * under a navy gradient, the title top left, the lead and "Cerita Sukses Alumni" top right, and the four metrics of impactMetrics in a
 * row along the bottom; the top-3 figure carries the three universities' logos. It follows "Mengapa
 * Kami Ada?" (Dzul swapped the two the same day). Figures and labels are verbatim from home-data.ts; the title was
 * "Pencapaian Sakola Kembara". The photo (students in their campus jackets, from the foundation's documentation Drive) is
 * decorative.
 */
// The three universities of the top-3 figure, their logos from the universities' own sites (UI, UGM) and the partner set (ITB).
const universities = [
  { name: 'Universitas Indonesia', logo: '/images/universitas/ui.png' },
  { name: 'Institut Teknologi Bandung', logo: '/images/partners/itb.png' },
  { name: 'Universitas Gadjah Mada', logo: '/images/universitas/ugm.png' },
];
const stats = [
  { metric: impactMetrics[0] },
  { metric: impactMetrics[1] },
  { metric: impactMetrics[2], logos: true },
  { metric: impactMetrics[3] },
];
---

<section id="impact" class="relative isolate flex min-h-[100svh] flex-col justify-between gap-14 overflow-hidden bg-primary-blue-dark px-6 py-20 text-white md:px-10 md:py-24">
  <Img src="/images/home/impact-kampus.jpg" alt="" sizes="100vw" class="absolute inset-0 -z-20 h-full w-full object-cover object-[50%_60%]" />
  <span aria-hidden="true" class="absolute inset-0 -z-10 bg-[linear-gradient(180deg,rgba(13,31,82,0.6)_0%,rgba(13,31,82,0.75)_45%,rgba(13,31,82,0.95)_100%)]" />

  <div class="grid items-start gap-6 md:grid-cols-2 md:gap-12 anim-reveal">
    <h2 class="font-body text-[clamp(32px,3.9vw,56px)] font-medium leading-[1.15] tracking-[-0.025em]">Dari Desa <br />ke Kampus Impian</h2>
    <div class="flex flex-col gap-6 md:items-end md:pt-3 md:text-right">
      <p class="max-w-[30em] text-[17px] leading-[1.65] text-white/85 md:text-lg">
        Setiap angka di sini mewakili mimpi yang terwujud dan kehidupan yang berubah melalui pendidikan.
      </p>
      <a href="#cerita" class={buttonClasses({ variant: 'outline-on-navy', className: 'self-start md:self-end' })}>Cerita Sukses Alumni</a>
    </div>
  </div>

  <ul class="grid grid-cols-2 gap-x-6 gap-y-10 border-t border-white/25 pt-8 lg:grid-cols-4 lg:gap-x-10">
    {
      stats.map(({ metric, logos }, index) => (
        <li class="flex flex-col gap-4 anim-reveal" style={`--i:${index}`}>
          <span class="font-body text-[clamp(40px,4.4vw,72px)] font-medium leading-none tracking-[-0.03em] text-secondary-yellow">{metric.number}</span>
          <span class="max-w-[18em] text-[15px] leading-snug text-white/85 md:text-base">{metric.label}</span>
          {logos && (
            <span class="flex gap-2">
              {universities.map((u) => (
                <span class="flex size-11 items-center justify-center rounded-full bg-white p-1.5" title={u.name}>
                  <Img src={u.logo} alt={u.name} sizes="44px" class="h-full w-full object-contain" />
                </span>
              ))}
            </span>
          )}
        </li>
      ))
    }
  </ul>
</section>
