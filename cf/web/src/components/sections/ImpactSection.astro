---
import Img from '~/components/Img.astro';
import { impactMetrics } from '~/lib/home-data';
import { buttonClasses } from '~/lib/ui';

/**
 * Homepage impact (SAKEM-111, design "Opsi C"): one large figure told with two
 * photos. The other three metrics are read inside the sentence, so every figure
 * of impactMetrics is still on the page, value for value.
 */
const [total, college, top3, current] = impactMetrics;
const strong = 'font-semibold text-primary-blue-dark';
---

<section id="impact" class="px-6 pt-20 pb-16 md:pt-28 md:pb-24">
  <div class="mx-auto grid max-w-[1280px] items-end gap-6 md:grid-cols-[1.1fr_1fr_1fr]">
    <div class="flex flex-col gap-[18px] md:pr-6 anim-reveal">
      <p class="font-display text-[clamp(88px,11vw,152px)] leading-[0.85] tracking-[-0.05em] text-primary-blue-dark">{total.number}</p>
      <h2 class="text-[26px] font-bold text-gray-800">{total.label}</h2>
      <p class="max-w-[28em] text-[17px] leading-[1.65] text-gray-600">
        Setiap angka di sini mewakili mimpi yang terwujud dan kehidupan yang berubah melalui pendidikan.
        <strong class={strong}>{college.number}</strong> berkuliah (60% di PTN), <strong class={strong}>{top3.number}</strong> siswa
        diterima di Top 3 Universitas di Indonesia, dan <strong class={strong}>{current.number}</strong> siswa di Program 2026/2027.
      </p>
      <a href="#cerita" class={buttonClasses({ variant: 'outline-navy', className: 'self-start' })}>
        Cerita Sukses Alumni
      </a>
    </div>
    <Img
      src="/images/program/pembinaan.jpg"
      alt="Siswa belajar di kelas pembinaan"
      sizes="(min-width: 768px) 30vw, 100vw"
      class="aspect-square w-full rounded-[20px] object-cover anim-reveal"
      style="--i:1"
    />
    <Img
      src="/images/program/pasca-pembinaan.jpg"
      alt="Alumni Sakola Kembara"
      sizes="(min-width: 768px) 30vw, 100vw"
      class="aspect-[3/4] w-full rounded-[20px] object-cover anim-reveal"
      style="--i:2"
    />
  </div>
</section>
