---
import { Image } from 'astro:assets';
import itbLogo from '@root/public/images/partners/itb.png';
import itcLogo from '@root/public/images/partners/itc.png';
import rumahAmalSalmanLogo from '@root/public/images/partners/rumah-amal-salman.png';
import salamSetaraLogo from '@root/public/images/partners/salam-setara.png';
import talentsMappingLogo from '@root/public/images/partners/talents-mapping.png';
import zurichSyariahLogo from '@root/public/images/partners/zurich-syariah.png';
import { activePartners, pastPartners, type Partner } from '~/lib/home-data';

/**
 * Homepage "Partner Kami" (SAKEM-111; layout after BYQ Genesis "Trusted Logo
 * Grid"): the title left and the thanks right above a rule, then the logos in
 * a quiet grid, muted until hovered; each logo's alt is the partner's name,
 * and the past partner carries its group's label as a caption. Split
 * into active and past partners so visitors can tell who we work with right now
 * from who has supported us before. Copy is verbatim from the root
 * PartnersSection.tsx + lib/data.ts; logos are resized at build time.
 */
const logos: Record<string, ImageMetadata> = {
  itb: itbLogo,
  'talents-mapping': talentsMappingLogo,
  'zurich-syariah': zurichSyariahLogo,
  'rumah-amal-salman': rumahAmalSalmanLogo,
  itc: itcLogo,
  'salam-setara': salamSetaraLogo,
};

const partners: { partner: Partner; caption: string | null }[] = [
  ...activePartners.map((partner) => ({ partner, caption: null })),
  ...pastPartners.map((partner) => ({ partner, caption: 'Pernah Didukung & Bermitra Dengan' })),
];
---

<section class="bg-white px-6 py-20 md:px-10 md:py-28" id="partners">
  <div class="flex w-full flex-col gap-12 md:gap-16">
    <div class="grid items-start gap-6 border-b border-gray-200 pb-12 md:grid-cols-2 md:pb-16 anim-reveal">
      <h2 class="max-w-[14em] font-display text-[clamp(34px,3.8vw,52px)] font-medium leading-[1.08] tracking-[-0.03em] text-primary-blue-dark">
        Bersama Mewujudkan Perubahan
      </h2>
      <p class="max-w-[30em] text-[17px] leading-[1.65] text-gray-600 md:justify-self-end">
        Terima kasih kepada semua partner yang telah mendukung misi kami untuk pendidikan yang setara.
      </p>
    </div>

    <ul class="grid grid-cols-2 gap-x-6 gap-y-12 md:grid-cols-3 anim-reveal">
      {
        partners.map(({ partner, caption }) => (
          <li class="flex flex-col items-center justify-center gap-3 text-center">
            <Image
              src={logos[partner.id]}
              alt={partner.name}
              width={360}
              widths={[180, 360]}
              sizes="180px"
              format="webp"
              quality={80}
              loading="lazy"
              decoding="async"
              class="h-14 w-auto max-w-[180px] object-contain opacity-70 grayscale transition duration-300 hover:opacity-100 hover:grayscale-0 md:h-16"
            />
            {caption && <span class="text-xs text-gray-500">{caption}</span>}
          </li>
        ))
      }
    </ul>
  </div>
</section>
