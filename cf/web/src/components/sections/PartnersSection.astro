---
import { Image } from 'astro:assets';
import itbLogo from '@root/public/images/partners/itb.png';
import itcLogo from '@root/public/images/partners/itc.png';
import rumahAmalSalmanLogo from '@root/public/images/partners/rumah-amal-salman.png';
import salamSetaraLogo from '@root/public/images/partners/salam-setara.png';
import talentsMappingLogo from '@root/public/images/partners/talents-mapping.png';
import zurichSyariahLogo from '@root/public/images/partners/zurich-syariah.png';
import { activePartners, pastPartners, type Partner } from '~/lib/home-data';

/**
 * Homepage "Partner Kami" (SAKEM-111; layout after BYQ ALL ABT "Selected
 * Clients"): the title and the thanks on the left, on the right one ruled
 * card per partner, its name on the left and its logo on the right, split
 * into active and past partners so visitors can tell who we work with right now
 * from who has supported us before. Copy is verbatim from the root
 * PartnersSection.tsx + lib/data.ts; logos are resized at build time.
 */
const logos: Record<string, ImageMetadata> = {
  itb: itbLogo,
  'talents-mapping': talentsMappingLogo,
  'zurich-syariah': zurichSyariahLogo,
  'rumah-amal-salman': rumahAmalSalmanLogo,
  itc: itcLogo,
  'salam-setara': salamSetaraLogo,
};

const groups: { title: string; partners: Partner[] }[] = [
  { title: 'Partner & Pendukung Aktif', partners: activePartners },
  { title: 'Pernah Didukung & Bermitra Dengan', partners: pastPartners },
].filter((group) => group.partners.length > 0);
---

<section class="bg-white px-6 py-20 md:px-10 md:py-28" id="partners">
  <div class="mx-auto grid max-w-[1440px] gap-12 lg:grid-cols-[minmax(0,5fr)_minmax(0,7fr)] lg:gap-20">
    <div class="flex flex-col gap-5 lg:sticky lg:top-28 lg:self-start anim-reveal">
      <h2 class="font-display text-[clamp(34px,3.8vw,52px)] font-medium leading-[1.08] tracking-[-0.03em] text-primary-blue-dark">
        Bersama Mewujudkan Perubahan
      </h2>
      <p class="max-w-[26em] text-[17px] leading-[1.65] text-gray-600">
        Terima kasih kepada semua partner yang telah mendukung misi kami untuk pendidikan yang setara.
      </p>
    </div>

    <div class="flex flex-col gap-10">
      {
        groups.map((group) => (
          <div class="flex flex-col gap-4 anim-reveal">
            <h3 class="text-sm font-semibold text-gray-600">{group.title}</h3>
            <ul class="flex flex-col gap-3">
              {group.partners.map((partner) => (
                <li class="flex min-h-24 items-center justify-between gap-6 rounded-[14px] border border-gray-300 px-5 py-4 transition-colors hover:border-primary-blue-dark md:px-7">
                  <span class="text-[15px] font-medium leading-snug text-gray-800">{partner.name}</span>
                  {/* Decorative: the partner's name is spelled out on the left. */}
                  <Image
                    src={logos[partner.id]}
                    alt=""
                    width={320}
                    widths={[160, 320]}
                    sizes="160px"
                    format="webp"
                    quality={80}
                    loading="lazy"
                    decoding="async"
                    class="h-12 w-auto max-w-[160px] shrink-0 object-contain"
                  />
                </li>
              ))}
            </ul>
          </div>
        ))
      }
    </div>
  </div>
</section>
