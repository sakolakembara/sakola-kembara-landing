---
import { Image } from 'astro:assets';
import itbLogo from '@root/public/images/partners/itb.png';
import itcLogo from '@root/public/images/partners/itc.png';
import rumahAmalSalmanLogo from '@root/public/images/partners/rumah-amal-salman.png';
import salamSetaraLogo from '@root/public/images/partners/salam-setara.png';
import talentsMappingLogo from '@root/public/images/partners/talents-mapping.png';
import zurichSyariahLogo from '@root/public/images/partners/zurich-syariah.png';
import { activePartners, pastPartners, type Partner } from '~/lib/home-data';

/**
 * Homepage "Partner Kami" (restyled for SAKEM-111, design "Opsi C": a Lora
 * title, no eyebrow): a row of logo cards under its own subheading, split
 * into active and past partners so visitors can tell who we work with right now
 * from who has supported us before. Copy is verbatim from the root
 * PartnersSection.tsx + lib/data.ts; logos are resized at build time.
 */
const logos: Record<string, ImageMetadata> = {
  itb: itbLogo,
  'talents-mapping': talentsMappingLogo,
  'zurich-syariah': zurichSyariahLogo,
  'rumah-amal-salman': rumahAmalSalmanLogo,
  itc: itcLogo,
  'salam-setara': salamSetaraLogo,
};

const groups: { title: string; partners: Partner[] }[] = [
  { title: 'Partner & Pendukung Aktif', partners: activePartners },
  { title: 'Pernah Didukung & Bermitra Dengan', partners: pastPartners },
].filter((group) => group.partners.length > 0);
---

<section class="bg-white px-6 py-20 md:py-28" id="partners">
  <div class="mx-auto max-w-[1280px]">
    <div class="mb-12 grid items-end gap-6 md:grid-cols-2 anim-reveal">
      <h2 class="font-display text-[clamp(34px,3.8vw,52px)] font-medium leading-[1.08] tracking-[-0.03em] text-primary-blue-dark">
        Bersama Mewujudkan Perubahan
      </h2>
      <p class="max-w-[30em] text-[17px] leading-[1.65] text-gray-600">
        Terima kasih kepada semua partner yang telah mendukung misi kami untuk pendidikan yang setara.
      </p>
    </div>

    <div class="space-y-12 md:space-y-14">
      {
        groups.map((group) => (
          <div class="anim-reveal">
            {/* Subheading with hairlines that shrink to nothing on narrow screens */}
            <div class="flex items-center gap-4 mb-6 md:mb-8">
              <span class="hidden sm:block h-px flex-1 bg-gray-200" aria-hidden="true" />
              <h3 class="text-sm font-semibold text-gray-600 text-center">
                {group.title}
              </h3>
              <span class="hidden sm:block h-px flex-1 bg-gray-200" aria-hidden="true" />
            </div>

            {/* items-stretch keeps every card the same height even when a partner name wraps to two or three lines. */}
            <ul class="flex justify-center items-stretch flex-wrap gap-4 sm:gap-6 md:gap-8">
              {group.partners.map((partner) => (
                <li class="w-[136px] sm:w-40 bg-[#FAFAF7] rounded-[14px] border border-gray-200 flex flex-col items-center gap-2.5 px-3 py-4 hover:border-primary-blue/40 hover:shadow-md transition-all">
                  <div class="h-11 sm:h-12 flex items-center justify-center">
                    {/* Decorative: the partner name is spelled out right below, so announcing it twice would only add noise for screen readers. */}
                    <Image
                      src={logos[partner.id]}
                      alt=""
                      width={272}
                      widths={[136, 272]}
                      sizes="136px"
                      format="webp"
                      quality={80}
                      loading="lazy"
                      decoding="async"
                      class="max-h-full w-auto object-contain"
                    />
                  </div>
                  <span class="mt-auto text-[11px] sm:text-xs text-gray-700 font-medium text-center leading-snug text-balance">
                    {partner.name}
                  </span>
                </li>
              ))}
            </ul>
          </div>
        ))
      }
    </div>
  </div>
</section>
