---
import Button from '~/components/Button.astro';
import Tag from '~/components/Tag.astro';
import type { BlogMeta } from '~/lib/blog-types';

/**
 * Homepage "Cerita & Inspirasi" (restyled for SAKEM-111, design "Opsi C"): the
 * newest articles, as the root NewsSection
 * does. The caller passes them (the home page takes the three newest from the
 * blog index at build time). A cover is optional: dashboard-authored posts can
 * have none, and then the card shows no <img> at all rather than an empty src.
 * Cover files are the blog's own /blog/images/*; the metadata index carries their
 * size and WebP srcset from the asset pipeline.
 */
interface Props {
  articles: BlogMeta[];
}
const { articles } = Astro.props;
---

<section class="px-6 py-20 md:py-28" id="blog">
  <div class="mx-auto max-w-[1280px]">
    <div class="flex flex-col sm:flex-row sm:justify-between sm:items-end gap-4 mb-10 anim-reveal">
      <h2 class="font-display text-[clamp(34px,3.8vw,52px)] font-medium leading-[1.08] tracking-[-0.03em] text-primary-blue-dark">
        Cerita &amp; Inspirasi
      </h2>
      <Button href="/blog" variant="outline-navy" class="self-start sm:self-auto">Lihat Semua</Button>
    </div>

    {/* Compact article list */}
    <div class="grid md:grid-cols-3 gap-6">
      {
        articles.map((article, index) => (
          <article class="anim-reveal" style={`--i:${index}`}>
            <a
              href={`/blog/${article.id}`}
              class="group block"
            >
              <div class="aspect-[4/3] relative overflow-hidden rounded-[20px] bg-gray-100">
                {article.image && (
                  <img
                    src={article.image}
                    srcset={article.imageSrcset ?? undefined}
                    sizes="(min-width: 1280px) 410px, (min-width: 768px) 33vw, 100vw"
                    alt={article.title}
                    width={article.imageWidth ?? undefined}
                    height={article.imageHeight ?? undefined}
                    loading="lazy"
                    decoding="async"
                    class="absolute inset-0 h-full w-full object-cover group-hover:scale-105 transition-transform duration-300"
                  />
                )}
                <Tag size="sm" class="absolute top-3 left-3">
                  {article.category}
                </Tag>
              </div>
              <div class="pt-4">
                <p class="text-sm text-gray-500 mb-1.5">{article.date}</p>
                <h3 class="text-lg font-semibold text-gray-800 leading-snug line-clamp-2 group-hover:text-primary-blue-dark transition-colors">
                  {article.title}
                </h3>
              </div>
            </a>
          </article>
        ))
      }
    </div>
  </div>
</section>
