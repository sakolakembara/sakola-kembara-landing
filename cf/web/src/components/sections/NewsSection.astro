---
import Button from '~/components/Button.astro';
import type { BlogMeta } from '~/lib/blog-types';

/**
 * Homepage "Cerita & Inspirasi" (SAKEM-111; after BYQ Jake Carter "Blog Posts
 * Grid Layout", header after Babka "Blog Card Grid with Hover"): a navy band,
 * the title left and "Lihat Semua" right, then the articles in ONE row of up to
 * four (Dzul, 2026-10-27): the cover in a tilted polaroid frame (after BYQ Hollow "Yoga Gallery Marquee Section";
 * it straightens and lifts on hover) with the category (left) and the date (right) as chips on it, then the title.
 * The caller passes the articles (the home page takes the
 * four newest from the blog index at build time). A cover is optional: dashboard-authored posts can
 * have none, and then the card shows no <img> at all rather than an empty src.
 * Cover files are the blog's own /blog/images/*; the metadata index carries their
 * size and WebP srcset from the asset pipeline.
 */
interface Props {
  articles: BlogMeta[];
}
const { articles } = Astro.props;
// A polaroid tilt per card, in order: playful but readable (Dzul, 2026-10-27).
const tilts = [-1.2, 0.8, -0.6, 1];
---

<section class="bg-primary-blue-dark px-6 py-20 text-white md:px-10 md:py-28" id="blog">
  <div class="flex w-full flex-col gap-10 md:gap-14">
    <div class="flex flex-wrap items-end justify-between gap-6 anim-reveal">
      <h2 class="font-body text-[clamp(36px,4.4vw,66px)] font-medium leading-[1.1] tracking-[-0.025em]">Cerita &amp; Inspirasi</h2>
      <Button href="/blog" variant="outline-on-navy">Lihat Semua</Button>
    </div>

    <div class="grid gap-x-5 gap-y-10 sm:grid-cols-2 lg:grid-cols-4">
      {
        articles.map((article, index) => (
          <article class="anim-reveal" style={`--i:${index % 4}`}>
            <a href={`/blog/${article.id}`} class="group flex h-full flex-col gap-6">
              <div
                class="rounded-[4px] bg-[#FBFBF5] p-1.5 pb-6 shadow-[0_18px_40px_-12px_rgba(0,0,0,0.55)] transition-transform duration-300 ease-out [transform:rotate(var(--tilt))] group-hover:[transform:rotate(0deg)_translateY(-6px)] motion-reduce:transition-none md:p-2 md:pb-7"
                style={`--tilt:${tilts[index % tilts.length]}deg`}
              >
                <div class="relative aspect-[4/3] overflow-hidden rounded-[3px] bg-primary-blue-dark/10">
                  {article.image && (
                    <img
                      src={article.image}
                      srcset={article.imageSrcset ?? undefined}
                      sizes="(min-width: 1024px) 25vw, (min-width: 640px) 50vw, 100vw"
                      alt={article.title}
                      width={article.imageWidth ?? undefined}
                      height={article.imageHeight ?? undefined}
                      loading="lazy"
                      decoding="async"
                      class="absolute inset-0 h-full w-full object-cover transition-transform duration-500 group-hover:scale-[1.04] motion-reduce:transition-none"
                    />
                  )}
                  <p class="absolute inset-x-3 top-3 flex items-start justify-between gap-1.5 text-xs font-semibold text-primary-blue-dark">
                    <span class="rounded-full bg-secondary-yellow px-2.5 py-1">{article.category}</span>
                    <span class="rounded-full bg-white/90 px-2.5 py-1">{article.date}</span>
                  </p>
                </div>
              </div>
              <h3 class="line-clamp-3 text-lg font-medium leading-snug transition-colors group-hover:text-secondary-yellow">{article.title}</h3>
            </a>
          </article>
        ))
      }
    </div>
  </div>
</section>
