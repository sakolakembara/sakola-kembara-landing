---
import { Image } from 'astro:assets';
import chintyaDwiAzizahPhoto from '@root/public/images/testimoni/chintya-dwi-azizah.jpg';
import daffaNajwanPhoto from '@root/public/images/testimoni/daffa-najwan.jpg';
import fathyaSahlaHumairaPhoto from '@root/public/images/testimoni/fathya-sahla-humaira.jpg';
import jesikaMarshaYoanikaPhoto from '@root/public/images/testimoni/jesika-marsha-yoanika.jpg';
import muhammadAnwarTaufikPhoto from '@root/public/images/testimoni/muhammad-anwar-taufik.jpg';
import natiaNurFazaPhoto from '@root/public/images/testimoni/natia-nur-faza.jpg';
import syahidFattahulIhsanPhoto from '@root/public/images/testimoni/syahid-fattahul-ihsan.jpg';
import Icon from '~/components/Icon.astro';
import { testimonials } from '~/lib/home-data';

/**
 * Alumni testimonial carousel: a scroll-snap row (two cards at a time from md,
 * one below), so touch, trackpad and keyboard scrolling work with no JS at all.
 * The script below adds what CSS cannot: the previous/next buttons (wrapping
 * around like the Next version) and the dots. Until it runs those controls are
 * `hidden`, so there is never a dead button. The track is a focusable region, so
 * the arrow keys scroll it for keyboard users. Copy is verbatim from the root
 * ImpactSection.tsx + lib/data.ts.
 */
const photos: Record<number, ImageMetadata> = {
  1: daffaNajwanPhoto,
  2: natiaNurFazaPhoto,
  3: chintyaDwiAzizahPhoto,
  4: syahidFattahulIhsanPhoto,
  5: muhammadAnwarTaufikPhoto,
  6: jesikaMarshaYoanikaPhoto,
  7: fathyaSahlaHumairaPhoto,
};

const arrow =
  'items-center justify-center rounded-full bg-white border border-gray-200 text-gray-600 hover:border-primary-blue hover:text-primary-blue transition-colors';
---

<div class="relative" data-carousel>
  <button
    type="button"
    hidden
    data-carousel-ui
    data-carousel-prev
    aria-label="Testimoni sebelumnya"
    class={`hidden sm:flex absolute top-1/2 -translate-y-1/2 left-2 md:-left-5 z-20 w-11 h-11 shadow-lg hover:scale-105 transition-all ${arrow}`}
  >
    <Icon name="chevron-left" size={22} />
  </button>
  <button
    type="button"
    hidden
    data-carousel-ui
    data-carousel-next
    aria-label="Testimoni berikutnya"
    class={`hidden sm:flex absolute top-1/2 -translate-y-1/2 right-2 md:-right-5 z-20 w-11 h-11 shadow-lg hover:scale-105 transition-all ${arrow}`}
  >
    <Icon name="chevron-right" size={22} />
  </button>

  <div
    role="region"
    aria-roledescription="carousel"
    aria-label="Cerita Sukses Alumni"
    tabindex="0"
    data-carousel-track
    class="overflow-x-auto snap-x snap-mandatory scroll-smooth [scrollbar-width:none] [&::-webkit-scrollbar]:hidden"
  >
    <ul class="flex gap-5 md:gap-6">
      {
        testimonials.map((testimonial) => (
          <li class="snap-start shrink-0 basis-full md:basis-[calc((100%-1.5rem)/2)]">
            <div class="h-full bg-gray-50 rounded-2xl p-5 sm:p-8 flex flex-col sm:flex-row gap-4 sm:gap-6">
              <div class="w-full h-44 sm:w-32 sm:h-40 rounded-xl overflow-hidden flex-shrink-0 relative">
                <Image
                  src={photos[testimonial.id]}
                  alt={testimonial.name}
                  width={640}
                  widths={[256, 384, 640]}
                  sizes="(min-width: 640px) 128px, calc(100vw - 88px)"
                  format="webp"
                  quality={75}
                  loading="lazy"
                  decoding="async"
                  class="absolute inset-0 h-full w-full object-cover"
                />
              </div>
              <div class="flex-1 flex flex-col">
                <blockquote class="text-[15px] text-gray-700 italic leading-relaxed mb-4">
                  &ldquo;{testimonial.quote}&rdquo;
                </blockquote>
                {/* mt-auto pins attribution to the card's bottom so a short quote and a long one still line up. */}
                <div class="mt-auto">
                  <strong class="text-base text-gray-900">{testimonial.name}</strong>
                  <p class="text-sm text-primary-blue">{testimonial.major}</p>
                  <div class="inline-flex items-center gap-1.5 bg-white px-3 py-2 rounded-lg text-xs text-gray-600 mt-3 border border-gray-200">
                    <Icon name="graduation-cap" size={14} />
                    {testimonial.university}
                  </div>
                </div>
              </div>
            </div>
          </li>
        ))
      }
    </ul>
  </div>

  {/* Dots; on a phone the previous/next buttons sit on this row instead of over the cards. */}
  <div class="flex justify-center items-center gap-4 mt-8" data-carousel-ui hidden>
    <button
      type="button"
      data-carousel-prev
      aria-label="Testimoni sebelumnya"
      class={`sm:hidden w-10 h-10 shadow ${arrow}`}
    >
      <Icon name="chevron-left" size={20} />
    </button>
    <div class="flex justify-center gap-2">
      {
        testimonials.map((_, index) => (
          // The hit area is the pseudo-element, so the dot itself keeps its look.
          <button
            type="button"
            data-carousel-dot={index}
            aria-label={`Tampilkan testimoni ${index + 1}`}
            class="relative h-2.5 w-2.5 rounded-full bg-gray-300 hover:bg-gray-400 transition-all after:absolute after:-inset-2 after:content-[''] aria-[current=true]:w-8 aria-[current=true]:bg-primary-blue"
          />
        ))
      }
    </div>
    <button
      type="button"
      data-carousel-next
      aria-label="Testimoni berikutnya"
      class={`sm:hidden w-10 h-10 shadow ${arrow}`}
    >
      <Icon name="chevron-right" size={20} />
    </button>
  </div>
</div>

<script>
  // Carousel controls (about 1 KB). The scrolling itself is CSS scroll-snap; this only moves the
  // track one card at a time (wrapping around), keeps the dots in step and un-hides the controls.
  // `scrollTo` carries no `behavior`, so the CSS decides: smooth, and instant under
  // prefers-reduced-motion.
  for (const root of document.querySelectorAll<HTMLElement>('[data-carousel]')) {
    const track = root.querySelector<HTMLElement>('[data-carousel-track]')!;
    const cards = [...track.querySelectorAll<HTMLElement>(':scope > ul > li')];
    const dots = [...root.querySelectorAll<HTMLElement>('[data-carousel-dot]')];
    const left = (i: number) => cards[i].offsetLeft - cards[0].offsetLeft;
    const step = () => (cards.length > 1 ? left(1) : track.clientWidth);
    // The last index the track can reach: with two cards in view it is one short of the card count.
    const last = () => Math.max(0, Math.round((track.scrollWidth - track.clientWidth) / step()));
    const current = () => Math.min(last(), Math.round(track.scrollLeft / step()));
    const go = (i: number) => track.scrollTo({ left: left(i) });

    const sync = () => {
      const now = current();
      dots.forEach((dot, i) => {
        dot.hidden = i > last();
        dot.setAttribute('aria-current', String(i === now));
      });
    };

    root.addEventListener('click', (event) => {
      const button = (event.target as HTMLElement).closest<HTMLElement>('button');
      if (!button) return;
      if (button.hasAttribute('data-carousel-prev')) go(current() === 0 ? last() : current() - 1);
      else if (button.hasAttribute('data-carousel-next')) go(current() >= last() ? 0 : current() + 1);
      else if (button.dataset.carouselDot) go(Number(button.dataset.carouselDot));
    });

    let frame = 0;
    track.addEventListener('scroll', () => {
      cancelAnimationFrame(frame);
      frame = requestAnimationFrame(sync);
    }, { passive: true });
    window.addEventListener('resize', sync);

    root.querySelectorAll<HTMLElement>('[data-carousel-ui]').forEach((el) => (el.hidden = false));
    sync();
  }
</script>
