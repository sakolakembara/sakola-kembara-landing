---
import Button from '~/components/Button.astro';
import type { ProblemStat } from '~/lib/home-data';

/**
 * "Mengapa ini terjadi?" opens the longer explanation in a modal. A native
 * <dialog> opened with showModal() gives the focus trap, Escape to close and
 * focus return; the opener script lives in ProblemSection.astro. The detail
 * text is in the HTML, so crawlers and screen readers have it without a click.
 */
interface Props {
  id: string;
  stat: ProblemStat;
}
const { id, stat } = Astro.props;
---

<Button variant="outline-on-navy" class="self-start" aria-haspopup="dialog" data-dialog-open={id}>
  Mengapa ini terjadi?
</Button>
<dialog
  id={id}
  aria-labelledby={`${id}-title`}
  class="m-auto w-[calc(100%-2.5rem)] max-w-lg max-h-[calc(100dvh-2.5rem)] overflow-y-auto rounded-2xl border border-white/15 bg-accent-navy p-0 text-white shadow-2xl backdrop:bg-accent-navy/80 backdrop:backdrop-blur-sm"
>
  <div class="p-6 md:p-8">
    <div class="text-center mb-6">
      <div class="text-5xl font-extrabold text-secondary-yellow mb-2">{stat.number}</div>
      <p class="text-lg font-medium">{stat.text}</p>
    </div>
    <div class="border-t border-white/10 pt-6">
      <h2 id={`${id}-title`} class="text-secondary-yellow font-semibold mb-3">Mengapa ini terjadi?</h2>
      <p class="text-white/85 leading-relaxed text-sm">{stat.detail}</p>
    </div>
    <form method="dialog">
      <Button type="submit" variant="yellow-on-navy" fullWidth class="mt-6">Tutup</Button>
    </form>
  </div>
</dialog>
