---
import type { ProblemChart } from '~/lib/home-data';

/**
 * The infographic above a "Mengapa Kami Ada?" figure. `role="img"` plus the
 * chart's `label` is its text alternative (the figure and sentence next to it
 * stay as text too). Pure markup, no script.
 */
interface Props {
  chart: ProblemChart;
}
const { chart } = Astro.props;
const ratioMax = chart.kind === 'ratio' ? Math.max(...chart.bars.map((b) => b.value)) : 1;
---

<div role="img" aria-label={chart.label} class="h-[124px] flex">
  {
    chart.kind === 'pictogram' && (
      // One row; icons scale with the card (up to 28px) so ten always fit.
      <div class="self-center w-full grid grid-cols-10 gap-1.5">
        {Array.from({ length: chart.total }, (_, i) => {
          const filled = i < chart.highlighted;
          return (
            <svg
              viewBox="0 0 28 40"
              aria-hidden="true"
              class={`w-full h-auto max-w-7 ${filled ? 'text-secondary-yellow' : 'text-white/45'}`}
              fill={filled ? 'currentColor' : 'none'}
              stroke={filled ? 'none' : 'currentColor'}
              stroke-width="2"
            >
              <circle cx="14" cy="8" r="6" />
              <path d="M3 38V27a11 11 0 0 1 22 0v11Z" />
            </svg>
          );
        })}
      </div>
    )
  }

  {
    chart.kind === 'share' && (
      <div class="self-center w-full flex flex-col gap-3">
        <span class="text-xs font-semibold text-white/75">{chart.caption}</span>
        <div class="flex h-9 rounded-lg overflow-hidden">
          <div class="bg-secondary-yellow" style={`width:${chart.share * 100}%`} />
          <div class="flex-1 bg-white/20" />
        </div>
        <div class="flex flex-wrap gap-x-4 gap-y-1.5 text-xs text-white/80">
          <span class="inline-flex items-center gap-1.5">
            <span class="w-2.5 h-2.5 rounded-[3px] bg-secondary-yellow" />
            {chart.highlightLabel}
          </span>
          <span class="inline-flex items-center gap-1.5">
            <span class="w-2.5 h-2.5 rounded-[3px] bg-white/35" />
            {chart.restLabel}
          </span>
        </div>
      </div>
    )
  }

  {
    chart.kind === 'ratio' && (
      // Progress bars scaled to the largest value; the first (the advantaged group) is highlighted.
      <div class="self-center w-full grid grid-cols-[auto_1fr] items-center gap-x-3 gap-y-4">
        {chart.bars.map((bar, i) => (
          <>
            <span class="text-xs font-semibold text-white/80">{bar.name}</span>
            <div class="h-3 rounded-full bg-white/15 overflow-hidden">
              <div
                class={`h-full rounded-full ${i === 0 ? 'bg-secondary-yellow' : 'bg-white/45'}`}
                style={`width:${(bar.value / ratioMax) * 100}%`}
              />
            </div>
          </>
        ))}
      </div>
    )
  }
</div>
