---
import {
  REPORT_CATEGORY_LABEL,
  REPORT_CATEGORY_TONE,
  formatAcademicYear,
  formatBytes,
  type ReportsSectionData,
} from '~/lib/reports';
import { buttonClasses } from '~/lib/ui';
import { uploadUrl } from '~/lib/uploads';
import Heading from './Heading.astro';
import Icon from './Icon.astro';
import Tag from './Tag.astro';

/**
 * The Laporan section of /donasi (SAKEM-105, variant A): the page /laporan moved here, with the id `laporan` so that
 * `/donasi#laporan` (where /laporan now redirects, and the footer link goes) lands on it. The markup, the cards and
 * every string are the ones /laporan had (ported from app/(public)/laporan/); the old hero's title and lead are the
 * section's heading and lead. Since SAKEM-113 (round 4 of the inner-pages mock, Dzul 2026-10-28) the heading and lead
 * sit on the left with the empty or error state on the right, and the closing block ("Punya pertanyaan tentang laporan
 * kami?") is gone: the "Kontak Kami" just above on /donasi already asks it.
 *
 * The data is `loadReportsSection` (src/lib/reports.ts): `reports === null` is an API that cannot answer with
 * nothing cached, and the section says so while the page around it stays a 200; an empty list is the legacy empty
 * state, a normal answer.
 */
interface Props {
  section: ReportsSectionData;
  /** UPLOADS_BASE_URL: the files domain put in front of an uploaded PDF's path (src/lib/uploads.ts). */
  uploadsBase?: string;
}
const { section, uploadsBase } = Astro.props;
const { reports, years, total } = section;
---

<section id="laporan" class="scroll-mt-24 px-6 pb-24 md:px-10 md:pb-28" aria-labelledby="laporan-heading">
  <div class="grid items-start gap-10 md:grid-cols-2 md:gap-16">
    <div class="anim-reveal flex flex-col gap-5">
      <Heading level="section" as="h2" id="laporan-heading" class="text-primary-blue-dark">Laporan</Heading>
      <p class="max-w-[30em] text-[17px] leading-[1.65] text-gray-600 md:text-lg">
        Komitmen kami untuk transparansi. Laporan tahunan, keuangan, dampak, dan donasi tersedia untuk diunduh dan
        dipelajari oleh donor, mitra, dan publik.
      </p>
    </div>
    {
      reports === null ? (
        <div role="status" class="anim-reveal flex flex-col gap-2 border-y border-primary-blue-dark/20 py-7">
          <Heading level="card" as="h3" class="text-primary-blue-dark">Laporan belum dapat ditampilkan</Heading>
          <p class="text-base leading-[1.6] text-gray-600">
            Kami sedang mengalami kendala saat memuat daftar laporan. Silakan muat ulang halaman ini beberapa saat
            lagi.
          </p>
        </div>
      ) : total === 0 ? (
        <div class="anim-reveal flex flex-col gap-2 border-y border-primary-blue-dark/20 py-7">
          <Heading level="card" as="h3" class="text-primary-blue-dark">Laporan akan segera tersedia</Heading>
          <p class="text-base leading-[1.6] text-gray-600">
            Tim kami sedang menyiapkan laporan publik. Periksa kembali halaman ini dalam waktu dekat.
          </p>
        </div>
      ) : null
    }
  </div>

  {/* Reports listing, by academic year */}
  {
    reports !== null && total > 0 && (
      <div class="mt-14 space-y-12">
        {years.map(({ year, reports: list }) => (
          <section class="anim-reveal">
            <header class="mb-5 flex flex-wrap items-baseline gap-x-3 gap-y-1">
              <Heading level="subsection" as="h3" class="text-primary-blue-dark">
                {formatAcademicYear(year)}
              </Heading>
              <span class="text-sm text-gray-500">{list.length} laporan</span>
            </header>
            <div class="grid gap-5 md:grid-cols-2 lg:grid-cols-3">
              {list.map((r) => (
                <article class="flex flex-col rounded-xl bg-white p-6 shadow-[0_14px_30px_-18px_rgba(13,31,82,0.35)]">
                  <div class="mb-3 flex items-start justify-between gap-3">
                    <Tag tone={REPORT_CATEGORY_TONE[r.category]} size="sm">
                      {REPORT_CATEGORY_LABEL[r.category]}
                    </Tag>
                    <Icon name="file-text" size={20} class="shrink-0 text-primary-blue-dark/30" />
                  </div>
                  <h4 class="mb-2 text-lg font-semibold leading-snug text-primary-blue-dark">{r.title}</h4>
                  {r.description && <p class="mb-3 line-clamp-3 text-sm leading-relaxed text-gray-600">{r.description}</p>}
                  <div class="mb-4 text-xs text-gray-500">PDF · {formatBytes(r.fileSize)}</div>
                  {/* The path is the API's, used as it is (uploads are never proxied by this Worker). */}
                  <a href={uploadUrl(r.filePath, uploadsBase)} target="_blank" rel="noopener noreferrer" class={buttonClasses({ variant: 'outline-navy', className: 'mt-auto self-start' })}>
                    <Icon name="download" size={16} />
                    Unduh Laporan
                  </a>
                </article>
              ))}
            </div>
          </section>
        ))}
      </div>
    )
  }
</section>
