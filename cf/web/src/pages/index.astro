---
import ActivitiesSection from '~/components/sections/ActivitiesSection.astro';
import CTASection from '~/components/sections/CTASection.astro';
import HeroSection from '~/components/sections/HeroSection.astro';
import ImpactSection from '~/components/sections/ImpactSection.astro';
import NewsSection from '~/components/sections/NewsSection.astro';
import PartnersSection from '~/components/sections/PartnersSection.astro';
import ProblemSection from '~/components/sections/ProblemSection.astro';
import StoriesSection from '~/components/sections/StoriesSection.astro';
import Base from '~/layouts/Base.astro';
import { getAllArticles } from '~/lib/blog';
import '~/styles/reveal.css';

// Static at build time: served by the Workers assets layer, no Worker invocation.
// The "Cerita & Inspirasi" strip reads the blog index at build time, so a new
// article needs a rebuild (the same as the article pages themselves).
export const prerender = true;

const latestArticles = getAllArticles().slice(0, 4);
---

<Base seo={{ kind: 'home' }} navOverlay headingFont="jakarta">
  {/* SAKEM-111: design "Opsi C" in the BYQ "Sustainability Hub" system (one sans, no Lora): the hero video under a
      floating navbar, then the sections on a cream canvas. */}
  <main class="bg-[#FBFBF5]">
    <HeroSection />
    <ImpactSection />
    <ProblemSection />
    <ActivitiesSection />
    <StoriesSection />
    <PartnersSection />
    <NewsSection articles={latestArticles} />
    <CTASection />
  </main>
</Base>
