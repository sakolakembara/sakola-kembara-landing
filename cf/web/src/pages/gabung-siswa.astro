---
import Button from '~/components/Button.astro';
import Heading from '~/components/Heading.astro';
import Icon from '~/components/Icon.astro';
import Img from '~/components/Img.astro';
import SectionHeader from '~/components/SectionHeader.astro';
import Base from '~/layouts/Base.astro';
import { REGISTRATION_PATH } from '~/lib/site';
import { polaroidFrame, polaroidTilt } from '~/lib/ui';

export const prerender = true;

// Static at build time: served by the Workers assets layer, no Worker invocation. Ported from
// app/(public)/gabung-siswa/page.tsx and layout.tsx; the copy is verbatim. The pages it links to
// are plain links: "Daftar Sekarang" goes to /daftar (SAKEM-103, Phase A of the cutover: an admin
// shortlink that redirects to the registration form of the current cohort; the student portal at
// /portal is not live yet) and "Pusat Dokumen" to /gabung-siswa/docs.
//
// Layout (SAKEM-113, round 4 of the inner-pages mock approved by Dzul on 2026-10-28): the cream hero with two
// polaroids, the benefits as photo cards, the steps on navy with large sunglow numbers, and a sunglow closing band.

const benefits = [
  {
    photo: '/images/program/kbm-pekanan.jpg',
    title: 'Kurikulum Khusus',
    description:
      'Belajar dengan kurikulum yang dirancang khusus, menggabungkan materi SD–SMA agar bisa dikuasai dalam satu tahun pembelajaran intensif.',
  },
  {
    photo: '/images/program/mentoring.jpg',
    title: 'Mentoring Intensif',
    description:
      'Dapatkan pendampingan langsung dari mentor berpengalaman yang berasal dari berbagai universitas terbaik di Indonesia.',
  },
  {
    photo: '/images/program/asrama-intensif.jpg',
    title: 'Talents Mapping',
    description:
      'Bekerja sama dengan talentsmapping.id untuk membantu kamu memetakan bakat dan memilih jurusan yang paling sesuai.',
  },
  {
    photo: '/images/program/pasca-pembinaan.jpg',
    title: 'Pendampingan Beasiswa',
    description:
      'Setelah diterima di perguruan tinggi, kami dampingi proses pencarian beasiswa hingga kamu bisa memulai kuliah dengan tenang.',
  },
];

const flow = [
  {
    step: '01',
    title: 'Isi Formulir Pendaftaran',
    body: 'Lengkapi seluruh bagian formulir dengan jujur dan sesuai kenyataan.',
  },
  {
    step: '02',
    title: 'Verifikasi Berkas',
    body: 'Tim kesiswaan akan memverifikasi data dan berkas yang kamu kirim.',
  },
  {
    step: '03',
    title: 'Wawancara Lanjutan',
    body: 'Kandidat terpilih akan diundang untuk sesi wawancara singkat via daring.',
  },
  {
    step: '04',
    title: 'Pengumuman & Onboarding',
    body: 'Hasil seleksi diumumkan dan siswa terpilih memulai program bersama Gen 6.',
  },
];
---

<Base
  seo={{
    kind: 'page',
    title: 'Daftar Siswa',
    description:
      'Daftarkan diri sebagai siswa Sakola Kembara. Program bimbingan belajar gratis untuk persiapan UTBK dan masuk perguruan tinggi negeri bagi siswa dari keluarga kurang mampu di daerah terpencil.',
    path: '/gabung-siswa',
  }}
>
  <main class="min-h-screen bg-[#FBFBF5] text-primary-blue-dark">
    {/* Hero: title, lead and actions on the left, two polaroids on the right (below them on a phone). */}
    <section
      class="grid items-center gap-12 px-6 pb-20 pt-[calc(var(--hero-top,8rem)_+_2rem)] md:grid-cols-[1.05fr_0.95fr] md:gap-16 md:px-10 md:pb-28 md:pt-[calc(var(--hero-top,8rem)_+_4rem)]"
    >
      <div class="anim-fade-up flex flex-col items-start gap-6">
        {/* Hard-coded, as in the legacy page. SAKEM-059 decides which intake this names and where
            the text is edited; until then it is ported as it is. */}
        <span class="inline-block rounded-full border border-primary-blue-dark/25 px-3 py-1 text-xs font-semibold uppercase tracking-wider">
          Open Recruitment Gen 6
        </span>
        <Heading level="display" as="h1" class="text-balance">Wujudkan Mimpimu Bersama Sakola Kembara</Heading>
        <p class="max-w-[32em] text-[17px] leading-[1.65] text-gray-600 md:text-lg">
          Bergabunglah dengan ratusan siswa lain yang berhasil menembus perguruan tinggi terbaik di Indonesia
          melalui program pembinaan intensif gratis dari Sakola Kembara.
        </p>
        <div class="flex w-full flex-col flex-wrap items-stretch gap-3 sm:w-auto sm:flex-row sm:items-center">
          <Button href={REGISTRATION_PATH} variant="primary" size="lg" class="bg-primary-blue-dark px-6 hover:bg-primary-blue">
            <Icon name="clipboard-list" size={18} />
            Daftar Sekarang
          </Button>
          <Button href="#manfaat" variant="outline-navy" size="lg" class="px-6">Pelajari Program</Button>
          <a
            href="/gabung-siswa/docs"
            class="inline-flex items-center gap-2 px-2 py-3.5 font-semibold underline underline-offset-4 decoration-primary-blue-dark/40 hover:decoration-primary-blue-dark transition-colors"
          >
            <Icon name="folder-open" size={16} />
            Pusat Dokumen
          </a>
        </div>
      </div>
      <div class="anim-reveal relative mx-auto h-[300px] w-full max-w-[520px] sm:h-[420px] md:h-[520px]" aria-hidden="true">
        <span class:list={[polaroidFrame, 'absolute left-0 top-6 w-[60%] bg-white shadow-[0_24px_50px_-20px_rgba(13,31,82,0.55)] md:top-10']} style={polaroidTilt(0)}>
          <Img src="/images/program/prapembinaan.jpg" alt="" sizes="(min-width: 768px) 300px, 60vw" loading="eager" class="aspect-[4/5] w-full rounded-[3px] object-cover" />
        </span>
        <span class:list={[polaroidFrame, 'absolute right-0 top-0 w-[55%] bg-white shadow-[0_24px_50px_-20px_rgba(13,31,82,0.55)]']} style={polaroidTilt(3)}>
          <Img src="/images/program/pembinaan.jpg" alt="" sizes="(min-width: 768px) 280px, 55vw" loading="eager" class="aspect-[4/5] w-full rounded-[3px] object-cover" />
        </span>
      </div>
    </section>

    {/* Benefits: photo cards, the number and title on the photo, the description under it.
        A row that scrolls sideways on a phone, two columns from sm, four from lg. */}
    <section id="manfaat" class="scroll-mt-24 px-6 pb-28 md:px-10 md:pb-32">
      <div class="anim-reveal mb-12 md:mb-14">
        <SectionHeader
          align="left"
          title="Manfaat Bergabung dengan Sakola Kembara"
          lead="Bukan hanya bimbingan belajar. Kami menyiapkan kamu untuk sukses di perguruan tinggi dan kehidupan setelahnya."
        />
      </div>
      <div class="-mx-6 flex snap-x snap-mandatory scroll-px-6 gap-4 overflow-x-auto px-6 pb-2 sm:mx-0 sm:grid sm:grid-cols-2 sm:gap-6 sm:overflow-visible sm:px-0 lg:grid-cols-4">
        {
          benefits.map((benefit, index) => (
            <article class="anim-reveal flex w-[78%] shrink-0 snap-start flex-col gap-4 sm:w-auto" style={`--i:${index}`}>
              <div class="relative aspect-[4/5] overflow-hidden rounded-xl text-white">
                <Img
                  src={benefit.photo}
                  alt=""
                  sizes="(min-width: 1024px) 25vw, (min-width: 640px) 50vw, 78vw"
                  class="absolute inset-0 h-full w-full object-cover"
                />
                <span class="absolute inset-0 bg-gradient-to-b from-transparent from-50% to-primary-blue-dark/85" aria-hidden="true"></span>
                <span class="absolute left-4 top-4 rounded-full bg-secondary-yellow px-2.5 py-1 text-[13px] font-semibold text-primary-blue-dark" aria-hidden="true">
                  {String(index + 1).padStart(2, '0')}
                </span>
                <Heading level="card" as="h3" class="absolute inset-x-5 bottom-4 text-[22px] text-white md:text-2xl">
                  {benefit.title}
                </Heading>
              </div>
              <p class="text-[15px] leading-[1.6] text-gray-600">{benefit.description}</p>
            </article>
          ))
        }
      </div>
    </section>

    {/* Flow: navy, the steps in four columns with large sunglow numbers (a number beside each step on a phone). */}
    <section class="bg-primary-blue-dark px-6 py-24 text-white md:px-10 md:py-32">
      <div class="anim-reveal mb-14 md:mb-[4.5rem]">
        <SectionHeader
          align="left"
          tone="dark"
          title="Alur Pendaftaran"
          lead="Empat langkah singkat dari pendaftaran sampai kamu resmi menjadi bagian dari Sakola Kembara Gen 6."
        />
      </div>
      <ol class="grid gap-0 sm:grid-cols-2 sm:gap-10 lg:grid-cols-4">
        {
          flow.map((f, i) => (
            <li
              class="anim-reveal grid grid-cols-[4.5rem_1fr] gap-3 border-t border-white/25 py-6 sm:flex sm:flex-col sm:gap-4 sm:py-0 sm:pt-7"
              style={`--i:${i}`}
            >
              <span class="text-5xl font-medium leading-[0.85] tracking-[-0.04em] text-secondary-yellow sm:text-[clamp(64px,7vw,96px)]">
                {f.step}
              </span>
              <div class="flex flex-col gap-2 sm:mt-3 sm:gap-4">
                <h3 class="text-[19px] font-medium sm:text-2xl">{f.title}</h3>
                <p class="text-[15px] leading-[1.6] text-white/75 sm:text-base">{f.body}</p>
              </div>
            </li>
          ))
        }
      </ol>
    </section>

    {/* Closing band on sunglow. The legacy lead has a second sentence, about the form being split into parts and the progress being saved
        in the browser, which describes the portal wizard. Dzul removed it for Phase A (SAKEM-103), while registration is an external form
        behind /daftar, and nothing takes its place. It belongs back when the wizard is switched on (Phase B). */}
    <section class="grid items-center gap-12 bg-secondary-yellow px-6 py-20 md:grid-cols-[1.2fr_0.8fr] md:gap-16 md:px-10 md:py-28">
      <div class="anim-reveal flex flex-col items-start gap-6">
        <Heading level="display" as="h2" class="text-balance">Siap Bergabung dengan Sakola Kembara?</Heading>
        <p class="text-lg md:text-xl">Isi formulir pendaftaran sekarang.</p>
        <Button href={REGISTRATION_PATH} variant="primary" size="lg" class="w-full bg-primary-blue-dark px-7 hover:bg-primary-blue sm:w-auto">
          <Icon name="clipboard-list" size={18} />
          Daftar Sekarang
        </Button>
      </div>
      <span
        class:list={[polaroidFrame, 'anim-reveal hidden w-[380px] justify-self-end bg-white shadow-[0_24px_50px_-20px_rgba(13,31,82,0.5)] md:block']}
        style={polaroidTilt(1)}
        aria-hidden="true"
      >
        <Img src="/images/home/impact-kampus.jpg" alt="" sizes="380px" class="aspect-[4/5] w-full rounded-[3px] object-cover" />
      </span>
    </section>
  </main>
</Base>
