---
import qrisImage from '@root/public/images/qris-sakola-kembara.png';
import { env } from 'cloudflare:workers';
import Button from '~/components/Button.astro';
import Heading from '~/components/Heading.astro';
import Icon from '~/components/Icon.astro';
import Img from '~/components/Img.astro';
import ReportsSection from '~/components/ReportsSection.astro';
import SectionHeader from '~/components/SectionHeader.astro';
import Base from '~/layouts/Base.astro';
import { contentRuntime, contentSectionHeaders } from '~/lib/content-api';
import { loadReportsSection } from '~/lib/reports';
import { polaroidFrame, polaroidTilt } from '~/lib/ui';


// SSR since SAKEM-105: the Laporan section (the page /laporan moved here) reads the reports from the content API at
// request time (see lib/content-api.ts for the timeout, the 60 s cache and stale-if-error), so the page is rendered by
// the Worker like /tim, and is one of the pages of src/lib/page-cache.ts. It used to be a static file.
// The page NEVER fails because of the reports: with the API down and nothing cached it is still a 200, and only the
// section shows its failure panel (contentSectionHeaders: `no-store`, so nothing keeps that answer).
export const prerender = false;

// Ported from app/(public)/donasi/page.tsx and layout.tsx. Bank details, QRIS and
// the confirmation form are the legacy constants, unchanged.
// Layout (SAKEM-113, round 4 of the inner-pages mock approved by Dzul on 2026-10-28): the account number is the large
// line of the navy transfer card; the other three details sit under it.
const ACCOUNT_NUMBER_SHOWN = '1010 141 940';
const bankDetails = [
  { label: 'Bank', value: 'Bank Muamalat' },
  { label: 'Kode Bank', value: '147' },
  { label: 'Atas Nama', value: 'Sakola Kembara Indonesia' },
];

const ACCOUNT_NUMBER = '1010141940';
const CONFIRMATION_FORM_URL =
  'https://docs.google.com/forms/d/e/1FAIpQLSe0wQUmreIspbu75JpHYpuHHYbgVi4FaROcfNTiTvgchCywdQ/viewform';

// The QR is imported, so its URL is content-hashed (swapping the file busts every cache)
// and a missing file fails the build. That is why the legacy "file is missing" placeholder
// box (a client-side onError fallback) is not ported. A plain <img> on purpose: a QR code
// must reach the scanner byte for byte, so it is not resized or re-encoded.
const QRIS_IMAGE = qrisImage.src;

const reports = await loadReportsSection(() => ({
  ...contentRuntime(env, Astro.locals.cfContext),
  onFailure: (reason) => console.warn(`reports api: ${reason}`),
}));
const page = contentSectionHeaders(reports.source);
Astro.response.status = page.status;
for (const [name, value] of Object.entries(page.headers)) Astro.response.headers.set(name, value);
Astro.response.headers.set('x-reports-source', reports.source);
---

<Base
  seo={{
    kind: 'page',
    title: 'Donasi',
    description:
      'Dukung pendidikan setara untuk anak Indonesia. Donasi via QRIS atau transfer bank ke Sakola Kembara. Setiap kontribusi membuka pintu perguruan tinggi bagi siswa dari keluarga kurang mampu.',
    path: '/donasi',
  }}
>
  <main class="min-h-screen bg-[#FBFBF5] text-primary-blue-dark">
    {/* Hero: title and lead on the left, a polaroid on the right. */}
    <section class="grid items-center gap-12 px-6 pb-20 pt-[calc(var(--hero-top,8rem)_+_2rem)] md:grid-cols-[1.1fr_0.9fr] md:gap-16 md:px-10 md:pb-28 md:pt-[calc(var(--hero-top,8rem)_+_4rem)]">
      <div class="anim-fade-up flex flex-col gap-6">
        <Heading level="display" as="h1" class="text-balance">Dukung Perjalanan Mereka</Heading>
        <p class="max-w-[30em] text-[17px] leading-[1.65] text-gray-600 md:text-lg">
          Setiap donasi Anda membantu siswa dari keluarga kurang mampu untuk mewujudkan impian mereka masuk perguruan tinggi.
        </p>
      </div>
      <span
        class:list={[polaroidFrame, 'anim-reveal w-full max-w-[420px] justify-self-center bg-white shadow-[0_24px_50px_-20px_rgba(13,31,82,0.55)] md:justify-self-end']}
        style={polaroidTilt(3)}
        aria-hidden="true"
      >
        <Img src="/images/home/hero-poster.jpg" alt="" sizes="(min-width: 768px) 420px, 90vw" loading="eager" class="aspect-[5/4] w-full rounded-[3px] object-cover" />
      </span>
    </section>

    {/* Ways to give, on navy mist: the QRIS on a white card (never tilted: it has to scan), the transfer on navy. */}
    <section class="flex flex-col gap-12 bg-[#EEF1F6] px-6 py-20 md:gap-14 md:px-10 md:py-28">
      <SectionHeader
        align="left"
        title="Cara Berdonasi"
        lead="Pilih salah satu metode di bawah ini. Donasi dengan nominal berapa pun sangat berarti bagi mereka."
        class="anim-reveal"
      />
      <div class="grid gap-4 md:grid-cols-[0.75fr_1.25fr]">
        <div class="anim-reveal flex flex-col items-center gap-6 rounded-xl bg-white p-8 text-center md:p-9">
          <Heading level="card" as="h3" class="text-[26px] text-primary-blue-dark">Scan QRIS</Heading>
          {/* A plain <img> on purpose: a QR code must reach the scanner byte for byte, so it is not resized or re-encoded. */}
          <img
            src={QRIS_IMAGE}
            alt="QRIS Sakola Kembara"
            width={260}
            height={347}
            loading="lazy"
            decoding="async"
            class="w-full max-w-[260px] aspect-[3/4] rounded-lg"
          />
          <p class="text-[15px] text-gray-600">
            Scan via <span class="font-semibold text-primary-blue-dark">GoPay, OVO, DANA, ShopeePay</span>, atau m-banking.
          </p>
          <Button href={QRIS_IMAGE} download="qris-sakola-kembara.png" variant="outline-navy" size="lg" class="mt-auto">
            <Icon name="download" size={18} />
            Download QR
          </Button>
        </div>

        <div class="anim-reveal flex flex-col justify-between gap-8 rounded-xl bg-primary-blue-dark p-8 text-white md:p-11">
          <Heading level="card" as="h3" class="text-[26px] text-white">Transfer Bank</Heading>
          <div class="flex flex-col gap-2.5">
            <span class="text-sm text-white/70">Nomor Rekening</span>
            <span class="text-[clamp(40px,6vw,72px)] font-medium leading-none tracking-[-0.03em] text-secondary-yellow">{ACCOUNT_NUMBER_SHOWN}</span>
          </div>
          <dl class="grid gap-5 border-t border-white/20 pt-6 sm:grid-cols-3">
            {
              bankDetails.map((detail) => (
                <div class="flex flex-col gap-1">
                  <dt class="text-sm text-white/70">{detail.label}</dt>
                  <dd class="text-lg font-medium">{detail.value}</dd>
                </div>
              ))
            }
          </dl>
          {/* The label swaps to "Tersalin!" for two seconds (script below); [data-copied] is the confirmed state.
              Without JS the number above is still on screen. */}
          <Button
            type="button"
            variant="yellow-on-navy"
            size="lg"
            class="self-start text-primary-blue-dark data-[copied]:bg-white"
            data-copy-account={ACCOUNT_NUMBER}
          >
            <span data-copy-idle class="inline-flex items-center gap-2">
              <Icon name="copy" size={18} />
              Salin No Rekening
            </span>
            <span data-copy-done hidden class="inline-flex items-center gap-2">
              <Icon name="check" size={18} />
              Tersalin!
            </span>
          </Button>
        </div>
      </div>
    </section>

    {/* Next steps: the confirmation form and the contact page, two columns with a rule between them from md. */}
    <section class="grid gap-12 px-6 py-20 md:grid-cols-2 md:gap-0 md:px-10 md:py-28">
      <div class="anim-reveal flex flex-col items-start gap-5 md:border-r md:border-primary-blue-dark/15 md:pr-16">
        <Heading level="subsection" as="h2" class="text-primary-blue-dark">Terima Kasih atas Donasi Anda</Heading>
        <p class="max-w-[30em] text-[17px] leading-[1.65] text-gray-600">
          Setelah berdonasi, mohon konfirmasikan melalui formulir berikut agar donasi Anda dapat kami catat dengan baik.
        </p>
        <Button href={CONFIRMATION_FORM_URL} size="lg" class="bg-primary-blue-dark hover:bg-primary-blue">
          <Icon name="clipboard-check" size={18} />
          Konfirmasi Donasi
        </Button>
      </div>
      {/* Kontak Kami — donation questions. The volunteer/partnership pitch that used to
          sit here now lives on /tim, next to the actual sign-up link. */}
      <div class="anim-reveal flex flex-col items-start gap-5 md:pl-16">
        <Heading level="subsection" as="h2" class="text-primary-blue-dark">Kontak Kami</Heading>
        <p class="max-w-[30em] text-[17px] leading-[1.65] text-gray-600">
          Ada pertanyaan seputar donasi, penyaluran dana, atau laporan penggunaannya? Tim kami siap membantu.
        </p>
        <Button href="/kontak" variant="outline-navy" size="lg">Hubungi Kami</Button>
      </div>
    </section>

    {/* Laporan (SAKEM-105): the reports, where /laporan used to be. Anchor: /donasi#laporan. */}
    <ReportsSection section={reports} uploadsBase={env.UPLOADS_BASE_URL} />
  </main>
</Base>

<script>
  // Copy the account number. navigator.clipboard needs a secure context and a user gesture;
  // when it throws, fall back to a hidden textarea and execCommand (same fallback as the legacy page).
  const COPIED_MS = 2000;

  async function copyText(text: string) {
    try {
      await navigator.clipboard.writeText(text);
    } catch {
      const textarea = document.createElement('textarea');
      textarea.value = text;
      textarea.style.position = 'fixed';
      textarea.style.opacity = '0';
      document.body.appendChild(textarea);
      textarea.select();
      document.execCommand('copy');
      document.body.removeChild(textarea);
    }
  }

  const button = document.querySelector<HTMLButtonElement>('[data-copy-account]');
  const idle = button?.querySelector<HTMLElement>('[data-copy-idle]');
  const done = button?.querySelector<HTMLElement>('[data-copy-done]');
  let timer: ReturnType<typeof setTimeout> | undefined;

  button?.addEventListener('click', async () => {
    await copyText(button.dataset.copyAccount ?? '');
    button.toggleAttribute('data-copied', true);
    if (idle) idle.hidden = true;
    if (done) done.hidden = false;
    clearTimeout(timer);
    timer = setTimeout(() => {
      button.toggleAttribute('data-copied', false);
      if (idle) idle.hidden = false;
      if (done) done.hidden = true;
    }, COPIED_MS);
  });
</script>
