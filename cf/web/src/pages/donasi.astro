---
import qrisImage from '@root/public/images/qris-sakola-kembara.png';
import { env } from 'cloudflare:workers';
import Button from '~/components/Button.astro';
import Container from '~/components/Container.astro';
import Heading from '~/components/Heading.astro';
import Icon from '~/components/Icon.astro';
import PageHero from '~/components/PageHero.astro';
import ReportsSection from '~/components/ReportsSection.astro';
import Base from '~/layouts/Base.astro';
import { contentRuntime, contentSectionHeaders } from '~/lib/content-api';
import { loadReportsSection } from '~/lib/reports';

// SSR since SAKEM-105: the Laporan section (the page /laporan moved here) reads the reports from the content API at
// request time (see lib/content-api.ts for the timeout, the 60 s cache and stale-if-error), so the page is rendered by
// the Worker like /tim, and is one of the pages of src/lib/page-cache.ts. It used to be a static file.
// The page NEVER fails because of the reports: with the API down and nothing cached it is still a 200, and only the
// section shows its failure panel (contentSectionHeaders: `no-store`, so nothing keeps that answer).
export const prerender = false;

// Ported from app/(public)/donasi/page.tsx and layout.tsx. Bank details, QRIS and
// the confirmation form are the legacy constants, unchanged.
const bankDetails = [
  { label: 'Bank', value: 'Bank Muamalat' },
  { label: 'Kode Bank', value: '147', mono: true },
  { label: 'Nomor Rekening', value: '1010 141 940', mono: true },
  { label: 'Atas Nama', value: 'Sakola Kembara Indonesia' },
];

const ACCOUNT_NUMBER = '1010141940';
const CONFIRMATION_FORM_URL =
  'https://docs.google.com/forms/d/e/1FAIpQLSe0wQUmreIspbu75JpHYpuHHYbgVi4FaROcfNTiTvgchCywdQ/viewform';

// The QR is imported, so its URL is content-hashed (swapping the file busts every cache)
// and a missing file fails the build. That is why the legacy "file is missing" placeholder
// box (a client-side onError fallback) is not ported. A plain <img> on purpose: a QR code
// must reach the scanner byte for byte, so it is not resized or re-encoded.
const QRIS_IMAGE = qrisImage.src;

const reports = await loadReportsSection(() => ({
  ...contentRuntime(env, Astro.locals.cfContext),
  onFailure: (reason) => console.warn(`reports api: ${reason}`),
}));
const page = contentSectionHeaders(reports.source);
Astro.response.status = page.status;
for (const [name, value] of Object.entries(page.headers)) Astro.response.headers.set(name, value);
Astro.response.headers.set('x-reports-source', reports.source);
---

<Base
  seo={{
    kind: 'page',
    title: 'Donasi',
    description:
      'Dukung pendidikan setara untuk anak Indonesia. Donasi via QRIS atau transfer bank ke Sakola Kembara. Setiap kontribusi membuka pintu perguruan tinggi bagi siswa dari keluarga kurang mampu.',
    path: '/donasi',
  }}
>
  <main class="min-h-screen bg-gray-50">
    <PageHero
      title="Dukung Perjalanan Mereka"
      lead="Setiap donasi Anda membantu siswa dari keluarga kurang mampu untuk mewujudkan impian mereka masuk perguruan tinggi."
    />

    {/* Main Content */}
    <section class="py-16">
      <Container size="focused">
        {/* Heading */}
        <div class="anim-fade-up text-center mb-10" style="animation-delay: 0.1s">
          <Heading level="panel" as="h2" class="text-gray-900 mb-3">Cara Berdonasi</Heading>
          <p class="text-gray-600 max-w-[600px] mx-auto">
            Pilih salah satu metode di bawah ini. Donasi dengan nominal berapa pun sangat berarti bagi mereka.
          </p>
        </div>

        {/* Payment Methods */}
        <div class="anim-fade-up grid md:grid-cols-2 gap-6 mb-6" style="animation-delay: 0.2s">
          {/* QRIS Card */}
          <div class="bg-white rounded-3xl p-8 shadow-lg flex flex-col">
            <Heading level="card" class="text-primary-blue text-center mb-6">Scan QRIS</Heading>

            <img
              src={QRIS_IMAGE}
              alt="QRIS Sakola Kembara"
              width={280}
              height={373}
              loading="lazy"
              decoding="async"
              class="mx-auto mb-6 w-full max-w-[280px] aspect-[3/4] rounded-2xl"
            />

            <p class="text-center text-gray-500 text-sm mb-6">
              Scan via <span class="font-semibold text-gray-700">GoPay, OVO, DANA, ShopeePay</span>, atau m-banking.
            </p>

            <Button href={QRIS_IMAGE} download="qris-sakola-kembara.png" variant="outline" size="lg" fullWidth class="mt-auto">
              <Icon name="download" size={18} />
              Download QR
            </Button>
          </div>

          {/* Transfer Bank Card */}
          <div class="bg-white rounded-3xl p-8 shadow-lg flex flex-col">
            <Heading level="card" class="text-primary-blue text-center mb-6">Transfer Bank</Heading>

            <div class="space-y-5 mb-6">
              {
                bankDetails.map((detail) => (
                  <div>
                    <div class="text-xs font-medium uppercase tracking-wider text-gray-500 mb-1">{detail.label}</div>
                    <div class={`text-lg font-bold text-gray-900 ${detail.mono ? 'font-mono tracking-wide' : ''}`}>
                      {detail.value}
                    </div>
                  </div>
                ))
              }
            </div>

            {/* The label swaps to "Tersalin!" for two seconds (script below); [data-copied] is
                the green state of the legacy button. Without JS the number above is still on screen. */}
            <Button
              type="button"
              variant="outline"
              size="lg"
              fullWidth
              class="mt-auto data-[copied]:border-secondary-green data-[copied]:text-secondary-green data-[copied]:hover:bg-transparent"
              data-copy-account={ACCOUNT_NUMBER}
            >
              <span data-copy-idle class="inline-flex items-center gap-2">
                <Icon name="copy" size={18} />
                Salin No Rekening
              </span>
              <span data-copy-done hidden class="inline-flex items-center gap-2">
                <Icon name="check" size={18} />
                Tersalin!
              </span>
            </Button>
          </div>
        </div>

        {/* Next-step CTAs */}
        <div class="anim-fade-up grid md:grid-cols-2 gap-6" style="animation-delay: 0.3s">
          {/* Confirmation */}
          <div class="bg-primary-blue/5 border border-primary-blue/20 rounded-3xl p-8 text-center flex flex-col items-center">
            <div class="w-12 h-12 bg-primary-blue/10 rounded-xl flex items-center justify-center mb-4">
              <Icon name="clipboard-check" size={24} class="text-primary-blue" />
            </div>
            <Heading level="card" class="text-gray-900 mb-2">Terima Kasih atas Donasi Anda</Heading>
            <p class="text-gray-600 text-sm mb-6 max-w-[360px]">
              Setelah berdonasi, mohon konfirmasikan melalui formulir berikut agar donasi Anda dapat kami catat dengan baik.
            </p>
            <Button href={CONFIRMATION_FORM_URL} size="lg" fullWidth class="mt-auto">
              <Icon name="clipboard-check" size={18} />
              Konfirmasi Donasi
            </Button>
          </div>

          {/* Kontak Kami — donation questions. The volunteer/partnership pitch that used to
              sit here now lives on /tim, next to the actual sign-up link. */}
          <div class="bg-primary-blue-dark rounded-3xl p-8 text-center text-white flex flex-col items-center">
            <div class="w-12 h-12 bg-white/15 rounded-xl flex items-center justify-center mb-4">
              <Icon name="mail" size={24} class="text-white" />
            </div>
            <Heading level="card" class="mb-2">Kontak Kami</Heading>
            <p class="text-white/80 text-sm mb-6 max-w-[360px]">
              Ada pertanyaan seputar donasi, penyaluran dana, atau laporan penggunaannya? Tim kami siap membantu.
            </p>
            <Button href="/kontak" variant="white-on-navy" size="lg" fullWidth class="mt-auto">Hubungi Kami</Button>
          </div>
        </div>
      </Container>
    </section>

    {/* Laporan (SAKEM-105): the reports, where /laporan used to be. Anchor: /donasi#laporan. */}
    <ReportsSection section={reports} uploadsBase={env.UPLOADS_BASE_URL} />
  </main>
</Base>

<script>
  // Copy the account number. navigator.clipboard needs a secure context and a user gesture;
  // when it throws, fall back to a hidden textarea and execCommand (same fallback as the legacy page).
  const COPIED_MS = 2000;

  async function copyText(text: string) {
    try {
      await navigator.clipboard.writeText(text);
    } catch {
      const textarea = document.createElement('textarea');
      textarea.value = text;
      textarea.style.position = 'fixed';
      textarea.style.opacity = '0';
      document.body.appendChild(textarea);
      textarea.select();
      document.execCommand('copy');
      document.body.removeChild(textarea);
    }
  }

  const button = document.querySelector<HTMLButtonElement>('[data-copy-account]');
  const idle = button?.querySelector<HTMLElement>('[data-copy-idle]');
  const done = button?.querySelector<HTMLElement>('[data-copy-done]');
  let timer: ReturnType<typeof setTimeout> | undefined;

  button?.addEventListener('click', async () => {
    await copyText(button.dataset.copyAccount ?? '');
    button.toggleAttribute('data-copied', true);
    if (idle) idle.hidden = true;
    if (done) done.hidden = false;
    clearTimeout(timer);
    timer = setTimeout(() => {
      button.toggleAttribute('data-copied', false);
      if (idle) idle.hidden = false;
      if (done) done.hidden = true;
    }, COPIED_MS);
  });
</script>
