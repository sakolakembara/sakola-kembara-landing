---
import { env } from 'cloudflare:workers';
import BlogUnavailable from '~/components/BlogUnavailable.astro';
import Container from '~/components/Container.astro';
import Heading from '~/components/Heading.astro';
import Icon from '~/components/Icon.astro';
import NotFoundPage from '~/components/NotFoundPage.astro';
import Tag from '~/components/Tag.astro';
import Base from '~/layouts/Base.astro';
import { coverAttrs, getBlogSource, headerSource } from '~/lib/blog';
import { blogRuntime } from '~/lib/blog-runtime';
import { contentPageHeaders } from '~/lib/content-api';
import { rewriteUploadsInHtml } from '~/lib/uploads';

// SSR: the article comes from the content API at request time (a new or edited article shows
// without a rebuild) through the Cache API, 60 s fresh and stale-if-error (lib/content-api.ts).
//   - an unknown or unpublished slug is a real 404 with the 404 page (the API's 404, or a slug that
//     cannot exist, which is answered without asking the API);
//   - an API outage with no earlier copy is a 503 with a plain notice, never a 500.
// This used to be one prerendered file per article; the migrated articles' images still get their
// WebP srcset, from the asset manifest (coverAttrs).
export const prerender = false;

const slug = Astro.params.slug ?? '';
const source = await getBlogSource(blogRuntime((p) => Astro.locals.cfContext.waitUntil(p)));
const result = await source.article(slug);

// 200 with the article, 404 for a slug the API does not have, 503 when it cannot be reached and there is no copy.
const answer = contentPageHeaders(headerSource(result.source));
Astro.response.status = answer.status;
for (const [name, value] of Object.entries(answer.headers)) Astro.response.headers.set(name, value);
Astro.response.headers.set('x-blog-source', result.source);

const page = result.data;
const article = page?.article;
// Covers and images uploaded in the admin live in R2 on their own domain (docs/cloudflare/uploads.md);
// empty = same-origin paths and the HTML exactly as the API sent it.
const uploadsBase = env.UPLOADS_BASE_URL;
const cover = article ? coverAttrs(article.image, article.imageWidth, article.imageHeight, uploadsBase) : null;
const related = (page?.related ?? []).map((item) => ({ ...item, cover: coverAttrs(item.image, item.imageWidth, item.imageHeight, uploadsBase) }));
---

---

{
  !article ? (
    result.source === 'not_found' ? (
      <NotFoundPage />
    ) : (
      <BlogUnavailable path={`/blog/${slug}`} />
    )
  ) : (
<Base
  seo={{
    kind: 'page',
    title: article.title,
    description: article.excerpt,
    path: `/blog/${article.slug}`,
    ogImage: cover?.src,
    article: {
      dateISO: article.dateISO,
      modifiedISO: article.modifiedISO,
      author: article.author,
      category: article.category,
      imageWidth: article.imageWidth,
      imageHeight: article.imageHeight,
    },
    crumbs: [
      { name: 'Beranda', path: '/' },
      { name: 'Blog', path: '/blog' },
      { name: article.title, path: `/blog/${article.slug}` },
    ],
  }}
>
  <main class="min-h-screen bg-gray-50">
    <section class="relative overflow-hidden">
      {
        cover ? (
          <img
            src={cover.src}
            srcset={cover.srcset}
            sizes="100vw"
            alt={article.title}
            width={cover.width}
            height={cover.height}
            fetchpriority="high"
            decoding="async"
            class="absolute inset-0 h-full w-full object-cover"
          />
        ) : (
          <div class="absolute inset-0 bg-gradient-to-br from-primary-blue to-accent-navy" />
        )
      }
      <div class="absolute inset-0 bg-gradient-to-t from-black/85 via-black/50 to-black/20"></div>
      {/* pt-[var(--hero-top)] reserves room for the fixed navbar so a tall stack (back link,
          category, multi-line title, meta) cannot bleed into it. */}
      <Container
        size="reading"
        class="relative pb-10 min-h-[420px] md:min-h-[500px] flex flex-col justify-end pt-[var(--hero-top,8rem)]"
      >
        <a href="/blog" class="text-white/90 text-sm font-medium mb-4 hover:text-white transition-colors w-fit">
          Kembali ke Blog
        </a>
        <Tag class="w-fit mb-3">{article.category}</Tag>
        <Heading level="article" class="text-white">{article.title}</Heading>
        <div class="flex flex-wrap items-center gap-4 mt-4 text-sm text-white/85">
          <span class="inline-flex items-center gap-1.5">
            <Icon name="calendar" size={14} />
            {article.date}
          </span>
          <span class="inline-flex items-center gap-1.5">
            <Icon name="user" size={14} />
            {article.author}
          </span>
        </div>
      </Container>
    </section>

    <article class="py-12 pb-16">
      <Container size="reading">
        <div class="bg-white rounded-2xl shadow-sm p-6 md:p-10 -mt-8 relative z-10">
          {/* Trusted: the API sanitizes the HTML when the article is saved (see BlogArticle.contentHtml). */}
          <div class="blog-content" set:html={rewriteUploadsInHtml(article.contentHtml, uploadsBase)} />
        </div>
      </Container>
    </article>

    {
      related.length > 0 && (
        <section class="py-12 pb-24 bg-white border-t border-gray-100">
          <Container>
            <h2 class="text-sm font-semibold text-primary-blue uppercase tracking-wider mb-6">Artikel Lainnya</h2>
            <div class="grid md:grid-cols-3 gap-6">
              {related.map((item) => (
                <a
                  href={`/blog/${item.slug}`}
                  class="group bg-gray-50 rounded-xl overflow-hidden border border-gray-100 hover:shadow-md transition-all"
                >
                  <div class="h-[160px] relative overflow-hidden">
                    {item.cover ? (
                      <img
                        src={item.cover.src}
                        srcset={item.cover.srcset}
                        sizes="(min-width: 1200px) 368px, (min-width: 768px) 33vw, 100vw"
                        alt={item.title}
                        width={item.cover.width}
                        height={item.cover.height}
                        loading="lazy"
                        decoding="async"
                        class="absolute inset-0 h-full w-full object-cover group-hover:scale-105 transition-transform duration-300"
                      />
                    ) : (
                      <div class="absolute inset-0 bg-primary-blue/10" />
                    )}
                    <Tag size="sm" class="absolute top-3 left-3">
                      {item.category}
                    </Tag>
                  </div>
                  <div class="p-4">
                    <p class="text-xs text-gray-400 mb-2">{item.date}</p>
                    <h3 class="text-sm font-semibold text-gray-900 line-clamp-2 group-hover:text-primary-blue transition-colors">
                      {item.title}
                    </h3>
                  </div>
                </a>
              ))}
            </div>
          </Container>
        </section>
      )
    }
  </main>
</Base>
)
}
