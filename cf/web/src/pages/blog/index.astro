---
import { env } from 'cloudflare:workers';
import BlogUnavailable from '~/components/BlogUnavailable.astro';
import Container from '~/components/Container.astro';
import Heading from '~/components/Heading.astro';
import PageHero from '~/components/PageHero.astro';
import Base from '~/layouts/Base.astro';
import { coverAttrs, getBlogSource, headerSource, normalizePage, pageHref, pageNumbers } from '~/lib/blog';
import { blogRuntime } from '~/lib/blog-runtime';
import { contentPageHeaders } from '~/lib/content-api';
import { polaroidFrame, polaroidTilt } from '~/lib/ui';

// SSR: the list comes from the content API at request time (a new article shows without a
// rebuild) through the Cache API, 60 s fresh and stale-if-error (see lib/content-api.ts), and
// pagination is `?page=N`, which a prerendered page cannot read.
// An API outage with no copy to fall back on answers 503 with a plain notice, not a 500.
export const prerender = false;

const source = await getBlogSource(blogRuntime((p) => Astro.locals.cfContext.waitUntil(p)));
const result = await source.list(normalizePage(Astro.url.searchParams.get('page')));
const data = result.data;
const answer = contentPageHeaders(headerSource(result.source));
Astro.response.status = answer.status;
for (const [name, value] of Object.entries(answer.headers)) Astro.response.headers.set(name, value);
Astro.response.headers.set('x-blog-source', result.source);

// The featured article is shown on page 1 only (the API always returns it).
const currentPage = data?.page ?? 1;
const totalPages = data?.totalPages ?? 1;
const featured = data && currentPage === 1 ? data.featured : null;
// Covers uploaded in the admin live in R2 on their own domain (docs/cloudflare/uploads.md); empty = same-origin paths.
const uploadsBase = env.UPLOADS_BASE_URL;
const featuredCover = featured && coverAttrs(featured.image, featured.imageWidth, featured.imageHeight, uploadsBase);
const items = (data?.articles ?? []).map((article) => ({
  ...article,
  cover: coverAttrs(article.image, article.imageWidth, article.imageHeight, uploadsBase),
}));
const pages = pageNumbers(currentPage, totalPages);
const prevHref = currentPage > 1 ? pageHref(currentPage - 1) : null;
const nextHref = currentPage < totalPages ? pageHref(currentPage + 1) : null;
const pageLink =
  'min-w-[36px] px-2 py-2 text-sm font-medium text-gray-700 hover:text-primary-blue rounded-lg border border-gray-200 hover:border-primary-blue text-center transition-colors';
const stepLink =
  'px-3 py-2 text-sm font-medium text-gray-700 hover:text-primary-blue rounded-lg border border-gray-200 hover:border-primary-blue transition-colors';
const stepOff = 'px-3 py-2 text-sm font-medium text-gray-300 rounded-lg border border-gray-100';
---

{
  !data ? (
    <BlogUnavailable path="/blog" />
  ) : (
<Base
  seo={{
    kind: 'page',
    title: 'Blog & Cerita',
    description:
      'Cerita dan inspirasi dari Sakola Kembara — kisah alumni, kegiatan, dan update tentang gerakan pemerataan akses pendidikan tinggi di Indonesia.',
    path: '/blog',
    pageType: 'CollectionPage',
  }}
>
  <main class="min-h-screen bg-gray-50">
    <PageHero
      title="Blog & Cerita"
      lead="Ikuti perjalanan kami dalam membuka akses pendidikan. Cerita inspiratif, kegiatan terbaru, dan update dari Sakola Kembara."
    />

    {
      featured && (
        <section class="py-12">
          <Container>
            <Heading level="subsection" class="mb-10 text-primary-blue-dark">Artikel Terbaru</Heading>
            <a href={`/blog/${featured.slug}`} class="group grid items-center gap-10 md:grid-cols-2 md:gap-16">
              <div class:list={[polaroidFrame, 'bg-white shadow-[0_18px_40px_-16px_rgba(13,31,82,0.5)] md:!pb-9']} style={polaroidTilt(0)}>
                <div class="relative aspect-[4/3] overflow-hidden rounded-[3px] bg-primary-blue-dark/10">
                  {featuredCover && (
                    <img
                      src={featuredCover.src}
                      srcset={featuredCover.srcset}
                      sizes="(min-width: 1200px) 576px, (min-width: 768px) 50vw, 100vw"
                      alt={featured.title}
                      width={featuredCover.width}
                      height={featuredCover.height}
                      fetchpriority="high"
                      decoding="async"
                      class="absolute inset-0 h-full w-full object-cover transition-transform duration-500 group-hover:scale-[1.04] motion-reduce:transition-none"
                    />
                  )}
                  <p class="absolute inset-x-4 top-4 flex items-start justify-between gap-1.5 text-xs font-semibold text-primary-blue-dark">
                    <span class="rounded-full bg-secondary-yellow px-3 py-1">{featured.category}</span>
                    <span class="rounded-full bg-white/90 px-3 py-1">{featured.date}</span>
                  </p>
                </div>
              </div>
              <div class="flex flex-col gap-4">
                <Heading level="subsection" class="text-primary-blue-dark transition-colors group-hover:text-primary-blue">
                  {featured.title}
                </Heading>
                <p class="text-[17px] leading-[1.65] text-gray-600">{featured.excerpt}</p>
                <span class="font-semibold text-primary-blue-dark underline decoration-primary-blue-dark/30 underline-offset-4 group-hover:decoration-primary-blue-dark">Baca Selengkapnya</span>
              </div>
            </a>
          </Container>
        </section>
      )
    }

    <section class="py-12 pb-24 bg-white">
      <Container>
        <div class="flex items-baseline justify-between mb-10 gap-4 flex-wrap">
          <Heading level="subsection" class="text-primary-blue-dark">Semua Artikel</Heading>
          {
            totalPages > 1 && (
              <span class="text-xs text-gray-500">
                Halaman {currentPage} dari {totalPages}
              </span>
            )
          }
        </div>
        <div class="grid gap-x-8 gap-y-14 md:grid-cols-2 lg:grid-cols-3">
          {
            items.map((article, index) => (
              <article>
                <a href={`/blog/${article.slug}`} class="group flex h-full flex-col gap-6">
                  <div class:list={[polaroidFrame, 'bg-white shadow-[0_14px_30px_-14px_rgba(13,31,82,0.45)]']} style={polaroidTilt(index)}>
                    <div class="relative aspect-[4/3] overflow-hidden rounded-[3px] bg-primary-blue-dark/10">
                      {article.cover && (
                        <img
                          src={article.cover.src}
                          srcset={article.cover.srcset}
                          sizes="(min-width: 1200px) 363px, (min-width: 1024px) 33vw, (min-width: 768px) 50vw, 100vw"
                          alt={article.title}
                          width={article.cover.width}
                          height={article.cover.height}
                          loading="lazy"
                          decoding="async"
                          class="absolute inset-0 h-full w-full object-cover transition-transform duration-500 group-hover:scale-[1.04] motion-reduce:transition-none"
                        />
                      )}
                      <p class="absolute inset-x-3 top-3 flex items-start justify-between gap-1.5 text-xs font-semibold text-primary-blue-dark">
                        <span class="rounded-full bg-secondary-yellow px-2.5 py-1">{article.category}</span>
                        <span class="rounded-full bg-white/90 px-2.5 py-1">{article.date}</span>
                      </p>
                    </div>
                  </div>
                  <div class="flex flex-col gap-2">
                    <h3 class="line-clamp-3 text-xl font-medium leading-snug tracking-[-0.01em] text-primary-blue-dark transition-colors group-hover:text-primary-blue">
                      {article.title}
                    </h3>
                    <p class="line-clamp-2 text-[15px] leading-relaxed text-gray-600">{article.excerpt}</p>
                  </div>
                </a>
              </article>
            ))
          }
        </div>

        {
          totalPages > 1 && (
            <nav aria-label="Pagination" class="flex items-center justify-center gap-2 mt-12 flex-wrap">
              {prevHref ? (
                <a href={prevHref} class={stepLink}>
                  Sebelumnya
                </a>
              ) : (
                <span class={stepOff}>Sebelumnya</span>
              )}
              <div class="flex items-center gap-1">
                {pages.map((p) =>
                  p === '…' ? (
                    <span class="px-2 text-sm text-gray-400 select-none">…</span>
                  ) : p === currentPage ? (
                    <span
                      aria-current="page"
                      class="min-w-[36px] px-2 py-2 text-sm font-semibold text-white bg-primary-blue rounded-lg text-center"
                    >
                      {p}
                    </span>
                  ) : (
                    <a href={pageHref(p)} class={pageLink}>
                      {p}
                    </a>
                  ),
                )}
              </div>
              {nextHref ? (
                <a href={nextHref} class={stepLink}>
                  Berikutnya
                </a>
              ) : (
                <span class={stepOff}>Berikutnya</span>
              )}
            </nav>
          )
        }
      </Container>
    </section>
  </main>
</Base>
)
}
