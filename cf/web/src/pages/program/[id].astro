---
import { Image, getImage } from 'astro:assets';
import prapembinaanPhoto from '@root/public/images/program/prapembinaan.jpg';
import pembinaanPhoto from '@root/public/images/program/pembinaan.jpg';
import pascaPembinaanPhoto from '@root/public/images/program/pasca-pembinaan.jpg';
import kbmPekananPhoto from '@root/public/images/program/kbm-pekanan.jpg';
import asramaAkhirTahunPhoto from '@root/public/images/program/asrama-akhir-tahun.jpg';
import asramaIntensifPhoto from '@root/public/images/program/asrama-intensif.jpg';
import mentoringPhoto from '@root/public/images/program/mentoring.jpg';
import Button from '~/components/Button.astro';
import Heading from '~/components/Heading.astro';
import Icon from '~/components/Icon.astro';
import SectionHeader from '~/components/SectionHeader.astro';
import Base from '~/layouts/Base.astro';
import { galleryAlt, getProgramGallery, gallerySrcset } from '~/lib/gallery';
import { programSeo, programs, type Program, type ProgramPhoto } from '~/lib/programs';
import { polaroidFrame, polaroidTilt } from '~/lib/ui';

// One static HTML file per program stage (program/<id>.html), served by the assets
// layer. An id that is not in getStaticPaths() matches no file and no route: the
// Worker answers it with the 404 page and a real 404 status. `/program` itself is a
// 307 to /program/prapembinaan in the redirect table.
export const prerender = true;

export function getStaticPaths() {
  return programs.map((program) => ({ params: { id: program.id }, props: { program } }));
}

interface Props {
  program: Program;
}
const { program } = Astro.props;

const photos: Record<ProgramPhoto, ImageMetadata> = {
  prapembinaan: prapembinaanPhoto,
  pembinaan: pembinaanPhoto,
  'pasca-pembinaan': pascaPembinaanPhoto,
  'kbm-pekanan': kbmPekananPhoto,
  'asrama-akhir-tahun': asramaAkhirTahunPhoto,
  'asrama-intensif': asramaIntensifPhoto,
  mentoring: mentoringPhoto,
};

const currentIndex = programs.findIndex((p) => p.id === program.id);
const nextProgram = programs[currentIndex + 1] ?? null;

// Share image: the stage photo at 1200 px wide instead of the multi-megabyte original.
const shareImage = await getImage({ src: photos[program.photo], width: 1200, format: 'jpeg', quality: 80 });
const { seo, jsonLd } = programSeo(program, shareImage.src);

// Read from the image manifest (src/lib/gallery.ts, built by scripts/build-assets.mjs); [] hides the section.
const gallery = getProgramGallery(program.id);

// Layout (SAKEM-113, round 4 of the inner-pages mock approved by Dzul on 2026-10-28). The activities split three ways:
// those with a photo are polaroids on the navy band, those with a PDF are the boxes after it, the rest are rows on the band.
// An activity's hours ("290+ jam belajar setahun", "Hingga 400 jam belajar") are also shown large above the polaroids.
const withPhoto = program.subPrograms.filter((s) => s.photo);
const withPdf = program.subPrograms.filter((s) => !s.photo && s.attachment);
const plain = program.subPrograms.filter((s) => !s.photo && !s.attachment);
const stats = program.subPrograms.flatMap((s) => {
  const m = s.hours?.match(/^(hingga\s+)?(\d+\+?)\s+(.+)$/i);
  return m ? [{ before: m[1]?.trim().toLowerCase() ?? '', value: m[2], label: `${m[3]} · ${s.title}` }] : [];
});
---

<Base seo={seo} jsonLd={jsonLd}>
  <main class="min-h-screen bg-[#FBFBF5] text-primary-blue-dark">
    {/* Hero: the journey question, the three stages as links (each stage keeps its own URL, server-rendered, works with
        Back), then the stage title as the page's h1 and its photo, the LCP image. */}
    <section class="flex flex-col gap-8 px-6 pt-[calc(var(--hero-top,8rem)_+_2rem)] md:gap-9 md:px-10 md:pt-[calc(var(--hero-top,8rem)_+_4rem)]">
      <p class="anim-fade-up max-w-[40em] text-[17px] text-gray-600 md:text-lg">Apa saja yang dilalui penerima manfaat Sakola Kembara?</p>
      <nav aria-label="Tahapan program" class="anim-fade-up">
        <ol class="flex flex-wrap gap-2">
          {
            programs.map((stage, index) => {
              const active = stage.id === program.id;
              return (
                <li>
                  <a
                    href={`/program/${stage.id}`}
                    aria-current={active ? 'page' : undefined}
                    class:list={[
                      'inline-flex items-center rounded-full px-4 py-2.5 text-[15px] font-semibold transition-colors focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-primary-blue',
                      active
                        ? 'bg-primary-blue-dark text-white'
                        : 'border-[1.5px] border-primary-blue-dark/25 hover:border-primary-blue-dark',
                    ]}
                  >
                    {String(index + 1).padStart(2, '0')} · {stage.title}
                  </a>
                </li>
              );
            })
          }
        </ol>
      </nav>
      <Heading level="page" class="anim-fade-up text-balance text-[clamp(44px,7.5vw,96px)] leading-none tracking-[-0.04em]">
        {program.title}
      </Heading>
      <div class="relative mt-4 aspect-[4/3] overflow-hidden rounded-xl sm:aspect-[16/9] lg:aspect-[21/9]">
        <Image
          src={photos[program.photo]}
          alt={program.title}
          width={1200}
          widths={[640, 960, 1200]}
          sizes="100vw"
          format="webp"
          quality={75}
          loading="eager"
          fetchpriority="high"
          decoding="async"
          class="absolute inset-0 h-full w-full object-cover"
        />
      </div>
    </section>

    {/* Stage intro: the description large on the left, the points on the right. */}
    <section class="grid gap-10 px-6 py-16 md:grid-cols-2 md:gap-16 md:px-10 md:pb-32 md:pt-[4.5rem]">
      <p class="anim-reveal text-xl font-medium leading-[1.5] tracking-[-0.01em] md:text-2xl">{program.description}</p>
      <ul class="anim-reveal flex flex-col">
        {
          program.points.map((point) => (
            <li class="flex items-baseline gap-4 border-t border-primary-blue-dark/15 py-4 text-[17px] last:border-b md:text-lg">
              <span class="size-2.5 shrink-0 rounded-full bg-secondary-yellow" aria-hidden="true" />
              <span>{point}</span>
            </li>
          ))
        }
      </ul>
    </section>

    {/* Activities on navy: the hours, the photo activities as polaroids, the others as rows. */}
    <section class="flex flex-col gap-14 bg-primary-blue-dark px-6 py-24 text-white md:gap-16 md:px-10 md:py-28">
      <SectionHeader align="left" tone="dark" title="Kegiatan" class="anim-reveal" />
      {
        stats.length > 0 && (
          <div class="grid gap-8 sm:grid-cols-3 sm:gap-10">
            {stats.map((stat, index) => (
              <div class="anim-reveal flex flex-col gap-2.5 border-t border-white/25 pt-6" style={`--i:${index}`}>
                <span class="text-[clamp(56px,6.5vw,80px)] font-medium leading-[0.9] tracking-[-0.04em] text-secondary-yellow">
                  {stat.before && <span class="text-2xl tracking-normal">{stat.before} </span>}
                  {stat.value}
                </span>
                <span class="text-[15px] text-white/75">{stat.label}</span>
              </div>
            ))}
          </div>
        )
      }
      {
        withPhoto.length > 0 && (
          <div class="grid gap-x-7 gap-y-12 sm:grid-cols-2 lg:grid-cols-4">
            {withPhoto.map((subProgram, index) => (
              <article class="anim-reveal group flex flex-col gap-4" style={`--i:${index % 4}`}>
                <div class:list={[polaroidFrame, 'bg-[#FBFBF5] shadow-[0_18px_40px_-12px_rgba(0,0,0,0.55)]']} style={polaroidTilt(index)}>
                  <Image
                    src={photos[subProgram.photo!]}
                    alt={`Kegiatan ${subProgram.title}`}
                    width={800}
                    widths={[400, 600, 800]}
                    sizes="(min-width: 1024px) 25vw, (min-width: 640px) 50vw, 100vw"
                    format="webp"
                    quality={75}
                    loading="lazy"
                    decoding="async"
                    class="aspect-[4/3] w-full rounded-[3px] object-cover"
                  />
                </div>
                <Heading level="card" as="h3" class="mt-1 text-[22px] text-white">{subProgram.title}</Heading>
                <p class="text-[15px] leading-[1.6] text-white/75">{subProgram.description}</p>
              </article>
            ))}
          </div>
        )
      }
      {
        plain.length > 0 && (
          <ul class="flex flex-col">
            {plain.map((subProgram) => (
              <li class="anim-reveal grid gap-3 border-t border-white/25 py-7 last:border-b md:grid-cols-[minmax(0,1fr)_minmax(0,1.4fr)] md:gap-10">
                <Heading level="card" as="h3" class="text-2xl text-white">{subProgram.title}</Heading>
                <p class="text-base leading-[1.65] text-white/75">{subProgram.description}</p>
              </li>
            ))}
          </ul>
        )
      }
    </section>

    {/* Activities with a sample PDF: one box each, the whole box is the download link. */}
    {
      withPdf.length > 0 && (
        <section class="grid gap-4 px-6 pt-16 md:grid-cols-2 md:px-10 md:pt-28">
          {withPdf.map((subProgram) => (
            <a
              href={subProgram.attachment!.href}
              target="_blank"
              rel="noopener noreferrer"
              class="anim-reveal flex min-h-[260px] flex-col justify-between gap-6 rounded-xl bg-[#EEF1F6] p-8 transition-colors hover:bg-[#E3E8F1] md:min-h-[280px] md:p-9"
            >
              <span class="flex flex-col gap-3">
                <span class="text-[28px] font-medium tracking-[-0.02em] md:text-[32px]">{subProgram.title}</span>
                <span class="max-w-[30em] text-base leading-[1.65] text-gray-600">{subProgram.description}</span>
              </span>
              <span class="inline-flex items-center gap-2 font-semibold">
                <Icon name="file-text" size={18} />
                {subProgram.attachment!.label} (PDF)
              </span>
            </a>
          ))}
        </section>
      )
    }

    {/* The timeline placeholder ("Jadwal dan timeline kegiatan akan segera diperbarui.") is not rendered while it has no
        content (Dzul, 2026-10-28, SAKEM-113); SAKEM-057 decides what it becomes. */}

    {/* Gallery. No photos in the program's folder: the whole section is left out. */}
    {
      gallery.length > 0 && (
        <section class="flex flex-col gap-10 px-6 pt-16 md:px-10 md:pt-28">
          <SectionHeader
            align="left"
            title="Galeri Foto"
            lead={`Dokumentasi kegiatan program ${program.title}.`}
            class="anim-reveal"
          />
          {/* Masonry columns: any number of photos, each at its own proportions, no holes. */}
          <div class="columns-2 gap-3 sm:gap-4 md:columns-3">
            {gallery.map((photo, index) => (
              <img
                src={photo.variants[photo.variants.length - 1].src}
                srcset={gallerySrcset(photo)}
                sizes="(min-width: 768px) 33vw, 50vw"
                width={photo.width}
                height={photo.height}
                alt={galleryAlt(program.title, index)}
                loading="lazy"
                decoding="async"
                class="mb-3 h-auto w-full break-inside-avoid rounded-xl bg-primary-blue-dark/10 sm:mb-4"
              />
            ))}
          </div>
        </section>
      )
    }

    {/* Next stage: a sunglow band, the whole band is the link. */}
    {
      nextProgram && (
        <a
          href={`/program/${nextProgram.id}`}
          class="group mt-16 grid bg-secondary-yellow md:mt-28 md:grid-cols-[minmax(0,1fr)_360px]"
        >
          <span class="flex flex-col justify-center gap-4 px-6 py-14 md:px-10 md:py-[4.5rem]">
            <span class="font-semibold">Tahap berikutnya · {nextProgram.tag}</span>
            <span class="text-[clamp(36px,5vw,64px)] font-medium leading-[1.05] tracking-[-0.035em]">
              {nextProgram.title} <span aria-hidden="true" class="inline-block transition-transform group-hover:translate-x-2 motion-reduce:transition-none">→</span>
            </span>
            <span class="sr-only">Lanjut ke Tahap {currentIndex + 2}</span>
          </span>
          <Image
            src={photos[nextProgram.photo]}
            alt=""
            width={720}
            widths={[360, 720]}
            sizes="(min-width: 768px) 360px, 100vw"
            format="webp"
            quality={75}
            loading="lazy"
            decoding="async"
            class="hidden h-full w-full object-cover md:block"
          />
        </a>
      )
    }

    {/* Download PitchDeck CTA */}
    <section class:list={['grid items-end gap-8 px-6 py-20 md:grid-cols-2 md:gap-16 md:px-10 md:py-24', !nextProgram && 'mt-8']}>
      <Heading level="panel" as="h2" class="anim-reveal text-[clamp(32px,3.5vw,44px)] leading-[1.1] tracking-[-0.025em]">Ingin Tahu Lebih Lanjut?</Heading>
      <div class="anim-reveal flex max-w-[30em] flex-col items-start gap-5 md:justify-self-end">
        <p class="text-[17px] leading-[1.65] text-gray-600">
          Download PitchDeck kami untuk informasi lengkap tentang program, dampak, dan cara berkontribusi.
        </p>
        <Button href="/files/pitchdeck-sakola-kembara.pdf" download variant="primary" size="lg" class="bg-primary-blue-dark hover:bg-primary-blue">
          <Icon name="download" size={20} />
          Download PitchDeck
        </Button>
      </div>
    </section>
  </main>
</Base>
