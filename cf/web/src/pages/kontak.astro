---
import { env } from 'cloudflare:workers';
import ContactForm from '~/components/contact/ContactForm.astro';
import Heading from '~/components/Heading.astro';
import SocialLinks from '~/components/SocialLinks.astro';
import Base from '~/layouts/Base.astro';
import { branches } from '~/lib/site';
import { CONTACT_MESSAGES, FIELD_MESSAGES, contactInfo, type ContactFieldErrors, type ContactValues } from '~/lib/contact';
import { drainBody, submitContact } from '~/lib/contact-submit';
import { turnstileSiteKey } from '~/lib/turnstile';

// Ported from app/(public)/kontak/page.tsx and layout.tsx. SSR, because the page receives the form:
// a POST is handled here (lib/contact-submit.ts); the form is a plain HTML POST (the Turnstile widget, which
// needs JavaScript, is the one thing that is not, see ContactForm.astro).
//
//   GET                      the page (`?terkirim=1`: the confirmation instead of the form)
//   POST, valid              303 to /kontak?terkirim=1 (a refresh does not post again)
//   POST, anything else      this page again with the legacy message, the typed text kept and a
//                            status that says what happened: 400 invalid, 413 too large, 429 too many
//                            or the same email again, 503 the message could not be handed over.
//                            Never cached.
// The visitor's address is read from CF-Connecting-IP, and the message goes to the API Worker through
// a service binding (see lib/api-client.ts). No message text or address is ever logged.
export const prerender = false;

const method = Astro.request.method;
const noStore = { 'cache-control': 'no-store' };

if (method !== 'GET' && method !== 'HEAD' && method !== 'POST') {
  await drainBody(Astro.request); // an early answer must not leave an unread body on the connection
  return new Response('Method Not Allowed', { status: 405, headers: { allow: 'GET, HEAD, POST', ...noStore } });
}

let message: string | undefined;
let fieldErrors: ContactFieldErrors = {};
let values: Partial<ContactValues> = {};

if (method === 'POST') {
  const outcome = await submitContact(Astro.request, { env });
  Astro.response.headers.set('cache-control', 'no-store');
  switch (outcome.kind) {
    case 'sent':
      return new Response(null, { status: 303, headers: { location: '/kontak?terkirim=1', ...noStore } });
    case 'forbidden':
      return new Response('Forbidden', { status: 403, headers: { 'content-type': 'text/plain; charset=utf-8', ...noStore } });
    case 'invalid':
      Astro.response.status = 400;
      ({ message, fieldErrors, values } = outcome);
      break;
    case 'turnstile_failed':
      // The API refused the Turnstile token (missing, failed or already used). The form is rendered
      // again below, which is also the widget's reset: a new widget, a new token. The typed text is kept.
      Astro.response.status = 400;
      ({ message, values } = outcome);
      break;
    case 'bad_request':
      Astro.response.status = 400;
      message = CONTACT_MESSAGES.invalid;
      break;
    case 'too_large':
      Astro.response.status = 413;
      message = CONTACT_MESSAGES.invalid;
      fieldErrors = { message: [FIELD_MESSAGES.messageMax] };
      break;
    case 'rate_limited':
    case 'duplicate':
      Astro.response.status = 429;
      Astro.response.headers.set('retry-after', String(outcome.retryAfter));
      ({ message, values } = outcome);
      break;
    case 'unavailable':
      Astro.response.status = 503;
      Astro.response.headers.set('retry-after', '30');
      ({ message, values } = outcome);
      break;
  }
}

const sent = method !== 'POST' && Astro.url.searchParams.get('terkirim') === '1';

// The Turnstile widget (explicit render, Cloudflare's script loaded by the form and only here). The site
// key is public and comes from the Worker var TURNSTILE_SITE_KEY; without it the form has no widget
// (and the helper says so in the Worker log). The confirmation page has no form, so no widget.
const turnstileKey = sent ? null : turnstileSiteKey(env);
---

<Base
  seo={{
    kind: 'page',
    title: 'Kontak',
    description:
      'Hubungi tim Sakola Kembara untuk pertanyaan, kerjasama, atau peluang relawan. Berbasis di Bandung, melayani siswa di seluruh Indonesia.',
    path: '/kontak',
  }}
>
  <main class="min-h-screen bg-[#FBFBF5] text-primary-blue-dark">
    {/* Hero: the title large on the left, the lead on the right (SAKEM-113). */}
    <section class="grid items-end gap-6 px-6 pb-16 pt-[calc(var(--hero-top,8rem)_+_2rem)] md:grid-cols-2 md:gap-16 md:px-10 md:pb-24 md:pt-[calc(var(--hero-top,8rem)_+_4rem)]">
      <Heading level="display" as="h1" class="anim-fade-up text-balance">Mari Bergerak Bersama</Heading>
      <p class="anim-fade-up max-w-[34em] text-[17px] leading-[1.65] text-gray-600 md:justify-self-end md:text-lg">
        Punya pertanyaan, ingin berkolaborasi, atau tertarik menjadi relawan? Kami senang mendengar dari Anda.
      </p>
    </section>

    {/* The form on the left, the contact details as ruled rows on the right, on navy mist. */}
    <section class="grid items-start gap-16 bg-[#EEF1F6] px-6 py-20 md:px-10 md:pb-28 md:pt-24 lg:grid-cols-[1.3fr_1fr] lg:gap-24">
      <div class="anim-reveal">
        <Heading level="subsection" as="h2" class="mb-7 text-primary-blue-dark">Kirim Pesan</Heading>
        <ContactForm
          sent={sent}
          successMessage={CONTACT_MESSAGES.success}
          message={message}
          fieldErrors={fieldErrors}
          values={values}
          turnstileSiteKey={turnstileKey ?? undefined}
        />
      </div>

      <div class="anim-reveal flex flex-col gap-10">
        <div>
          <Heading level="subsection" as="h2" class="mb-4 text-primary-blue-dark">Informasi Kontak</Heading>
          <dl class="flex flex-col">
            {
              contactInfo.map((contact, index) => (
                <div class="flex flex-col gap-1.5 border-t border-primary-blue-dark/15 py-5 last:border-b">
                  <dt class="text-sm text-gray-600">{contact.title}</dt>
                  <dd class="text-xl font-medium md:text-[22px]">{contact.value}</dd>
                  {/* The third row is the location: the branches of the footer, as chips under it. */}
                  {index === 2 && (
                    <dd class="mt-2 flex flex-wrap gap-2">
                      {branches.map((branch) => (
                        <span class="rounded-full border border-primary-blue-dark/30 px-3 py-1.5 text-[13px]">{branch.name}</span>
                      ))}
                    </dd>
                  )}
                </div>
              ))
            }
          </dl>
        </div>
        <div>
          <h3 class="mb-4 text-lg font-semibold">Ikuti Kami</h3>
          <SocialLinks theme="outline" />
        </div>
      </div>
    </section>
  </main>
</Base>
