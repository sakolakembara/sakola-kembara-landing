---
import { env } from 'cloudflare:workers';
import Button from '~/components/Button.astro';
import Container from '~/components/Container.astro';
import Heading from '~/components/Heading.astro';
import Icon from '~/components/Icon.astro';
import PageHero from '~/components/PageHero.astro';
import Tag from '~/components/Tag.astro';
import Base from '~/layouts/Base.astro';
import { contentPageHeaders, contentRuntime } from '~/lib/content-api';
import {
  REPORT_CATEGORY_LABEL,
  REPORT_CATEGORY_TONE,
  formatAcademicYear,
  formatBytes,
  groupReportsByYear,
  loadReports,
} from '~/lib/reports';
import { buttonClasses } from '~/lib/ui';
import { uploadUrl } from '~/lib/uploads';

// SSR: the reports come from the content API at request time (see lib/content-api.ts for the
// timeout, the 60 s cache and stale-if-error). Ported from app/(public)/laporan/.
export const prerender = false;

const { reports, source } = await loadReports(contentRuntime(env, Astro.locals.cfContext));
const page = contentPageHeaders(source);
Astro.response.status = page.status;
for (const [name, value] of Object.entries(page.headers)) Astro.response.headers.set(name, value);
Astro.response.headers.set('x-reports-source', source);

const grouped = groupReportsByYear(reports ?? []);
const totalReports = reports?.length ?? 0;
---

<Base
  seo={{
    kind: 'page',
    title: 'Laporan',
    description:
      'Laporan tahunan, keuangan, dampak, dan donasi Sakola Kembara. Komitmen kami untuk transparansi dan akuntabilitas kepada donor, mitra, dan publik.',
    path: '/laporan',
  }}
>
  <main class="min-h-screen bg-gray-50">
    <PageHero
      title="Laporan"
      lead="Komitmen kami untuk transparansi. Laporan tahunan, keuangan, dampak, dan donasi tersedia untuk diunduh dan dipelajari oleh donor, mitra, dan publik."
    />

    {/* Reports listing */}
    <section class="py-16 md:py-20">
      <Container>
        {/* reports === null: the API is down and nothing is cached. The page says so (it is a 503
            with Retry-After, never cached); an empty list is the legacy empty state, a normal 200. */}
        {
          reports === null ? (
            <div
              role="status"
              class="anim-fade-up bg-white rounded-2xl border border-gray-200 p-12 text-center"
              style="animation-delay: 0.2s"
            >
              <Icon name="file-text" size={32} class="mx-auto text-gray-300 mb-4" />
              <Heading level="card" as="h2" class="text-gray-900 mb-2">
                Laporan belum dapat ditampilkan
              </Heading>
              <p class="text-gray-600 max-w-md mx-auto">
                Kami sedang mengalami kendala saat memuat daftar laporan. Silakan muat ulang halaman ini beberapa
                saat lagi.
              </p>
            </div>
          ) : totalReports === 0 ? (
            <div
              class="anim-fade-up bg-white rounded-2xl border border-gray-200 p-12 text-center"
              style="animation-delay: 0.2s"
            >
              <Icon name="file-text" size={32} class="mx-auto text-gray-300 mb-4" />
              <Heading level="card" as="h2" class="text-gray-900 mb-2">
                Laporan akan segera tersedia
              </Heading>
              <p class="text-gray-600 max-w-md mx-auto">
                Tim kami sedang menyiapkan laporan publik. Periksa kembali halaman ini dalam waktu dekat.
              </p>
            </div>
          ) : (
            <div class="space-y-12">
              {grouped.map(({ year, reports: list }, yearIdx) => (
                <section class="anim-fade-up" style={`animation-delay: ${(0.2 + yearIdx * 0.1).toFixed(1)}s`}>
                  <header class="mb-5 flex flex-wrap items-baseline gap-x-3 gap-y-1">
                    <Heading level="subsection" class="text-gray-900">
                      {formatAcademicYear(year)}
                    </Heading>
                    <span class="text-sm text-gray-500">{list.length} laporan</span>
                  </header>
                  <div class="grid md:grid-cols-2 gap-5">
                    {list.map((r) => (
                      <article class="bg-white rounded-2xl border border-gray-100 p-6 hover:shadow-md hover:-translate-y-0.5 transition-all">
                        <div class="flex items-start justify-between gap-3 mb-3">
                          <Tag tone={REPORT_CATEGORY_TONE[r.category]} size="sm">
                            {REPORT_CATEGORY_LABEL[r.category]}
                          </Tag>
                          <Icon name="file-text" size={20} class="text-gray-300 shrink-0" />
                        </div>
                        <h3 class="text-lg font-bold text-gray-900 mb-2 leading-snug">{r.title}</h3>
                        {r.description && (
                          <p class="text-sm text-gray-600 mb-3 leading-relaxed line-clamp-3">{r.description}</p>
                        )}
                        <div class="text-xs text-gray-500 mb-4">PDF · {formatBytes(r.fileSize)}</div>
                        {/* The path is the API's, used as it is (uploads are never proxied by this Worker). */}
                        <a href={uploadUrl(r.filePath, env.UPLOADS_BASE_URL)} target="_blank" rel="noopener noreferrer" class={buttonClasses({})}>
                          <Icon name="download" size={16} />
                          Unduh Laporan
                        </a>
                      </article>
                    ))}
                  </div>
                </section>
              ))}
            </div>
          )
        }
      </Container>
    </section>

    {/* Trust footer */}
    <section class="py-16 bg-white border-t border-gray-100">
      <Container size="reading" class="text-center">
        <div class="anim-reveal">
          <Heading level="subsection" class="text-gray-900 mb-3">Punya pertanyaan tentang laporan kami?</Heading>
          <p class="text-gray-600 mb-6">
            Tim kami senang membantu menjelaskan angka-angka di balik laporan ini. Hubungi kami untuk diskusi lebih
            lanjut.
          </p>
          <Button href="/kontak">Hubungi Tim Kami</Button>
        </div>
      </Container>
    </section>
  </main>
</Base>
