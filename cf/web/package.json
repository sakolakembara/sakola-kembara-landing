{
  "name": "sakola-kembara-web",
  "type": "module",
  "version": "0.1.0",
  "private": true,
  "description": "Public site of Sakola Kembara: Astro 6 SSR on Cloudflare Workers (SAKEM-075 thin slice).",
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "sync-assets": "node scripts/sync-assets.mjs",
    "assets": "node scripts/sync-assets.mjs && node scripts/build-assets.mjs",
    "dev": "pnpm assets && astro dev",
    "build": "pnpm assets && astro build && node scripts/check-dist.mjs",
    "build:staging": "CLOUDFLARE_ENV=staging pnpm build",
    "deploy:staging:dry": "pnpm build:staging && node ../scripts/staging-dry-run.mjs web",
    "deploy:staging:command": "node ../scripts/staging-deploy-command.mjs web",
    "preview": "astro preview",
    "check": "node scripts/sync-assets.mjs && node scripts/build-assets.mjs --manifest-only && astro check",
    "test": "pnpm assets && vitest run",
    "test:e2e": "node scripts/e2e.mjs",
    "test:e2e:uploads": "node scripts/e2e-uploads.mjs",
    "test:negative:shortlink": "node scripts/negative-checks-shortlink.mjs",
    "seo:parity": "node scripts/seo-parity.mjs",
    "seo:parity:local": "node scripts/seo-parity-local.mjs",
    "serve:candidate": "node scripts/serve-candidate.mjs",
    "measure": "node scripts/measure.mjs",
    "measure:staging": "node scripts/measure-staging.mjs",
    "measure:cpu": "node scripts/measure-cpu.mjs",
    "fixture-api": "node scripts/fixture-api.mjs",
    "stub-origin": "node scripts/stub-origin.mjs",
    "check:dist": "node scripts/check-dist.mjs"
  },
  "dependencies": {
    "@astrojs/cloudflare": "^13.7.0",
    "astro": "^6.4.8"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.10",
    "@fontsource/lora": "^5.3.0",
    "@fontsource/plus-jakarta-sans": "^5.3.0",
    "@tailwindcss/vite": "^4.3.3",
    "@types/leaflet": "^1.9.21",
    "@types/node": "^22.0.0",
    "gray-matter": "^4.0.3",
    "happy-dom": "^20.14.6",
    "leaflet": "^1.9.4",
    "pdf-lib": "^1.17.1",
    "rehype-stringify": "^10.0.1",
    "remark-gfm": "^4.0.1",
    "remark-parse": "^11.0.0",
    "remark-rehype": "^11.1.2",
    "sharp": "^0.34.5",
    "tailwindcss": "^4.3.3",
    "typescript": "^6.0.3",
    "unified": "^11.0.5",
    "unist-util-visit": "^5.0.0",
    "vitest": "^4.1.11",
    "wrangler": "^4.149.0",
    "zod": "^3.23.8"
  }
}
