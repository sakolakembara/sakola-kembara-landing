{
  "name": "sakem-admin",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@9.15.0",
  "scripts": {
    "dev": "pnpm build:spa && wrangler dev",
    "dev:spa": "vite --config spa/vite.config.ts",
    "build:spa": "vite build --config spa/vite.config.ts",
    "build:worker": "pnpm build:spa && wrangler deploy --dry-run --outdir dist/worker",
    "typecheck": "tsc --noEmit && tsc --noEmit -p spa/tsconfig.json",
    "test": "vitest run",
    "db:generate": "drizzle-kit generate",
    "db:migrate:local": "wrangler d1 migrations apply sakem-admin --local",
    "measure": "tsx scripts/measure.ts",
    "test:negative": "node scripts/negative-checks.mjs"
  },
  "dependencies": {
    "better-auth": "^1.7.7",
    "drizzle-orm": "^0.45.4",
    "hono": "^4.13.13",
    "zod": "^4.6.6"
  },
  "devDependencies": {
    "@cloudflare/vitest-plugin": "^1.4.0",
    "@cloudflare/workers-types": "^5.20261012.1",
    "@fontsource-variable/lora": "^5.3.0",
    "@fontsource-variable/plus-jakarta-sans": "^5.3.0",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^22.16.5",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitejs/plugin-react": "^6.1.2",
    "class-variance-authority": "^0.7.1",
    "drizzle-kit": "^0.31.11",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "react-router": "^8.4.0",
    "tailwind-merge": "^3.7.0",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "vite": "^8.3.4",
    "vitest": "^4.1.10",
    "wrangler": "^4.149.0"
  }
}
