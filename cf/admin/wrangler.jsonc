{
  "$schema": "node_modules/wrangler/config-schema.json",
  // Admin/portal backend (SAKEM-078, SAKEM-081). Public repo: no account ids, no
  // resource ids, no secrets. The D1 binding below has no database_id on purpose;
  // it is only usable locally (`wrangler dev`, `wrangler d1 ... --local`, tests).
  // Real resources are attached in the deploy ticket, see docs/cloudflare/admin-skeleton.md.
  "name": "sakem-admin",
  "main": "src/worker.ts",
  "compatibility_date": "2026-09-01",
  "compatibility_flags": ["nodejs_compat"],
  "observability": { "enabled": true },

  // Anything that is not production must say so in untracked .dev.vars
  // (ENVIRONMENT=development). A deployed worker with this file as-is is
  // production: email, Turnstile and rate limiting fail closed, and tokenized
  // URLs are never logged.
  //   AUDIT_RETENTION_DAYS  days to keep audit_log rows ("" or "0" = keep all).
  //                         365 = one year; see docs/cloudflare/auth.md#retention.
  // Not here, set per deploy: TURNSTILE_SITE_KEY (public widget key, served by
  // GET /api/config), UPLOADS_BASE_URL (the public files domain, also served by
  // GET /api/config; empty = same origin), SITE_URL (the public site's origin, e.g.
  // https://sakolakembara.org, public like the others and served by GET /api/config as
  // `siteUrl`: the "Lihat di publik" link of a published blog article; empty or not an
  // http(s) origin = no link), EMAIL_FROM, TRUSTED_ORIGINS, COOKIE_DOMAIN (normally unset).
  // Secrets (BETTER_AUTH_SECRET, RESEND_API_KEY, TURNSTILE_SECRET_KEY,
  // GOOGLE_CLIENT_ID, GOOGLE_CLIENT_SECRET) are set with `wrangler secret put`.
  //
  // The student portal (SAKEM-083, docs/cloudflare/portal-architecture.md) adds, declared once here and in
  // wrangler.portal.jsonc for every task of the milestone:
  //   PRIVATE_FILES_BUDGET_BYTES  hard budget of the private bucket (the `private_storage` counter refuses an upload
  //                               past it). 8,000,000,000 is under the 10 GB-month of R2 Free. A test keeps the two
  //                               configs equal.
  //   DRAFT_RETENTION_DAYS, REJECTED_FILES_RETENTION_DAYS, ACCEPTED_FILES_RETENTION_DAYS
  //                               days to keep applicants' files before the daily cleanup deletes them. EMPTY = keep
  //                               (so is 0, a negative or an unreadable value: an unreadable setting never deletes).
  //                               Dzul decided on 2026-10-13 that nothing is deleted automatically, so all three are
  //                               empty. The architecture's proposal, if it is ever turned on: 30 (a draft, after its
  //                               batch closed), 90 (a rejected application, after the results), 365 (an accepted one).
  // Not here, set per deploy (portal Worker): ADMIN_URL (the admin host's origin, for the "this is an admin account"
  // screen). Secrets: PRIVATE_FILES_KEY is an OPTIONAL SSE-C key, undecided (the code must not require it).
  "vars": {
    "ENVIRONMENT": "production",
    "AUDIT_RETENTION_DAYS": "365",
    "PRIVATE_FILES_BUDGET_BYTES": "8000000000",
    "DRAFT_RETENTION_DAYS": "",
    "REJECTED_FILES_RETENTION_DAYS": "",
    "ACCEPTED_FILES_RETENTION_DAYS": ""
  },

  "assets": {
    "directory": "./dist/spa",
    "binding": "ASSETS",
    // Unknown paths get index.html (React Router handles them in the browser).
    "not_found_handling": "single-page-application",
    // Only the API runs the Worker. Every other request is answered by the
    // assets layer, which costs no Worker CPU and no Worker request. (The
    // Assafar studio uses `true` because it also serves /oauth/* and
    // /.well-known/*; this app has nothing outside /api.)
    // "/uploads/*" is the one extra: the local-only route that serves the local R2
    // emulation (src/api/dev-uploads.ts). In production it answers 404, and visitors
    // never ask this host for uploads (R2's public domain serves them), so a request
    // here is a stray one and gets a JSON 404 instead of the SPA's index.html.
    "run_worker_first": ["/api/*", "/uploads/*"]
  },

  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "sakem-admin",
      "migrations_dir": "migrations"
    }
  ],

  // R2: the files the admin uploads (team photos, report PDFs, documents, blog images),
  // SAKEM-082. `bucket_name` is a PLACEHOLDER and there is no id: nothing is created from
  // this file. Locally (`wrangler dev`, tests) the binding is an emulated bucket kept in
  // .wrangler/state, so it works without an account. Visitors get the files from the
  // bucket's own public domain, not from this Worker; the owner's steps (bucket, custom
  // domain, UPLOADS_BASE_URL on the public site) are in docs/cloudflare/uploads.md.
  "r2_buckets": [
    { "binding": "UPLOADS", "bucket_name": "sakem-files" },
    // The applicants' files (SAKEM-083, docs/cloudflare/portal-architecture.md, section 8): documents of children. A
    // bucket of its own, PRIVATE: never a public domain, never r2.dev, never the bucket above. This Worker reads them
    // for an admin who may (src/api/application-files.ts, a later task of the milestone) and deletes them for the
    // retention job. The name is a PLACEHOLDER and there is no id, like the one above.
    { "binding": "PRIVATE_FILES", "bucket_name": "sakem-private" }
  ],

  // Cloudflare rate limit bindings, one per concern (SAKEM-081, auth). Counted
  // per Cloudflare location and eventually consistent, period 10 or 60 seconds
  // only: a brake against floods and guessing, not an exact quota.
  // namespace_id is a number WE choose (unique per account), not a resource id;
  // these are placeholders, change one if the account already uses the number.
  // Limits, keys and the Indonesian 429 messages live in src/security/rate-limit.ts
  // (the in-memory fallback for local runs uses the same numbers, and a test
  // keeps this file and that one in sync). Table: docs/cloudflare/auth.md#rate-limits.
  "ratelimits": [
    // Sign-in: one client guessing one account. Key: route + IP + email hash.
    { "name": "RL_LOGIN", "namespace_id": "7801", "simple": { "limit": 5, "period": 60 } },
    // Sign-in: one account attacked from many addresses. Key: email hash.
    { "name": "RL_LOGIN_ACCOUNT", "namespace_id": "7802", "simple": { "limit": 20, "period": 60 } },
    // Student registration: one address creating accounts. Key: IP.
    { "name": "RL_REGISTER", "namespace_id": "7803", "simple": { "limit": 10, "period": 60 } },
    // "Forgot password" requests. Key: IP.
    { "name": "RL_RESET", "namespace_id": "7804", "simple": { "limit": 5, "period": 60 } },
    // "Send the verification link again". Key: email hash.
    { "name": "RL_VERIFY_RESEND", "namespace_id": "7805", "simple": { "limit": 2, "period": 60 } },
    // One mailbox, across every route that sends it email (register, reset,
    // resend, admin invite). Protects the Resend quota and the inbox. Key: email hash.
    { "name": "RL_MAIL_TARGET", "namespace_id": "7806", "simple": { "limit": 3, "period": 60 } },
    // Redeeming a token (reset-password, verify-email) and starting Google sign-in. Key: IP.
    { "name": "RL_TOKEN", "namespace_id": "7807", "simple": { "limit": 20, "period": 60 } },
    // Public contact form (POST /api/public/contact, behind the PublicApi service
    // binding): 5 per minute per visitor address, key "contact:<address>" from
    // X-Sakem-Client-Ip. The one limiter of that route (src/public/contact-deps.ts);
    // it replaces the PUBLIC_CONTACT_LIMIT binding (namespace 7811) of the first public API PR.
    { "name": "RL_CONTACT", "namespace_id": "7808", "simple": { "limit": 5, "period": 60 } },
    // Admin uploads and their deletes (src/api/uploads.ts): 20 per minute per signed-in user.
    // Key: "upload:<user id>". Keeps a stuck client or a stolen session from burning the R2
    // Class A budget (1M operations a month on Free) or the CPU of many multipart parses.
    { "name": "RL_UPLOAD", "namespace_id": "7821", "simple": { "limit": 20, "period": 60 } },
    // The blog editor's preview (POST /api/admin/blog/preview, src/api/blog.ts): 60 per minute per
    // signed-in user. Key: "blog-preview:<user id>". Every request is a markdown render on the
    // Worker, so a stuck client or a stolen session must not be able to spend its CPU.
    { "name": "RL_BLOG_PREVIEW", "namespace_id": "7822", "simple": { "limit": 60, "period": 60 } },

    // The student portal (SAKEM-083, docs/cloudflare/portal-architecture.md, 6.3). The portal Worker declares its own
    // copies of the auth limiters above and of the four RL_PORTAL_* below, with namespaces of its own
    // (wrangler.portal.jsonc, 79xx), so a flood of students never spends an admin's bucket. They are declared here too
    // because the Worker test suite runs every limiter against Miniflare's real binding (test/rate-limit.test.ts) in
    // this config; on the deployed admin Worker the four RL_PORTAL_* are unused.
    // Signed-in student routes, key "<name>:<user id>" (src/portal/guard.ts): reads, step saves, file uploads and
    // deletes, and the submit.
    { "name": "RL_PORTAL_READ", "namespace_id": "7831", "simple": { "limit": 60, "period": 60 } },
    { "name": "RL_PORTAL_SAVE", "namespace_id": "7832", "simple": { "limit": 30, "period": 60 } },
    { "name": "RL_PORTAL_UPLOAD", "namespace_id": "7833", "simple": { "limit": 20, "period": 60 } },
    { "name": "RL_PORTAL_SUBMIT", "namespace_id": "7834", "simple": { "limit": 3, "period": 60 } },
    // An admin opening an applicant's file (a later task of the milestone): 120 per minute per admin id.
    { "name": "RL_ADMIN_FILE", "namespace_id": "7841", "simple": { "limit": 120, "period": 60 } }
  ],

  // Daily cleanup (src/cron/cleanup.ts): expired sessions and verification
  // tokens, and audit rows older than AUDIT_RETENTION_DAYS. 03:17 UTC is 10:17
  // in Jakarta, outside school hours; the minute is off the hour on purpose.
  "triggers": { "crons": ["17 3 * * *"] }
}
