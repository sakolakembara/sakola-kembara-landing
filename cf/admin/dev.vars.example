# Copy to .dev.vars (untracked, ignored by .gitignore) and fill with FAKE local values.
# Never put real secrets in this repo.

# Anything other than "production" enables local conveniences: emails are kept in
# memory (read them at GET /api/dev/mailbox, nothing is printed), Turnstile is
# skipped when no secret is set, a missing rate limit binding falls back to memory.
# Omit it and the app runs as production, where all three fail closed.
ENVIRONMENT=development

# Required. At least 32 random characters. Generate one with: openssl rand -base64 32
# The student portal's Worker (`pnpm dev:portal`, wrangler.portal.jsonc) reads this same file locally, so locally both
# Workers share one secret; the cookies still differ by name (better-auth.session_token on the admin,
# sakem-student.session_token on the portal). In production the two Workers MUST have different secrets.
BETTER_AUTH_SECRET=local-only-fake-secret-change-me-32-chars-min

# Comma-separated browser origins allowed to send cookie-bearing writes (the Origin
# check) and to be a callbackURL. Not needed for same-origin use: the request's own
# origin is always accepted. Vite's dev server is the usual entry.
TRUSTED_ORIGINS=http://localhost:5173

# Leave empty. Empty means host-only cookies (with the __Host- prefix in production),
# which is what this app wants. Set it only if another subdomain must read the session;
# see docs/cloudflare/auth.md#cookies.
COOKIE_DOMAIN=

# Email (Resend). Empty in development = recorded in memory, not sent. In production
# both must be set, otherwise the routes that send email answer 503.
RESEND_API_KEY=
EMAIL_FROM=Sakola Kembara <no-reply@example.test>

# Google sign-in is offered only when both are set.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Turnstile. Empty = not checked (development only; production without it refuses).
# To try the real path locally use Cloudflare's published test keys, which work on
# any site and need no account:
#   always passes:  secret 1x0000000000000000000000000000000AA  site key 1x00000000000000000000AA
#   always fails:   secret 2x0000000000000000000000000000000AA  site key 2x00000000000000000000AB
#   token spent:    secret 3x0000000000000000000000000000000AA
# (with the passing secret, the token "XXXX.DUMMY.TOKEN.XXXX" is accepted.)
TURNSTILE_SECRET_KEY=
TURNSTILE_SITE_KEY=

# Days to keep audit_log rows (the daily cleanup). Empty or 0 = keep everything.
AUDIT_RETENTION_DAYS=365

# Public origin the uploaded files are served from (GET /api/config answers it to the SPA).
# Leave empty locally: /uploads/... is then same-origin, served by the local-only dev route
# and proxied by the Vite dev server. In production set it to the files domain, with no
# trailing slash (docs/cloudflare/uploads.md, owner steps).
UPLOADS_BASE_URL=

# Origin of the public site (GET /api/config answers it to the SPA as `siteUrl`): the
# "Lihat di publik" link of a published blog article is built from it, as
# <SITE_URL>/blog/<slug>. Empty = no link (the admin does not guess the site's address).
# A plain http(s) origin with no path and no trailing slash, e.g. https://sakolakembara.org;
# anything else is treated as empty. Locally the Astro dev server is http://localhost:4321.
SITE_URL=

# The student portal (SAKEM-083). Read by the portal Worker.
#
# Origin of the admin host, where the portal's "this is an admin account" screen links (GET /portal/api/config
# answers it as `adminUrl`). A plain http(s) origin, no path, no trailing slash. Locally the admin's `wrangler dev`
# is http://localhost:8787. Empty = no link.
ADMIN_URL=
# Hard budget of the private bucket, in bytes (wrangler.jsonc has the production value).
PRIVATE_FILES_BUDGET_BYTES=8000000000
# Days to keep applicants' files. 0 = never delete, the decision of 2026-10-13 (nothing is deleted automatically;
# an editor with the Pendaftaran grant or a super_admin purges an applicant's files by hand). No code reads these now.
DRAFT_RETENTION_DAYS=0
REJECTED_FILES_RETENTION_DAYS=0
ACCEPTED_FILES_RETENTION_DAYS=0
# There is no key for the private bucket: no SSE-C (decided 2026-10-13).
